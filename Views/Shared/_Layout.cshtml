@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // Views with bespoke full-bleed chrome (landing, auth, existing dashboards)
    // opt out of the shared shell. New pages get the responsive shell by default.
    var hideDefaultNav = ViewData["HideDefaultNav"] as bool? == true;
    var isFullWidth = ViewData["FullWidth"] as bool? == true;
    var useAppShell = !hideDefaultNav;
    var documentTitle = ViewData["Title"] as string ?? "JanSamadhan";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <title>@documentTitle</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <noscript>
        <style>
            @@media (max-width: 991.98px) {
                .app-sidebar {
                    position: static;
                    width: auto;
                    height: auto;
                    transform: none;
                }

                .app-sidebar__close,
                .app-sidebar-backdrop {
                    display: none !important;
                }

                .app-shell__main {
                    margin-left: 0;
                }
            }
        </style>
    </noscript>

    @RenderSection("Styles", required: false)

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <script>
        $(function () {
            var token = $('meta[name="csrf-token"]').attr('content');
            if (token) {
                $.ajaxSetup({
                    headers: {
                        'X-CSRF-TOKEN': token
                    }
                });
            }
        });
    </script>
</head>
<body class="@(useAppShell ? "app-shell-body" : "app-legacy-body")">
    <a class="skip-link" href="#main-content">
        <i class="fas fa-arrow-down" aria-hidden="true"></i>
        Skip to content
    </a>

    @if (useAppShell)
    {
        <div class="app-shell" id="appShell">
            <partial name="_SidebarPartial" />
            <div class="app-sidebar-backdrop" data-sidebar-close aria-hidden="true"></div>

            <div class="app-shell__main">
                <partial name="_TopNavPartial" />

                <main id="main-content" class="app-content @(isFullWidth ? "app-content--full" : "")" tabindex="-1">
                    @RenderBody()
                </main>

                <footer class="app-footer">
                    <span>&copy; @DateTime.Now.Year JanSamadhan</span>
                    <span class="d-none d-sm-inline"> &middot; Civic grievance redressal</span>
                </footer>
            </div>
        </div>
    }
    else
    {
        <main id="main-content" class="@(isFullWidth ? "app-legacy-main app-legacy-main--full p-0 m-0 w-100" : "app-legacy-main container py-4")" tabindex="-1">
            @RenderBody()
        </main>
    }

    <!-- Global Toast Notification Hub (Sonner & Emil Design Engineering principles) -->
    <div id="toastContainer" class="toast-hub" aria-live="polite" aria-atomic="true"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @{
        var toastSuccess = TempData["SuccessMessage"] ?? TempData["Success"];
        var toastError = TempData["ErrorMessage"] ?? TempData["Error"];
    }
    @if (toastSuccess != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (window.showToast) {
                    window.showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastSuccess.ToString())), 'success');
                }
            });
        </script>
    }
    @if (toastError != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (window.showToast) {
                    window.showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastError.ToString())), 'error');
                }
            });
        </script>
    }

    @RenderSection("Scripts", required: false)

    @if (useAppShell)
    {
        <script>
            (function () {
                'use strict';

                var shell = document.getElementById('appShell');
                if (!shell) { return; }

                var sidebar = document.getElementById('appSidebar');
                var backdrop = document.querySelector('.app-sidebar-backdrop');
                var toggle = document.querySelector('[data-sidebar-toggle]');
                var mobileQuery = window.matchMedia('(max-width: 991.98px)');
                var storageKey = 'jss-sidebar-collapsed';
                var lastFocusedElement = null;

                function isMobile() {
                    return mobileQuery.matches;
                }

                function isDrawerOpen() {
                    return shell.classList.contains('is-sidebar-open');
                }

                function setToggleExpanded(expanded) {
                    if (toggle) {
                        toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                    }
                }

                function syncAccessibilityState() {
                    if (!sidebar) { return; }

                    if (isMobile()) {
                        var open = isDrawerOpen();
                        sidebar.inert = !open;
                        sidebar.setAttribute('aria-hidden', open ? 'false' : 'true');
                        setToggleExpanded(open);
                    } else {
                        sidebar.inert = false;
                        sidebar.removeAttribute('aria-hidden');
                        setToggleExpanded(!shell.classList.contains('is-sidebar-collapsed'));
                    }
                }

                function openDrawer() {
                    lastFocusedElement = document.activeElement;
                    shell.classList.add('is-sidebar-open');
                    document.body.classList.add('app-drawer-open');
                    syncAccessibilityState();

                    var firstLink = sidebar
                        ? sidebar.querySelector('.app-sidebar__nav a, .app-sidebar__nav button')
                        : null;
                    if (firstLink) {
                        firstLink.focus();
                    }
                }

                function closeDrawer(returnFocus) {
                    shell.classList.remove('is-sidebar-open');
                    document.body.classList.remove('app-drawer-open');
                    syncAccessibilityState();

                    if (returnFocus && lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
                        lastFocusedElement.focus();
                    }
                }

                function toggleSidebar() {
                    if (isMobile()) {
                        if (isDrawerOpen()) {
                            closeDrawer(true);
                        } else {
                            openDrawer();
                        }
                        return;
                    }

                    var collapsed = shell.classList.toggle('is-sidebar-collapsed');
                    try {
                        window.localStorage.setItem(storageKey, collapsed ? '1' : '0');
                    } catch (error) {
                        /* Storage can be unavailable in private mode; collapse still works. */
                    }
                    syncAccessibilityState();
                }

                if (toggle) {
                    toggle.addEventListener('click', toggleSidebar);
                }

                if (backdrop) {
                    backdrop.addEventListener('click', function () {
                        closeDrawer(true);
                    });
                }

                Array.prototype.forEach.call(document.querySelectorAll('[data-sidebar-close]'), function (element) {
                    element.addEventListener('click', function () {
                        closeDrawer(true);
                    });
                });

                document.addEventListener('keydown', function (event) {
                    if (!isMobile() || !isDrawerOpen()) { return; }

                    if (event.key === 'Escape') {
                        closeDrawer(true);
                        return;
                    }

                    if (event.key !== 'Tab' || !sidebar) { return; }

                    var focusable = sidebar.querySelectorAll(
                        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
                    );
                    if (!focusable.length) { return; }

                    var first = focusable[0];
                    var last = focusable[focusable.length - 1];

                    if (event.shiftKey && document.activeElement === first) {
                        event.preventDefault();
                        last.focus();
                    } else if (!event.shiftKey && document.activeElement === last) {
                        event.preventDefault();
                        first.focus();
                    }
                });

                function handleViewportChange() {
                    if (!isMobile()) {
                        closeDrawer(false);
                    }
                    syncAccessibilityState();
                }

                if (typeof mobileQuery.addEventListener === 'function') {
                    mobileQuery.addEventListener('change', handleViewportChange);
                } else if (typeof mobileQuery.addListener === 'function') {
                    mobileQuery.addListener(handleViewportChange);
                }

                try {
                    if (window.localStorage.getItem(storageKey) === '1') {
                        shell.classList.add('is-sidebar-collapsed');
                    }
                } catch (error) {
                    /* Ignore unavailable storage. */
                }

                syncAccessibilityState();
            })();
        </script>
    }
</body>
</html>
