@model IEnumerable<JanSamadhan.Models.Badge>
@inject JanSamadhan.Data.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Civic Badges & Rewards — JanSamadhan";
    var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
    int.TryParse(userIdClaim, out int currentUserId);
    var currentUser = DbContext.Users.Find(currentUserId);

    var userPoints = currentUser?.Points ?? 0;
    var userTier = currentUser?.BadgeLevel ?? "Bronze";

    // Calculate Next Milestone
    var nextBadge = Model.FirstOrDefault(b => b.PointsRequired > userPoints);
    var nextPoints = nextBadge != null ? nextBadge.PointsRequired : (userPoints > 0 ? userPoints : 100);
    var prevBadge = Model.LastOrDefault(b => b.PointsRequired <= userPoints);
    var prevPoints = prevBadge != null ? prevBadge.PointsRequired : 0;
    var progressPercent = nextBadge != null ? Math.Min(100, Math.Max(5, (int)(((double)(userPoints - prevPoints) / (nextPoints - prevPoints)) * 100))) : 100;
}

<!-- Gamification Hero Card -->
<section class="badge-hero-card" aria-label="Citizen Tier Status">
    <div class="badge-hero__info">
        <div class="badge-hero__avatar" aria-hidden="true">
            <i class="fas fa-trophy"></i>
        </div>
        <div>
            <span class="badge bg-white bg-opacity-25 rounded-pill px-3 py-1 small fw-semibold text-white mb-2 d-inline-block">
                Verified Civic Contributor
            </span>
            <h1 class="badge-hero__tier">@userTier Citizen</h1>
            <p class="badge-hero__points">
                <i class="fas fa-award text-warning me-1" aria-hidden="true"></i><strong>@userPoints</strong> Lifetime Civic Points Earned
            </p>
        </div>
    </div>

    <!-- Progress to next tier -->
    <div class="badge-progress-container">
        <div class="badge-progress-label">
            @if (nextBadge != null)
            {
                <span>Next Tier: <strong>@nextBadge.LevelName</strong></span>
                <span>@(nextBadge.PointsRequired - userPoints) pts remaining</span>
            }
            else
            {
                <span>Apex Rank: <strong>Top Civic Honor</strong></span>
                <span>Max Level</span>
            }
        </div>
        <div class="badge-progress-bar" role="progressbar" aria-valuenow="@progressPercent" aria-valuemin="0" aria-valuemax="100">
            <div class="badge-progress-fill" style="width: @progressPercent%;"></div>
        </div>
        <div class="text-end mt-2">
            <a href="/Complaint/Create" class="btn btn-sm btn-light rounded-pill px-3 fw-semibold">
                <i class="fas fa-plus me-1 text-primary" aria-hidden="true"></i>Report Problem (+10 Pts)
            </a>
        </div>
    </div>
</section>

<!-- How to Earn Points Section -->
<section class="mb-5" aria-labelledby="how-earn-title">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 fw-bold text-dark mb-0" id="how-earn-title">
            <i class="fas fa-star text-warning me-2" aria-hidden="true"></i>How to Earn Civic Points
        </h2>
        <a href="/Home/Scoreboard" class="small text-primary text-decoration-none fw-semibold">
            View City Leaderboard <i class="fas fa-arrow-right ms-1" aria-hidden="true"></i>
        </a>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card border rounded-4 p-4 bg-white h-100 shadow-xs">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 fw-bold">+10 Pts</span>
                    <strong class="text-dark small">Report Civic Problem</strong>
                </div>
                <p class="text-muted small mb-0">
                    File a valid geo-pinned complaint with photo evidence. Points award upon municipal verification.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border rounded-4 p-4 bg-white h-100 shadow-xs">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fw-bold">+5 Pts</span>
                    <strong class="text-dark small">Rate Resolution Proof</strong>
                </div>
                <p class="text-muted small mb-0">
                    Review completed field technician work and submit star quality feedback once your case is fixed.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border rounded-4 p-4 bg-white h-100 shadow-xs">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-warning bg-opacity-25 text-dark rounded-pill px-3 py-1 fw-bold">Recognition</span>
                    <strong class="text-dark small">Ward Leaderboards</strong>
                </div>
                <p class="text-muted small mb-0">
                    Climb public city scoreboards and receive official civic commendation for neighbourhood stewardship.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Milestone Badges Grid -->
<section aria-labelledby="milestone-title">
    <div class="mb-4">
        <h2 class="h5 fw-bold text-dark mb-1" id="milestone-title">Milestone Tiers & Recognition</h2>
        <p class="text-muted small mb-0">Unlock higher status badges as your community impact expands.</p>
    </div>

    <div class="tier-grid">
        @foreach (var badge in Model)
        {
            var isUnlocked = userPoints >= badge.PointsRequired;
            var isGold = badge.LevelName.Equals("Gold", StringComparison.OrdinalIgnoreCase);
            var isSilver = badge.LevelName.Equals("Silver", StringComparison.OrdinalIgnoreCase);
            var isPlatinum = badge.LevelName.Equals("Platinum", StringComparison.OrdinalIgnoreCase) || badge.LevelName.Equals("Diamond", StringComparison.OrdinalIgnoreCase);

            var cardModifier = isUnlocked ? "is-unlocked" : "is-locked";
            if (isGold) cardModifier += " is-gold";
            if (isPlatinum) cardModifier += " is-platinum";

            var iconClass = isGold ? "fa-crown" : (isSilver ? "fa-medal" : (isPlatinum ? "fa-gem" : "fa-shield-halved"));

            <article class="tier-card @cardModifier">
                <div class="tier-icon-wrap" aria-hidden="true">
                    <i class="fas @iconClass"></i>
                </div>
                <h3 class="tier-title">@badge.LevelName</h3>
                <span class="tier-req">Requires @badge.PointsRequired Civic Pts</span>

                @if (isUnlocked)
                {
                    <span class="tier-status-pill tier-status-pill--unlocked">
                        <i class="fas fa-check" aria-hidden="true"></i> Unlocked
                    </span>
                }
                else
                {
                    <span class="tier-status-pill tier-status-pill--locked">
                        <i class="fas fa-lock me-1" aria-hidden="true"></i> @(badge.PointsRequired - userPoints) pts to unlock
                    </span>
                }
            </article>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/badges-map.css" asp-append-version="true" />
}
