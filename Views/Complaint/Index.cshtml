@model IEnumerable<JanSamadhan.Models.Complaint>
@{
    ViewData["Title"] = "My Complaints — JanSamadhan";
    var totalCount = ViewBag.TotalCount ?? Model.Count();
    var pendingCount = ViewBag.PendingCount ?? Model.Count(c => c.Status == JanSamadhan.Models.ComplaintStatus.Pending);
    var inProgressCount = ViewBag.InProgressCount ?? Model.Count(c => c.Status == JanSamadhan.Models.ComplaintStatus.InProgress);
    var fixedCount = ViewBag.FixedCount ?? Model.Count(c => c.Status == JanSamadhan.Models.ComplaintStatus.Fixed);
}

<!-- Dashboard Header -->
<div class="dashboard-header">
    <div>
        <h1 class="dashboard-title">My Reported Grievances</h1>
        <p class="dashboard-subtitle">Track your civic complaints, municipal triage, and field resolution proofs.</p>
    </div>
    <div>
        <a href="/Complaint/Create" class="dashboard-action-btn">
            <i class="fas fa-plus" aria-hidden="true"></i>
            <span>Report New Grievance</span>
        </a>
    </div>
</div>

<!-- 3 KPI Metric Cards -->
<div class="metrics-grid">
    <div class="metric-card metric-card--pending">
        <div class="metric-card__content">
            <span class="metric-card__label">Pending Triage</span>
            <span class="metric-card__count">@pendingCount</span>
        </div>
        <div class="metric-card__icon" aria-hidden="true">
            <i class="fas fa-clock"></i>
        </div>
    </div>

    <div class="metric-card metric-card--inprogress">
        <div class="metric-card__content">
            <span class="metric-card__label">Work In Progress</span>
            <span class="metric-card__count">@inProgressCount</span>
        </div>
        <div class="metric-card__icon" aria-hidden="true">
            <i class="fas fa-screwdriver-wrench"></i>
        </div>
    </div>

    <div class="metric-card metric-card--fixed">
        <div class="metric-card__content">
            <span class="metric-card__label">Resolved & Closed</span>
            <span class="metric-card__count">@fixedCount</span>
        </div>
        <div class="metric-card__icon" aria-hidden="true">
            <i class="fas fa-circle-check"></i>
        </div>
    </div>
</div>

<!-- Filter Toolbar (Tabs & Search) -->
<div class="complaints-toolbar">
    <!-- Segmented Status Tabs -->
    <div class="filter-tabs" role="tablist" aria-label="Filter Complaints by Status">
        <button type="button" class="filter-tab active" data-status="all" role="tab" aria-selected="true">
            <span>All</span>
            <span class="filter-tab__count">@totalCount</span>
        </button>
        <button type="button" class="filter-tab" data-status="pending" role="tab" aria-selected="false">
            <span>Pending</span>
            <span class="filter-tab__count">@pendingCount</span>
        </button>
        <button type="button" class="filter-tab" data-status="inprogress" role="tab" aria-selected="false">
            <span>In Progress</span>
            <span class="filter-tab__count">@inProgressCount</span>
        </button>
        <button type="button" class="filter-tab" data-status="fixed" role="tab" aria-selected="false">
            <span>Resolved</span>
            <span class="filter-tab__count">@fixedCount</span>
        </button>
    </div>

    <!-- Client-Side Search Box -->
    <div class="search-wrapper">
        <i class="fas fa-magnifying-glass search-icon" aria-hidden="true"></i>
        <input type="search" 
               id="complaintSearch" 
               class="search-input" 
               placeholder="Search complaints, category, address..." 
               aria-label="Search complaints" />
    </div>
</div>

@if (!Model.Any())
{
    <!-- Initial Empty State -->
    <div class="empty-state-card">
        <div class="empty-state-card__icon" aria-hidden="true">
            <i class="fas fa-clipboard-list"></i>
        </div>
        <h2 class="empty-state-card__title">No grievances reported yet</h2>
        <p class="empty-state-card__text">
            Spot a pothole, broken streetlight, or garbage overflow in your ward? Report it now for automated municipal routing and photo-verified resolution.
        </p>
        <a href="/Complaint/Create" class="dashboard-action-btn">
            <i class="fas fa-plus" aria-hidden="true"></i>
            <span>File Your First Report (+10 Pts)</span>
        </a>
    </div>
}
else
{
    <!-- Desktop Presentation: Clean Table -->
    <div class="complaints-table-container">
        <table class="complaints-table" aria-label="List of complaints">
            <thead>
                <tr>
                    <th scope="col">Case ID</th>
                    <th scope="col">Category</th>
                    <th scope="col">Location Address</th>
                    <th scope="col">Status</th>
                    <th scope="col">Department</th>
                    <th scope="col">Proof Photo</th>
                    <th scope="col" class="text-end">Action</th>
                </tr>
            </thead>
            <tbody id="complaintsTableBody">
                @foreach (var c in Model)
                {
                    var statusKey = c.Status.ToString().ToLower();
                    var statusClass = statusKey switch
                    {
                        "pending" => "status-pill--pending",
                        "inprogress" => "status-pill--inprogress",
                        "fixed" => "status-pill--fixed",
                        _ => "status-pill--pending"
                    };

                    <tr class="complaint-row" 
                        data-status="@statusKey" 
                        data-search="@($"{c.ComplaintId} {c.ProblemType} {c.Address} {c.Department?.Name}".ToLower())">
                        <td>
                            <strong class="text-dark">#JS-@c.ComplaintId</strong>
                            <div class="text-muted" style="font-size: 0.75rem;">
                                @c.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                            </div>
                        </td>
                        <td>
                            <span class="category-pill">
                                @c.ProblemType
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1 text-truncate" style="max-width: 260px;" title="@c.Address">
                                <i class="fas fa-map-pin text-primary me-1" aria-hidden="true"></i>
                                <span>@(string.IsNullOrWhiteSpace(c.Address) ? "Location pinned on GIS map" : c.Address)</span>
                            </div>
                        </td>
                        <td>
                            <span class="status-pill @statusClass">
                                @(c.Status == JanSamadhan.Models.ComplaintStatus.InProgress ? "In Progress" : c.Status.ToString())
                            </span>
                        </td>
                        <td>
                            <span class="text-muted small">
                                @(c.Department?.Name ?? "Pending Routing")
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(c.PhotoPath))
                            {
                                <a href="@c.PhotoPath" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-light border p-1 rounded d-inline-flex align-items-center gap-1" title="View uploaded evidence">
                                    <i class="fas fa-image text-primary" aria-hidden="true"></i>
                                    <span class="small">View</span>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@Url.Action("Details", new { id = c.ComplaintId })" class="table-action-btn">
                                <span>Track Case</span>
                                <i class="fas fa-chevron-right" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile Presentation: Responsive Cards -->
    <div class="complaints-cards-container" id="complaintsCardsContainer">
        @foreach (var c in Model)
        {
            var statusKey = c.Status.ToString().ToLower();
            var statusClass = statusKey switch
            {
                "pending" => "status-pill--pending",
                "inprogress" => "status-pill--inprogress",
                "fixed" => "status-pill--fixed",
                _ => "status-pill--pending"
            };

            <article class="mobile-complaint-card complaint-card" 
                     data-status="@statusKey" 
                     data-search="@($"{c.ComplaintId} {c.ProblemType} {c.Address} {c.Department?.Name}".ToLower())">
                <div class="mobile-card__head">
                    <span class="category-pill">
                        <strong>#JS-@c.ComplaintId</strong> &middot; @c.ProblemType
                    </span>
                    <span class="status-pill @statusClass">
                        @(c.Status == JanSamadhan.Models.ComplaintStatus.InProgress ? "In Progress" : c.Status.ToString())
                    </span>
                </div>

                <div class="mobile-card__address">
                    <i class="fas fa-location-dot" aria-hidden="true"></i>
                    <span>@(string.IsNullOrWhiteSpace(c.Address) ? "Location pinned on GIS map" : c.Address)</span>
                </div>

                <div class="mobile-card__meta">
                    <span><i class="fas fa-building me-1" aria-hidden="true"></i>@(c.Department?.Name ?? "Pending Routing")</span>
                    <span><i class="fas fa-calendar-day me-1" aria-hidden="true"></i>@c.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                </div>

                <a href="@Url.Action("Details", new { id = c.ComplaintId })" class="mobile-card__action-btn">
                    <span>View Timeline & Proofs</span>
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </article>
        }
    </div>

    <!-- No Search Results Found Alert -->
    <div class="empty-state-card" id="noFilterResultsCard" style="display: none;">
        <div class="empty-state-card__icon" aria-hidden="true">
            <i class="fas fa-filter"></i>
        </div>
        <h2 class="empty-state-card__title">No matching complaints found</h2>
        <p class="empty-state-card__text">Try adjusting your search query or switching to another status tab.</p>
        <button type="button" class="dashboard-action-btn" id="btnResetFilters">Reset Filters</button>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/complaints.css" asp-append-version="true" />
}

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tabs = document.querySelectorAll('.filter-tab');
        const searchInput = document.getElementById('complaintSearch');
        const rows = document.querySelectorAll('.complaint-row');
        const cards = document.querySelectorAll('.complaint-card');
        const noResults = document.getElementById('noFilterResultsCard');
        const resetBtn = document.getElementById('btnResetFilters');

        let currentStatus = 'all';
        let currentQuery = '';

        function filterItems() {
            let visibleCount = 0;

            // Filter Desktop Table Rows
            rows.forEach(row => {
                const status = row.getAttribute('data-status');
                const searchData = row.getAttribute('data-search') || '';
                const matchesStatus = (currentStatus === 'all' || status === currentStatus);
                const matchesQuery = (!currentQuery || searchData.includes(currentQuery));

                if (matchesStatus && matchesQuery) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            // Filter Mobile Cards
            cards.forEach(card => {
                const status = card.getAttribute('data-status');
                const searchData = card.getAttribute('data-search') || '';
                const matchesStatus = (currentStatus === 'all' || status === currentStatus);
                const matchesQuery = (!currentQuery || searchData.includes(currentQuery));

                if (matchesStatus && matchesQuery) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });

            // Show or Hide No Results State
            if (noResults) {
                noResults.style.display = (visibleCount === 0 && (rows.length > 0)) ? 'block' : 'none';
            }
        }

        // Tab Clicking
        tabs.forEach(tab => {
            tab.addEventListener('click', function () {
                tabs.forEach(t => {
                    t.classList.remove('active');
                    t.setAttribute('aria-selected', 'false');
                });
                this.classList.add('active');
                this.setAttribute('aria-selected', 'true');
                currentStatus = this.getAttribute('data-status');
                filterItems();
            });
        });

        // Search Input
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                currentQuery = this.value.trim().toLowerCase();
                filterItems();
            });
        }

        // Reset Filters Button
        if (resetBtn) {
            resetBtn.addEventListener('click', function () {
                currentStatus = 'all';
                currentQuery = '';
                if (searchInput) searchInput.value = '';
                tabs.forEach(t => {
                    if (t.getAttribute('data-status') === 'all') {
                        t.classList.add('active');
                        t.setAttribute('aria-selected', 'true');
                    } else {
                        t.classList.remove('active');
                        t.setAttribute('aria-selected', 'false');
                    }
                });
                filterItems();
            });
        }
    });
</script>
}
