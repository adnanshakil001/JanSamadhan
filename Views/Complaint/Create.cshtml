@{
    ViewData["Title"] = "Report a Problem - JanSamadhan";
    ViewData["HideDefaultNav"] = true;
    ViewData["FullWidth"] = true;
}

<div class="d-flex min-vh-100 bg-light citizen-dashboard-root">
    <!-- Left Sidebar -->
    <aside class="citizen-sidebar bg-white border-end d-flex flex-column justify-content-between p-3" style="width: 260px; min-width: 260px;">
        <div>
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none text-dark fw-bold fs-4 mb-4 px-2">
                <i class="fas fa-landmark text-primary"></i>
                <span>JanSamadhan</span>
            </a>

            <nav class="nav flex-column gap-1">
                <a href="/Complaint" class="sidebar-link">
                    <i class="fas fa-clipboard-list me-3"></i> My Complaints
                </a>
                <a href="/Complaint/Create" class="sidebar-link active">
                    <i class="fas fa-plus-circle me-3"></i> Report an Issue
                </a>
                <a href="/Home/Nearby" class="sidebar-link">
                    <i class="fas fa-map-marker-alt me-3"></i> Nearby Issues
                </a>
                <a href="/Badge" class="sidebar-link">
                    <i class="fas fa-medal me-3"></i> Badges & Rewards
                </a>
                <a href="/Home/Scoreboard" class="sidebar-link">
                    <i class="fas fa-trophy me-3"></i> Leaderboard
                </a>
            </nav>
        </div>

        <div class="pt-3 border-top">
            <div class="d-flex align-items-center justify-content-between px-2 text-muted small">
                <a href="/Account/Profile" class="text-secondary text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-user"></i> Profile
                </a>
                <a href="/Account/Logout" class="text-danger text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content Panel -->
    <div class="flex-grow-1 d-flex flex-column overflow-auto">
        <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center sticky-top">
            <div class="d-flex align-items-center gap-3">
                <a href="/Complaint" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> My Complaints</a>
                <span class="text-muted">/</span>
                <span class="fw-semibold text-dark">Report New Problem</span>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <a href="/Account/Profile" class="text-secondary text-decoration-none small fw-semibold">Profile</a>
                <a href="/Account/Logout" class="text-danger text-decoration-none small fw-semibold">Logout</a>
            </div>
        </header>

        <main class="p-4 flex-grow-1">
            <div class="mb-4">
                <h2 class="fw-bolder text-dark mb-1">Report a Civic Problem</h2>
                <p class="text-muted mb-0 small">Pin the exact location on the map, choose the category, and upload a photo for automatic department routing.</p>
            </div>

            <form method="post" enctype="multipart/form-data">
                <div class="row g-4">
                    <!-- Form Input Column -->
                    <div class="col-lg-6">
                        <div class="card border rounded-4 shadow-sm bg-white p-4">
                            <h5 class="fw-bold mb-3 text-dark">1. Issue Details</h5>

                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark small">Problem Category</label>
                                <select class="form-select rounded-3" name="problemType" id="problemType" required>
                                    <option value="">-- Select Problem Type --</option>
                                    <option data-department="Public Works">Pothole</option>
                                    <option data-department="Public Works">Streetlight</option>
                                    <option data-department="Utilities">Water Disposal</option>
                                    <option data-department="Traffic Management">Traffic Signal</option>
                                    <option data-department="Utilities">Sewer Lids</option>
                                    <option data-department="Public Works">Bridges</option>
                                </select>
                            </div>

                            <div class="mb-3" id="departmentInfo" style="display: none;">
                                <div class="alert alert-info py-2 px-3 rounded-3 small mb-0 d-flex align-items-center gap-2">
                                    <i class="fas fa-route text-primary"></i>
                                    <span>Auto-routing to: <strong id="assignedDepartment" class="text-dark"></strong></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark small">Description (Optional)</label>
                                <textarea class="form-control rounded-3" name="description" rows="3" placeholder="Provide extra context (e.g. near landmark, depth, hazard)..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark small">Upload Photo Proof</label>
                                <input class="form-control rounded-3" type="file" name="photo" accept="image/*" />
                                <small class="text-muted">A clear on-site photo accelerates triage and dispatch.</small>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold text-dark small">Detected Street Address</label>
                                <input class="form-control rounded-3 bg-light" type="text" id="address" name="address" placeholder="Click on the map to automatically detect address..." />
                            </div>

                            <input type="hidden" id="latitude" name="latitude" />
                            <input type="hidden" id="longitude" name="longitude" />

                            <button class="btn btn-primary w-100 py-2 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2" type="submit">
                                <i class="fas fa-paper-plane"></i> Submit Grievance (+10 Pts)
                            </button>
                        </div>
                    </div>

                    <!-- Map Pin Column -->
                    <div class="col-lg-6">
                        <div class="card border rounded-4 shadow-sm bg-white p-3 h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                <h5 class="fw-bold mb-0 text-dark">2. Tag Precise Location</h5>
                                <small class="text-muted"><i class="fas fa-info-circle me-1"></i>Click anywhere to drop pin</small>
                            </div>
                            <div id="map" class="flex-grow-1 rounded-3" style="min-height: 420px; border: 1px solid #e2e8f0;"></div>
                        </div>
                    </div>
                </div>
            </form>
        </main>
    </div>
</div>

<style>
.citizen-dashboard-root {
    font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
}
.sidebar-link {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    border-radius: 8px;
    color: #64748b;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s;
}
.sidebar-link:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}
.sidebar-link.active {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}
</style>

@section Scripts {
<script>
    const map = L.map('map').setView([23.2599, 77.4126], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    let marker = null;
    function setMarker(lat, lng) {
        if (marker) { map.removeLayer(marker); }
        marker = L.marker([lat, lng]).addTo(map);
        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;
        
        document.getElementById('address').value = 'Detecting address...';
        fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`)
            .then(r => r.json())
            .then(d => {
                document.getElementById('address').value = d.display_name || `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
            }).catch(() => {
                document.getElementById('address').value = `${lat.toFixed(5)}, ${lng.toFixed(5)}`;
            });
    }

    map.on('click', function (e) {
        setMarker(e.latlng.lat, e.latlng.lng);
    });

    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(p => {
            const lat = p.coords.latitude;
            const lng = p.coords.longitude;
            map.setView([lat, lng], 15);
            setMarker(lat, lng);
        });
    }

    $('#problemType').change(function() {
        const selectedOption = $(this).find('option:selected');
        const department = selectedOption.data('department');
        
        if (department) {
            $('#assignedDepartment').text(department);
            $('#departmentInfo').show();
        } else {
            $('#departmentInfo').hide();
        }
    });
</script>
}
