@model JanSamadhan.Models.Complaint
@{
    ViewData["Title"] = "Complaint #" + Model.ComplaintId + " - JanSamadhan";
    ViewData["HideDefaultNav"] = true;
    ViewData["FullWidth"] = true;
    var currentUserId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("Technician") || User.IsInRole("DepartmentManager");
    var canComment = Model.UserId == currentUserId || isAdmin;
    var isMyComplaint = Model.UserId == currentUserId;
}

<div class="d-flex min-vh-100 bg-light citizen-dashboard-root">
    <!-- Left Sidebar -->
    <aside class="citizen-sidebar bg-white border-end d-flex flex-column justify-content-between p-3" style="width: 260px; min-width: 260px;">
        <div>
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none text-dark fw-bold fs-4 mb-4 px-2">
                <i class="fas fa-landmark text-primary"></i>
                <span>JanSamadhan</span>
            </a>

            <nav class="nav flex-column gap-1">
                <a href="/Complaint" class="sidebar-link active">
                    <i class="fas fa-clipboard-list me-3"></i> My Complaints
                </a>
                <a href="/Complaint/Create" class="sidebar-link">
                    <i class="fas fa-plus-circle me-3"></i> Report an Issue
                </a>
                <a href="/Home/Nearby" class="sidebar-link">
                    <i class="fas fa-map-marker-alt me-3"></i> Nearby Issues
                </a>
                <a href="/Badge" class="sidebar-link">
                    <i class="fas fa-medal me-3"></i> Badges & Rewards
                </a>
                <a href="/Home/Scoreboard" class="sidebar-link">
                    <i class="fas fa-trophy me-3"></i> Leaderboard
                </a>
            </nav>
        </div>

        <div class="pt-3 border-top">
            <div class="d-flex align-items-center justify-content-between px-2 text-muted small">
                <a href="/Account/Profile" class="text-secondary text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-user"></i> Profile
                </a>
                <a href="/Account/Logout" class="text-danger text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content Panel -->
    <div class="flex-grow-1 d-flex flex-column overflow-auto">
        <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center sticky-top">
            <div class="d-flex align-items-center gap-3">
                <a href="/Complaint" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Back to Complaints</a>
                <span class="text-muted">/</span>
                <span class="fw-semibold text-dark">Complaint #@Model.ComplaintId</span>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <a href="/Account/Profile" class="text-secondary text-decoration-none small fw-semibold">Profile</a>
                <a href="/Account/Logout" class="text-danger text-decoration-none small fw-semibold">Logout</a>
            </div>
        </header>

        <main class="p-4 flex-grow-1">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bolder text-dark mb-0">Complaint #@Model.ComplaintId</h2>
                    <p class="text-muted mb-0 small">Live resolution progress, technician photo proofs, and rating</p>
                </div>
                <div>
                    <span class="badge status-badge @(Model.Status.ToString().ToLower()) rounded-pill px-3 py-2 fs-6">
                        @Model.Status
                    </span>
                </div>
            </div>

            <div class="row g-4">
                <!-- Left 8 Columns -->
                <div class="col-lg-8">
                    <!-- Issue Overview Card -->
                    <div class="card border rounded-4 shadow-sm bg-white mb-4">
                        <div class="card-header bg-white border-0 pt-3 px-4">
                            <h5 class="fw-bold mb-0 text-dark">Grievance Overview</h5>
                        </div>
                        <div class="card-body px-4 pb-4 pt-2">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Problem Type</label>
                                    <p class="fw-bold text-dark mb-2"><span class="badge bg-light text-dark border">@Model.ProblemType</span></p>
                                    
                                    <label class="text-muted small fw-semibold">Description</label>
                                    <p class="text-dark mb-2">@(Model.Description ?? "No additional description provided")</p>
                                    
                                    <label class="text-muted small fw-semibold">Location / Address</label>
                                    <p class="text-dark mb-1">@(Model.Address ?? "Location pinned on map")</p>
                                    <small class="text-muted font-monospace"><i class="fas fa-map-pin me-1 text-danger"></i>@Model.Latitude, @Model.Longitude</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Reported By</label>
                                    <p class="fw-bold text-dark mb-2">@Model.User?.Name</p>
                                    
                                    <label class="text-muted small fw-semibold">Reported Date</label>
                                    <p class="text-dark mb-2">@Model.CreatedAt.ToLocalTime().ToString("f")</p>
                                    
                                    <label class="text-muted small fw-semibold">Assigned Department</label>
                                    <p class="fw-semibold text-primary mb-2">@(Model.Department?.Name ?? "Under Triage")</p>
                                    
                                    <label class="text-muted small fw-semibold">Assigned Field Technician</label>
                                    <p class="fw-semibold text-dark mb-0">@(Model.AssignedToUser?.Name ?? "Pending Assignment")</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.PhotoPath))
                            {
                                <div class="mt-3 border-top pt-3">
                                    <label class="text-muted small fw-semibold d-block mb-2">Original Reported Photo Proof</label>
                                    <img src="@Model.PhotoPath" class="img-fluid rounded-3 border shadow-sm" style="max-height: 250px;" alt="Complaint photo" />
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Comments & Discussion Stream -->
                    <div class="card border rounded-4 shadow-sm bg-white mb-4">
                        <div class="card-header bg-white border-0 pt-3 px-4">
                            <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-comments me-2 text-primary"></i>Updates & Discussion Thread</h5>
                        </div>
                        <div class="card-body px-4 pb-4">
                            @if (canComment)
                            {
                                <div class="p-3 bg-light rounded-3 border mb-4">
                                    <h6 class="fw-bold text-dark mb-2">Leave a Comment or Question</h6>
                                    <form id="commentForm" enctype="multipart/form-data">
                                        <input type="hidden" id="complaintId" value="@Model.ComplaintId" />
                                        <div class="mb-3">
                                            <textarea class="form-control rounded-3" id="commentContent" rows="3" placeholder="Enter your comment..." maxlength="1000" required></textarea>
                                        </div>
                                        
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <input type="file" class="form-control form-control-sm" id="attachments" multiple accept="image/*,.pdf">
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-sm px-4 rounded-pill fw-semibold">
                                                <i class="fas fa-paper-plane me-1"></i> Post
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            }

                            <div id="commentsList" class="d-flex flex-column gap-3">
                                <!-- Loaded via AJAX -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right 4 Columns: Proofs & Rating -->
                <div class="col-lg-4">
                    <!-- Technician Photo Proofs -->
                    @if (Model.TechnicianPhotos != null && Model.TechnicianPhotos.Any())
                    {
                        <div class="card border-info rounded-4 shadow-sm mb-4 bg-white">
                            <div class="card-header bg-info bg-opacity-25 border-0 pt-3 px-4">
                                <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-camera me-2"></i>Field Technician Proofs</h6>
                            </div>
                            <div class="card-body px-4 pb-3">
                                @foreach (var photo in Model.TechnicianPhotos.OrderBy(p => p.UploadedAt))
                                {
                                    <div class="mb-3 border-bottom pb-2">
                                        <span class="badge @(photo.PhotoType == "WorkInProgress" ? "bg-warning text-dark" : "bg-success") mb-1">
                                            @(photo.PhotoType == "WorkInProgress" ? "Work In Progress" : "Fixed / Resolved")
                                        </span>
                                        <img src="@photo.PhotoPath" class="img-fluid rounded-3 border d-block my-2" style="max-height: 180px;" alt="@photo.PhotoType Photo">
                                        <small class="text-muted">Uploaded: @photo.UploadedAt.ToLocalTime().ToString("MMM dd, h:mm tt")</small>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Citizen Rating & Review Card -->
                    @if (Model.Status == JanSamadhan.Models.ComplaintStatus.Fixed && Model.Rating == null && isMyComplaint)
                    {
                        <div class="card border-warning rounded-4 shadow-sm mb-4 bg-white">
                            <div class="card-header bg-warning bg-opacity-25 border-0 pt-3 px-4">
                                <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-star me-2 text-warning"></i>Rate Your Resolution</h6>
                            </div>
                            <div class="card-body px-4 pb-4 pt-2">
                                <p class="text-muted small mb-3">Your issue has been marked as <strong>Fixed</strong>! Please rate the technician's work quality.</p>
                                <div id="ratingForm">
                                    <div class="mb-3 text-center">
                                        <div class="rating fs-3">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="star" data-rating="@i">★</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Feedback Comment (Optional)</label>
                                        <textarea class="form-control rounded-3" id="ratingComment" rows="3" placeholder="Share your experience..." maxlength="1000"></textarea>
                                    </div>
                                    <button class="btn btn-warning w-100 fw-bold rounded-pill text-dark" onclick="submitRating(@Model.ComplaintId)">
                                        Submit Rating (+5 Pts)
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (Model.Rating != null)
                    {
                        <div class="card border rounded-4 shadow-sm mb-4 bg-white">
                            <div class="card-header bg-white border-0 pt-3 px-4">
                                <h6 class="fw-bold mb-0 text-dark">Your Submitted Rating</h6>
                            </div>
                            <div class="card-body px-4 pb-4 pt-2">
                                <div class="rating-display text-warning fs-4 mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="star-display @(i <= Model.Rating.Score ? "filled" : "")">★</span>
                                    }
                                    <span class="ms-2 fs-6 text-dark fw-bold">@Model.Rating.Score / 5</span>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Rating.Comment))
                                {
                                    <p class="text-muted small mb-0 fst-italic">"@Model.Rating.Comment"</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </main>
    </div>
</div>

<style>
.citizen-dashboard-root {
    font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
}
.sidebar-link {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    border-radius: 8px;
    color: #64748b;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s;
}
.sidebar-link:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}
.sidebar-link.active {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}
.status-badge.pending { background-color: #dc3545 !important; color: #fff; }
.status-badge.inprogress { background-color: #ffc107 !important; color: #000; }
.status-badge.fixed { background-color: #198754 !important; color: #fff; }
.star { cursor: pointer; color: #cbd5e1; transition: color 0.2s; }
.star:hover, .star.selected { color: #f59e0b; }
.star-display { color: #cbd5e1; }
.star-display.filled { color: #f59e0b; }
</style>

@section Scripts {
<script>
    let selectedRating = 0;

    $(document).ready(function() {
        loadComments();
        
        $('.rating .star').click(function() {
            selectedRating = $(this).data('rating');
            $('.rating .star').each(function() {
                if ($(this).data('rating') <= selectedRating) {
                    $(this).addClass('selected');
                } else {
                    $(this).removeClass('selected');
                }
            });
        });
        
        $('#commentForm').submit(function(e) {
            e.preventDefault();
            submitComment();
        });
    });
    
    function loadComments() {
        $.get('/Comment/GetComments', { complaintId: @Model.ComplaintId })
            .done(function(response) {
                if (response.success) {
                    displayComments(response.comments);
                }
            });
    }
    
    function displayComments(comments) {
        const commentsList = $('#commentsList');
        commentsList.empty();
        
        if (comments.length === 0) {
            commentsList.append('<p class="text-muted small text-center py-3">No updates or comments yet.</p>');
            return;
        }
        
        comments.forEach(function(comment) {
            const roleBadge = comment.authorRole === 'User' ? 'bg-secondary' : 'bg-primary';
            
            commentsList.append(`
                <div class="card border rounded-3 p-3 bg-white shadow-sm">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge ${roleBadge} rounded-pill">${comment.authorRole}</span>
                            <strong class="text-dark small">${comment.authorName}</strong>
                        </div>
                        <small class="text-muted">${new Date(comment.createdAt).toLocaleString()}</small>
                    </div>
                    <p class="mb-2 text-dark small">${comment.content}</p>
                </div>
            `);
        });
    }
    
    function submitComment() {
        const formData = new FormData();
        formData.append('complaintId', $('#complaintId').val());
        formData.append('content', $('#commentContent').val());
        formData.append('visibleToUser', true);
        
        $.ajax({
            url: '/Comment/Create',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response.success) {
                    $('#commentContent').val('');
                    loadComments();
                } else {
                    alert('Error: ' + response.message);
                }
            }
        });
    }
    
    function submitRating(complaintId) {
        if (selectedRating === 0) {
            alert('Please select a star rating first.');
            return;
        }
        
        $.post('/Complaint/SubmitRating', {
            complaintId: complaintId,
            score: selectedRating,
            comment: $('#ratingComment').val()
        }).done(function(response) {
            if (response.success) {
                alert('Thank you! Your rating has been recorded.');
                location.reload();
            } else {
                alert('Error: ' + response.message);
            }
        });
    }
</script>
}
