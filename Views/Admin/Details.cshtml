@model JanSamadhan.Models.Complaint
@{
    ViewData["Title"] = "Complaint #" + Model.ComplaintId + " - Admin Details";
    ViewData["HideDefaultNav"] = true;
    ViewData["FullWidth"] = true;
}

<div class="d-flex min-vh-100 bg-light admin-dashboard-root">
    <!-- Left Sidebar -->
    <aside class="admin-sidebar bg-white border-end d-flex flex-column justify-content-between p-3" style="width: 260px; min-width: 260px;">
        <div>
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none text-dark fw-bold fs-4 mb-4 px-2">
                <i class="fas fa-landmark text-primary"></i>
                <span>JanSamadhan</span>
            </a>

            <nav class="nav flex-column gap-1">
                <a href="/Admin" class="sidebar-link active">
                    <i class="fas fa-th-large me-3"></i> Admin Dashboard
                </a>
                <a href="/Map/AdminMap" class="sidebar-link">
                    <i class="fas fa-map-marked-alt me-3"></i> Map View
                </a>
                <a href="/Role" class="sidebar-link">
                    <i class="fas fa-users-cog me-3"></i> Role Management
                </a>
                <a href="/Admin/TechnicianScoreboard" class="sidebar-link">
                    <i class="fas fa-chart-line me-3"></i> Technician Board
                </a>
                <a href="/Admin/Scoreboard" class="sidebar-link">
                    <i class="fas fa-medal me-3"></i> User Scoreboard
                </a>
            </nav>
        </div>

        <div class="pt-3 border-top">
            <a href="/Admin/CreateTechnician" class="btn btn-success w-100 py-2 fw-bold rounded-3 mb-3 d-flex align-items-center justify-content-center gap-2 shadow-sm">
                <i class="fas fa-user-plus"></i> + Add Technician
            </a>
            <div class="d-flex align-items-center justify-content-between px-2 text-muted small">
                <a href="/Account/Profile" class="text-secondary text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-cog"></i> Settings
                </a>
                <a href="/Account/Logout" class="text-danger text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content Panel -->
    <div class="flex-grow-1 d-flex flex-column overflow-auto">
        <!-- Top Header Navigation Bar -->
        <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center sticky-top">
            <div class="d-flex align-items-center gap-3">
                <a href="/Admin" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Back to Dashboard</a>
                <span class="text-muted">/</span>
                <span class="fw-semibold text-dark">Complaint #@Model.ComplaintId</span>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <a href="/Account/Profile" class="text-secondary text-decoration-none small fw-semibold">Profile</a>
                <a href="/Account/Logout" class="text-danger text-decoration-none small fw-semibold">Logout</a>
            </div>
        </header>

        <!-- Page Body Content -->
        <main class="p-4 flex-grow-1">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bolder text-dark mb-0">Complaint Details #@Model.ComplaintId</h2>
                    <p class="text-muted mb-0 small">Inspection, Triage, and Field Photo Validation</p>
                </div>
                <div>
                    <span class="badge status-badge @(Model.Status.ToString().ToLower()) rounded-pill px-3 py-2 fs-6">
                        Status: @Model.Status
                    </span>
                </div>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row g-4">
                <!-- Left 8 Columns: Details & Comments -->
                <div class="col-lg-8">
                    <!-- Grievance Information Card -->
                    <div class="card border rounded-4 shadow-sm mb-4 bg-white">
                        <div class="card-header bg-white border-0 pt-3 px-4">
                            <h5 class="fw-bold mb-0 text-dark">Grievance Information</h5>
                        </div>
                        <div class="card-body px-4 pb-4 pt-2">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Problem Type</label>
                                    <p class="fw-bold text-dark mb-2"><span class="badge bg-light text-dark border">@Model.ProblemType</span></p>
                                    
                                    <label class="text-muted small fw-semibold">Description</label>
                                    <p class="text-dark mb-2">@(Model.Description ?? "No description provided")</p>
                                    
                                    <label class="text-muted small fw-semibold">Location / Address</label>
                                    <p class="text-dark mb-1">@(Model.Address ?? "Address not specified")</p>
                                    <small class="text-muted font-monospace"><i class="fas fa-map-pin me-1 text-danger"></i>@Model.Latitude, @Model.Longitude</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Reported By</label>
                                    <p class="fw-bold text-dark mb-2">@Model.User?.Name <span class="text-muted fw-normal">(@Model.User?.Email)</span></p>
                                    
                                    <label class="text-muted small fw-semibold">Submitted On</label>
                                    <p class="text-dark mb-2">@Model.CreatedAt.ToLocalTime().ToString("f")</p>
                                    
                                    <label class="text-muted small fw-semibold">Department Assigned</label>
                                    <p class="fw-semibold text-primary mb-2">@(Model.Department?.Name ?? "Unassigned")</p>
                                    
                                    <label class="text-muted small fw-semibold">Assigned Technician</label>
                                    <p class="fw-semibold text-dark mb-0">@(Model.AssignedToUser?.Name ?? "Unassigned")</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.PhotoPath))
                            {
                                <div class="mt-3 border-top pt-3">
                                    <label class="text-muted small fw-semibold d-block mb-2">Original Citizen Photo</label>
                                    <img src="@Model.PhotoPath" class="img-fluid rounded-3 border shadow-sm" style="max-height: 260px;" alt="Complaint photo" />
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Threaded Comments & Discussion Card -->
                    <div class="card border rounded-4 shadow-sm bg-white mb-4">
                        <div class="card-header bg-white border-0 pt-3 px-4">
                            <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-comments me-2 text-primary"></i>Audit Trail & Comments</h5>
                        </div>
                        <div class="card-body px-4 pb-4">
                            <!-- Add Comment Form -->
                            <div class="p-3 bg-light rounded-3 border mb-4">
                                <h6 class="fw-bold text-dark mb-2">Post an Update or Internal Note</h6>
                                <form id="commentForm" enctype="multipart/form-data">
                                    <input type="hidden" id="complaintId" value="@Model.ComplaintId" />
                                    <div class="mb-3">
                                        <textarea class="form-control rounded-3" id="commentContent" rows="3" placeholder="Enter status update or comment..." maxlength="1000" required></textarea>
                                    </div>
                                    
                                    <div class="row align-items-center mb-3 g-2">
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="visibleToUser" checked>
                                                <label class="form-check-label small fw-semibold text-dark" for="visibleToUser">
                                                    Visible to Citizen & Public
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <input type="file" class="form-control form-control-sm" id="attachments" multiple accept="image/*,.pdf">
                                        </div>
                                    </div>
                                    
                                    <button type="submit" class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold">
                                        <i class="fas fa-paper-plane me-1"></i> Post Comment
                                    </button>
                                </form>
                            </div>

                            <!-- Comments Stream -->
                            <div id="commentsList" class="d-flex flex-column gap-3">
                                <!-- Loaded via AJAX -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right 4 Columns: Actions, Photos & Ratings -->
                <div class="col-lg-4">
                    <!-- Admin Quick Actions Card -->
                    <div class="card border rounded-4 shadow-sm mb-4 bg-white">
                        <div class="card-header bg-white border-0 pt-3 px-4">
                            <h6 class="fw-bold mb-0 text-dark">Admin Dispatch Actions</h6>
                        </div>
                        <div class="card-body px-4 pb-4 pt-2">
                            <div class="d-grid gap-2">
                                @if (Model.Status == JanSamadhan.Models.ComplaintStatus.Pending)
                                {
                                    <button class="btn btn-warning fw-bold text-dark rounded-3" onclick="updateStatus(@Model.ComplaintId, 1)">
                                        <i class="fas fa-play me-1"></i> Mark In Progress
                                    </button>
                                }
                                @if (Model.Status == JanSamadhan.Models.ComplaintStatus.InProgress)
                                {
                                    <button class="btn btn-success fw-bold rounded-3" onclick="updateStatus(@Model.ComplaintId, 2)">
                                        <i class="fas fa-check-double me-1"></i> Mark as Fixed
                                    </button>
                                }
                                <button class="btn btn-primary fw-semibold rounded-3" onclick="showAssignmentModal()">
                                    <i class="fas fa-user-tag me-1"></i> Assign Technician
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Technician Uploaded Proofs -->
                    @if (Model.TechnicianPhotos != null && Model.TechnicianPhotos.Any())
                    {
                        <div class="card border-info rounded-4 shadow-sm mb-4 bg-white">
                            <div class="card-header bg-info bg-opacity-25 border-0 pt-3 px-4">
                                <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-camera me-2"></i>Technician Field Proofs</h6>
                            </div>
                            <div class="card-body px-4 pb-3">
                                @foreach (var photo in Model.TechnicianPhotos.OrderBy(p => p.UploadedAt))
                                {
                                    <div class="mb-3 border-bottom pb-2">
                                        <span class="badge @(photo.PhotoType == "WorkInProgress" ? "bg-warning text-dark" : "bg-success") mb-1">
                                            @(photo.PhotoType == "WorkInProgress" ? "Work In Progress" : "Fixed / Completed")
                                        </span>
                                        <img src="@photo.PhotoPath" class="img-fluid rounded-3 border d-block my-2" style="max-height: 180px;" alt="@photo.PhotoType Photo">
                                        <small class="text-muted">Uploaded: @photo.UploadedAt.ToLocalTime().ToString("g")</small>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- User Rating Card -->
                    @if (Model.Rating != null)
                    {
                        <div class="card border rounded-4 shadow-sm mb-4 bg-white">
                            <div class="card-header bg-white border-0 pt-3 px-4">
                                <h6 class="fw-bold mb-0 text-dark">Citizen Feedback & Rating</h6>
                            </div>
                            <div class="card-body px-4 pb-4 pt-2">
                                <div class="rating-display text-warning fs-4 mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="star-display @(i <= Model.Rating.Score ? "filled" : "")">★</span>
                                    }
                                    <span class="ms-2 fs-6 text-dark fw-bold">@Model.Rating.Score / 5</span>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.Rating.Comment))
                                {
                                    <p class="text-muted small mb-0 fst-italic">"@Model.Rating.Comment"</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Assignment Modal -->
<div class="modal fade" id="assignmentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Assign Complaint to Technician</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="assignmentForm">
                    <input type="hidden" id="assignmentComplaintId" value="@Model.ComplaintId" />
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Select Department</label>
                        <select class="form-select rounded-3" id="departmentId">
                            <option value="">Select Department</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Assign to Field Technician</label>
                        <select class="form-select rounded-3" id="assignedToUserId">
                            <option value="">Select Technician</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Internal Instruction Note</label>
                        <textarea class="form-control rounded-3" id="assignmentNote" rows="3" placeholder="Add dispatch instructions..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="submitAssignment()">Assign & Dispatch</button>
            </div>
        </div>
    </div>
</div>

<style>
.admin-dashboard-root {
    font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
}
.sidebar-link {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    border-radius: 8px;
    color: #64748b;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s;
}
.sidebar-link:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}
.sidebar-link.active {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}
.status-badge.pending { background-color: #dc3545 !important; color: #fff; }
.status-badge.inprogress { background-color: #ffc107 !important; color: #000; }
.status-badge.fixed { background-color: #198754 !important; color: #fff; }
.star-display { color: #cbd5e1; }
.star-display.filled { color: #f59e0b; }
</style>

@section Scripts {
<script>
    $(document).ready(function() {
        loadComments();
        loadDepartments();
        
        $('#commentForm').submit(function(e) {
            e.preventDefault();
            submitComment();
        });
    });
    
    function loadComments() {
        $.get('/Comment/GetComments', { complaintId: @Model.ComplaintId })
            .done(function(response) {
                if (response.success) {
                    displayComments(response.comments);
                }
            });
    }
    
    function displayComments(comments) {
        const commentsList = $('#commentsList');
        commentsList.empty();
        
        if (comments.length === 0) {
            commentsList.append('<p class="text-muted small text-center py-3">No comments or updates yet.</p>');
            return;
        }
        
        comments.forEach(function(comment) {
            const isInternal = !comment.visibleToUser;
            const roleBadge = comment.authorRole === 'User' ? 'bg-secondary' : 'bg-primary';
            
            commentsList.append(`
                <div class="card border rounded-3 p-3 bg-white shadow-sm">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge ${roleBadge} rounded-pill">${comment.authorRole}</span>
                            <strong class="text-dark small">${comment.authorName}</strong>
                            ${isInternal ? '<span class="badge bg-warning text-dark rounded-pill small">Internal</span>' : ''}
                        </div>
                        <small class="text-muted">${new Date(comment.createdAt).toLocaleString()}</small>
                    </div>
                    <p class="mb-2 text-dark small">${comment.content}</p>
                    ${comment.attachments && comment.attachments.length > 0 ? displayAttachments(comment.attachments) : ''}
                </div>
            `);
        });
    }
    
    function displayAttachments(attachments) {
        let html = '<div class="mt-2 d-flex flex-wrap gap-2">';
        attachments.forEach(function(attachment) {
            if (attachment.contentType && attachment.contentType.startsWith('image/')) {
                html += `<a href="${attachment.filePath}" target="_blank">
                    <img src="${attachment.filePath}" style="max-height: 80px;" class="img-thumbnail rounded" />
                </a>`;
            } else {
                html += `<a href="${attachment.filePath}" target="_blank" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-file me-1"></i> ${attachment.fileName}
                </a>`;
            }
        });
        html += '</div>';
        return html;
    }
    
    function submitComment() {
        const formData = new FormData();
        formData.append('complaintId', $('#complaintId').val());
        formData.append('content', $('#commentContent').val());
        formData.append('visibleToUser', $('#visibleToUser').is(':checked'));
        
        const attachments = $('#attachments')[0].files;
        for (let i = 0; i < attachments.length; i++) {
            formData.append('attachments', attachments[i]);
        }
        
        $.ajax({
            url: '/Comment/Create',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response.success) {
                    $('#commentContent').val('');
                    $('#attachments').val('');
                    loadComments();
                } else {
                    alert('Error: ' + response.message);
                }
            }
        });
    }
    
    function updateStatus(complaintId, status) {
        $.post('/Admin/UpdateStatus', { id: complaintId, status: status })
            .done(function() {
                location.reload();
            });
    }
    
    function showAssignmentModal() {
        $('#assignmentModal').modal('show');
    }
    
    function loadDepartments() {
        $.get('/Role/GetDepartments', function(departments) {
            const select = $('#departmentId');
            select.empty();
            select.append('<option value="">Select Department</option>');
            departments.forEach(dept => {
                select.append(`<option value="${dept.departmentId}">${dept.name}</option>`);
            });
        });
        
        $('#departmentId').change(function() {
            loadTechnicians($(this).val());
        });
    }
    
    function loadTechnicians(departmentId) {
        if (!departmentId) {
            $('#assignedToUserId').html('<option value="">Select Technician</option>');
            return;
        }
        
        $.get('/Admin/GetTechniciansByDepartment', { departmentId: departmentId })
            .done(function(technicians) {
                const select = $('#assignedToUserId');
                select.html('<option value="">Select Technician</option>');
                
                technicians.forEach(tech => {
                    select.append(`<option value="${tech.userId}">${tech.name} (${tech.email})</option>`);
                });
            });
    }
    
    function submitAssignment() {
        const formData = {
            id: $('#assignmentComplaintId').val(),
            departmentId: $('#departmentId').val() || null,
            assignedToUserId: $('#assignedToUserId').val() || null,
            note: $('#assignmentNote').val()
        };
        
        $.post('/Admin/Assign', formData)
            .done(function() {
                $('#assignmentModal').modal('hide');
                location.reload();
            });
    }
</script>
}
