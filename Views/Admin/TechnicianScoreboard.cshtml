@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Field Technician Scoreboard - JanSamadhan";
    ViewData["FullWidth"] = true;

    var techsList = Model?.ToList() ?? new List<dynamic>();
    var top3 = techsList.Take(3).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/scoreboard.css" asp-append-version="true" />
}

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- Header Row -->
    <div class="scoreboard-header">
        <div>
            <nav class="scoreboard-subtitle mb-2" aria-label="Breadcrumb">
                <a href="/Admin" class="text-primary text-decoration-none">Admin</a>
                <span class="text-muted mx-1" aria-hidden="true">&sol;</span>
                <span class="text-slate-900 fw-semibold">Technician Board</span>
            </nav>
            <h1 class="scoreboard-title">Field Technician Performance Board</h1>
            <p class="scoreboard-subtitle">SLA resolution efficiency, completed tasks, and departmental operational rankings</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Admin/Scoreboard" class="btn btn-outline-primary rounded-pill px-3 fw-medium d-inline-flex align-items-center gap-2">
                <i class="fas fa-users" aria-hidden="true"></i>
                <span>Citizen Board &rarr;</span>
            </a>
            <a href="/Admin" class="btn btn-outline-secondary rounded-pill px-3 fw-medium d-inline-flex align-items-center gap-1">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                <span>Dashboard</span>
            </a>
        </div>
    </div>

    <!-- 1. Top 3 Olympic Podium for Field Technicians -->
    @if (top3.Any())
    {
        <section class="podium-wrapper" aria-label="Top 3 Field Technicians Podium">
            <div class="podium-heading">
                <h2 class="podium-heading__title">
                    <i class="fas fa-screwdriver-wrench text-primary" aria-hidden="true"></i>
                    <span>Top Operational Dispatchers</span>
                </h2>
                <span class="podium-heading__subtitle">Leading Workforce Operators by Fixed Tickets</span>
            </div>

            <div class="podium-grid">
                <!-- 2nd Place (Silver) -->
                @if (top3.Count > 1)
                {
                    var second = top3[1];
                    string sName = second.Name ?? "Technician";
                    string sInitial = string.IsNullOrWhiteSpace(sName) ? "T" : sName.Substring(0, 1).ToUpperInvariant();
                    int sTotal = second.CompletedTasks + second.PendingTasks;
                    var sPerf = sTotal > 0 ? Math.Round((double)second.CompletedTasks / sTotal * 100, 1) : 0;

                    <div class="podium-column podium-column--2">
                        <div class="podium-profile">
                            <div class="podium-avatar-wrap">
                                <div class="podium-avatar" aria-hidden="true">@sInitial</div>
                                <span class="podium-crown" title="2nd Place Field Master">
                                    <i class="fas fa-medal"></i>
                                </span>
                            </div>
                            <div class="podium-name" title="@sName">@sName</div>
                            <div class="podium-meta">@second.DepartmentName</div>
                            <div class="podium-score">
                                <i class="fas fa-check-circle text-secondary" aria-hidden="true"></i>
                                <span>@second.CompletedTasks Fixed · @sPerf%</span>
                            </div>
                        </div>
                        <div class="podium-pedestal">
                            <span class="podium-rank-num">2</span>
                        </div>
                    </div>
                }

                <!-- 1st Place (Gold - Center) -->
                @if (top3.Count > 0)
                {
                    var first = top3[0];
                    string fName = first.Name ?? "Technician";
                    string fInitial = string.IsNullOrWhiteSpace(fName) ? "T" : fName.Substring(0, 1).ToUpperInvariant();
                    int fTotal = first.CompletedTasks + first.PendingTasks;
                    var fPerf = fTotal > 0 ? Math.Round((double)first.CompletedTasks / fTotal * 100, 1) : 0;

                    <div class="podium-column podium-column--1">
                        <div class="podium-profile">
                            <div class="podium-avatar-wrap">
                                <div class="podium-avatar" aria-hidden="true">@fInitial</div>
                                <span class="podium-crown" title="1st Place Dispatch Champion">
                                    <i class="fas fa-crown"></i>
                                </span>
                            </div>
                            <div class="podium-name" title="@fName">@fName</div>
                            <div class="podium-meta">@first.DepartmentName</div>
                            <div class="podium-score">
                                <i class="fas fa-circle-check text-warning" aria-hidden="true"></i>
                                <span>@first.CompletedTasks Fixed · @fPerf%</span>
                            </div>
                        </div>
                        <div class="podium-pedestal">
                            <span class="podium-rank-num">1</span>
                        </div>
                    </div>
                }

                <!-- 3rd Place (Bronze) -->
                @if (top3.Count > 2)
                {
                    var third = top3[2];
                    string tName = third.Name ?? "Technician";
                    string tInitial = string.IsNullOrWhiteSpace(tName) ? "T" : tName.Substring(0, 1).ToUpperInvariant();
                    int tTotal = third.CompletedTasks + third.PendingTasks;
                    var tPerf = tTotal > 0 ? Math.Round((double)third.CompletedTasks / tTotal * 100, 1) : 0;

                    <div class="podium-column podium-column--3">
                        <div class="podium-profile">
                            <div class="podium-avatar-wrap">
                                <div class="podium-avatar" aria-hidden="true">@tInitial</div>
                                <span class="podium-crown" title="3rd Place Operator">
                                    <i class="fas fa-award"></i>
                                </span>
                            </div>
                            <div class="podium-name" title="@tName">@tName</div>
                            <div class="podium-meta">@third.DepartmentName</div>
                            <div class="podium-score">
                                <i class="fas fa-shield-halved text-danger" aria-hidden="true"></i>
                                <span>@third.CompletedTasks Fixed · @tPerf%</span>
                            </div>
                        </div>
                        <div class="podium-pedestal">
                            <span class="podium-rank-num">3</span>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- 2. Full Technician Workforce Table Card -->
    <div class="scoreboard-table-card">
        <div class="scoreboard-table-header">
            <div>
                <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="fas fa-table-list text-primary" aria-hidden="true"></i>
                    <span>Technician Operational Roster</span>
                </h2>
                <span class="text-muted small">Workforce performance metrics across municipal departments</span>
            </div>
            <span class="badge bg-light text-muted border text-xs">@techsList.Count active staff</span>
        </div>

        <div class="table-responsive">
            <table class="scoreboard-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px;" class="ps-4">Rank</th>
                        <th scope="col">Technician</th>
                        <th scope="col">Department</th>
                        <th scope="col">Resolved</th>
                        <th scope="col">Active Work</th>
                        <th scope="col" class="pe-4 text-end" style="min-width: 170px;">Resolution Efficiency</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!techsList.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-tools fa-3x mb-3 text-muted opacity-50" aria-hidden="true"></i>
                                <p class="mb-0 fw-semibold">No technician operational records available.</p>
                                <small class="text-muted">Register technicians in Role Management to track their tasks.</small>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int rank = 1;
                        foreach (var tech in techsList)
                        {
                            string tName = tech.Name ?? "Technician";
                            string tEmail = tech.Email ?? "—";
                            string tInitial = string.IsNullOrWhiteSpace(tName) ? "T" : tName.Substring(0, 1).ToUpperInvariant();
                            string deptName = tech.DepartmentName ?? "Unassigned";

                            int total = tech.CompletedTasks + tech.PendingTasks;
                            var perf = total > 0 ? Math.Round((double)tech.CompletedTasks / total * 100, 1) : 0;
                            var isTop3 = rank <= 3;
                            var rankBadgeClass = rank == 1 ? "bg-warning text-dark" : (rank == 2 ? "bg-secondary text-white" : (rank == 3 ? "bg-dark text-white" : ""));
                            var perfBarColor = perf >= 75 ? "bg-success" : (perf >= 50 ? "bg-primary" : "bg-warning");

                            <tr class="@(isTop3 ? "bg-light bg-opacity-50" : "")">
                                <td class="ps-4">
                                    @if (isTop3)
                                    {
                                        <span class="badge @rankBadgeClass rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 30px; height: 30px; font-weight: 700;">
                                            #@rank
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="table-rank-badge">#@rank</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-user-cell">
                                        <div class="table-user-avatar" aria-hidden="true">@tInitial</div>
                                        <div class="table-user-info">
                                            <div class="table-user-name">@tName</div>
                                            <div class="table-user-sub">@tEmail</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1">
                                        @deptName
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fw-bold">
                                        @tech.CompletedTasks Fixed
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-warning bg-opacity-25 text-dark rounded-pill px-3 py-1 fw-bold">
                                        @tech.PendingTasks Active
                                    </span>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex align-items-center justify-content-end gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; max-width: 100px; background: var(--slate-100);">
                                            <div class="progress-bar @perfBarColor rounded-pill" style="width: @perf%"></div>
                                        </div>
                                        <span class="small fw-bold text-dark" style="min-width: 44px;">@perf%</span>
                                    </div>
                                </td>
                            </tr>
                            rank++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
