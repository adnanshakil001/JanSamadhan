@{
    ViewData["Title"] = "Onboard Field Technician - JanSamadhan";
    ViewData["FullWidth"] = true;
    var departments = ViewBag.Departments as IEnumerable<JanSamadhan.Models.Department> ?? Enumerable.Empty<JanSamadhan.Models.Department>();

    string GetDepartmentIcon(string name)
    {
        var lower = (name ?? "").ToLower();
        if (lower.Contains("road") || lower.Contains("pothole") || lower.Contains("highway")) return "fa-road";
        if (lower.Contains("water") || lower.Contains("drain") || lower.Contains("pipe")) return "fa-faucet-drip";
        if (lower.Contains("electric") || lower.Contains("light") || lower.Contains("power")) return "fa-bolt";
        if (lower.Contains("sanitat") || lower.Contains("waste") || lower.Contains("clean") || lower.Contains("garbage")) return "fa-trash-can";
        if (lower.Contains("park") || lower.Contains("tree") || lower.Contains("garden")) return "fa-tree";
        return "fa-building-shield";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/roles-technicians.css" asp-append-version="true" />
}

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- Breadcrumb & Header Row -->
    <div class="role-header-row mb-4">
        <div>
            <nav class="role-subtitle mb-2" aria-label="Breadcrumb">
                <a href="/Admin" class="text-primary text-decoration-none">Admin</a>
                <span class="text-muted mx-1" aria-hidden="true">&sol;</span>
                <a href="/Role" class="text-primary text-decoration-none">Role Management</a>
                <span class="text-muted mx-1" aria-hidden="true">&sol;</span>
                <span class="text-slate-900 fw-semibold">Onboard Technician</span>
            </nav>
            <h1 class="role-title">Onboard Field Technician</h1>
            <p class="role-subtitle">Register a municipal workforce operator and map them to their operational department</p>
        </div>
        <div>
            <a href="/Role" class="btn btn-outline-secondary rounded-pill px-3 fw-medium d-inline-flex align-items-center gap-1">
                <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to Roles
            </a>
        </div>
    </div>

    <!-- Technician Onboarding Card -->
    <div class="technician-form-card">
        <div class="technician-form-header">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 bg-success bg-opacity-10 text-success rounded-3 fs-4" aria-hidden="true">
                    <i class="fas fa-id-badge"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold mb-1 text-dark">Workforce Registration</h2>
                    <p class="text-muted small mb-0">Technicians can log in to claim open grievances and submit field completion proofs.</p>
                </div>
            </div>
        </div>

        <div class="technician-form-body">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                    <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                    <i class="fas fa-circle-check me-2" aria-hidden="true"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form method="post" asp-action="CreateTechnician" id="createTechnicianForm" novalidate>
                @Html.AntiForgeryToken()

                <!-- Full Name Field -->
                <div class="mb-4">
                    <label class="form-label small fw-bold text-dark mb-1" for="techName">
                        Full Name <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-slate-50 border-end-0 text-muted" aria-hidden="true">
                            <i class="fas fa-user"></i>
                        </span>
                        <input type="text" id="techName" name="name" class="form-control rounded-end-3 py-2" placeholder="e.g. Rameshwar Sharma" required autocomplete="name" />
                    </div>
                    <small class="text-muted text-xs mt-1 d-block">Official technician identity for public resolution logs.</small>
                </div>

                <!-- Official Email Address -->
                <div class="mb-4">
                    <label class="form-label small fw-bold text-dark mb-1" for="techEmail">
                        Official Government / Agency Email <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-slate-50 border-end-0 text-muted" aria-hidden="true">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <input type="email" id="techEmail" name="email" class="form-control rounded-end-3 py-2" placeholder="technician@dept.gov.in" required autocomplete="email" />
                    </div>
                    <small class="text-muted text-xs mt-1 d-block">Used for login credentials and dispatch ticket notifications.</small>
                </div>

                <!-- Initial Password with Toggle -->
                <div class="mb-4">
                    <label class="form-label small fw-bold text-dark mb-1" for="techPassword">
                        Temporary Access Password <span class="text-danger">*</span>
                    </label>
                    <div class="password-input-group">
                        <input type="password" id="techPassword" name="password" class="form-control rounded-3 py-2 pe-5" placeholder="Minimum 6 characters" required autocomplete="new-password" />
                        <button type="button" class="password-toggle-btn" id="togglePasswordBtn" aria-label="Show password" title="Toggle password visibility">
                            <i class="fas fa-eye" id="passwordToggleIcon" aria-hidden="true"></i>
                        </button>
                    </div>
                    <small class="text-muted text-xs mt-1 d-block">The technician will use this temporary password for their initial portal sign-in.</small>
                </div>

                <!-- Card-Based Department Selector -->
                <div class="mb-4">
                    <label class="form-label small fw-bold text-dark mb-1 d-block">
                        Assigned Municipal Department <span class="text-danger">*</span>
                    </label>
                    <span class="text-muted small d-block mb-2">Select the civic branch this technician operates under:</span>

                    <fieldset class="dept-radio-grid" role="radiogroup" aria-label="Municipal Department Options">
                        @{
                            int idx = 0;
                            foreach (var dept in departments)
                            {
                                var iconClass = GetDepartmentIcon(dept.Name);
                                var radioId = $"dept_radio_{dept.DepartmentId}";
                                var isFirst = idx == 0;

                                <label class="dept-radio-card @(isFirst ? "is-selected" : "")" for="@radioId">
                                    <input type="radio" id="@radioId" name="departmentId" value="@dept.DepartmentId" @(isFirst ? "checked" : "") required />
                                    <span class="dept-radio-icon" aria-hidden="true">
                                        <i class="fas @iconClass"></i>
                                    </span>
                                    <span class="dept-radio-label">@dept.Name</span>
                                </label>
                                idx++;
                            }
                        }
                    </fieldset>
                </div>

                <!-- Form Submit Action Buttons -->
                <div class="pt-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <button type="submit" class="btn btn-success fw-bold px-4 py-2 rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
                        <i class="fas fa-user-check" aria-hidden="true"></i>
                        <span>Register &amp; Activate Technician</span>
                    </button>
                    <a href="/Role" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // 1. Password Visibility Toggle
        const toggleBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('techPassword');
        const toggleIcon = document.getElementById('passwordToggleIcon');

        if (toggleBtn && passwordInput && toggleIcon) {
            toggleBtn.addEventListener('click', function () {
                const isPassword = passwordInput.getAttribute('type') === 'password';
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                toggleIcon.className = isPassword ? 'fas fa-eye-slash' : 'fas fa-eye';
                toggleBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
            });
        }

        // 2. Card-Based Department Selector Interactivity
        const deptCards = document.querySelectorAll('.dept-radio-card');
        deptCards.forEach(function (card) {
            const radio = card.querySelector('input[type="radio"]');

            card.addEventListener('click', function () {
                deptCards.forEach(c => c.classList.remove('is-selected'));
                card.classList.add('is-selected');
                if (radio) {
                    radio.checked = true;
                }
            });

            if (radio) {
                radio.addEventListener('focus', function () {
                    deptCards.forEach(c => c.classList.remove('is-selected'));
                    card.classList.add('is-selected');
                });
            }
        });
    });
</script>
}
