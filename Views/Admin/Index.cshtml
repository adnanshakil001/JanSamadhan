@model IEnumerable<JanSamadhan.Models.Complaint>
@functions {
    public static string GetCategoryIcon(string problemType)
    {
        if (string.IsNullOrEmpty(problemType)) return "fa-triangle-exclamation";
        var lower = problemType.ToLowerInvariant();
        if (lower.Contains("pothole") || lower.Contains("road")) return "fa-road";
        if (lower.Contains("light") || lower.Contains("lamp")) return "fa-lightbulb";
        if (lower.Contains("garbage") || lower.Contains("waste") || lower.Contains("trash") || lower.Contains("clean")) return "fa-trash-can";
        if (lower.Contains("water") || lower.Contains("drain") || lower.Contains("sewage") || lower.Contains("leak")) return "fa-faucet-drip";
        if (lower.Contains("traffic") || lower.Contains("signal")) return "fa-traffic-light";
        if (lower.Contains("park") || lower.Contains("tree")) return "fa-tree";
        return "fa-circle-exclamation";
    }
}
@{
    ViewData["Title"] = "Admin Command Center — JanSamadhan";
    var topTechs = ViewBag.TopTechnicians as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var deptStats = ViewBag.DepartmentStats as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    var pendingCount = (int)(ViewBag.TotalPending ?? 0);
    var inProgressCount = (int)(ViewBag.TotalInProgress ?? 0);
    var fixedCount = (int)(ViewBag.TotalFixed ?? 0);
    var totalAll = pendingCount + inProgressCount + fixedCount;
    var totalFiltered = (int)(ViewBag.TotalCount ?? totalAll);

    var resolvedRate = totalAll > 0 ? (int)Math.Round((double)fixedCount / totalAll * 100) : 0;
    var pendingRate = totalAll > 0 ? (int)Math.Round((double)pendingCount / totalAll * 100) : 0;
    var inProgressRate = totalAll > 0 ? (int)Math.Round((double)inProgressCount / totalAll * 100) : 0;
    var currentStatus = ViewBag.Status as string ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/complaints.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

<!-- 1. Dashboard Header (Unified with Citizen Dashboard) -->
<div class="dashboard-header">
    <div>
        <h1 class="dashboard-title">Admin Command Center</h1>
        <p class="dashboard-subtitle">Real-time operational dispatch, department triage, and civic grievance resolution</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <a href="/Admin/CreateTechnician" class="dashboard-action-btn">
            <i class="fas fa-user-plus" aria-hidden="true"></i>
            <span>Add Technician</span>
        </a>
        <a href="/Map/AdminMap" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2">
            <i class="fas fa-map-location-dot" aria-hidden="true"></i>
            <span>Full GIS Map</span>
        </a>
        <div class="dropdown">
            <button class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold dropdown-toggle d-inline-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-file-export" aria-hidden="true"></i>
                <span>Export</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" href="@Url.Action("Export", new { status = ViewBag.Status, departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q, sortBy = ViewBag.SortBy, sortOrder = ViewBag.SortOrder, format = "csv" })">
                        <i class="fas fa-file-csv text-success"></i> Export as CSV
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" href="@Url.Action("Export", new { status = ViewBag.Status, departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q, sortBy = ViewBag.SortBy, sortOrder = ViewBag.SortOrder, format = "excel" })">
                        <i class="fas fa-file-excel text-success"></i> Export as Excel
                    </a>
                </li>
                <li>
                    <a class="dropdown-item d-flex align-items-center gap-2" href="@Url.Action("Export", new { status = ViewBag.Status, departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q, sortBy = ViewBag.SortBy, sortOrder = ViewBag.SortOrder, format = "pdf" })">
                        <i class="fas fa-file-pdf text-danger"></i> Export as PDF
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="fas fa-circle-check me-2" aria-hidden="true"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- 2. 4-Metric KPI Row (Citizen Design System) -->
<section class="metrics-grid metrics-grid--4" aria-label="Operational Key Metrics">
    <div class="metric-card metric-card--primary">
        <div class="metric-card__content">
            <span class="metric-card__label">Total Grievances</span>
            <span class="metric-card__count">@totalAll.ToString("N0")</span>
            <small class="text-muted mt-1 text-xs">All-time municipal volume</small>
        </div>
        <div class="metric-card__icon" aria-hidden="true">
            <i class="fas fa-layer-group"></i>
        </div>
    </div>

    <div class="metric-card metric-card--pending">
        <div class="metric-card__content">
            <span class="metric-card__label">Pending Triage</span>
            <span class="metric-card__count">@pendingCount.ToString("N0")</span>
            @if (pendingCount == 0)
            {
                <small class="text-success mt-1 text-xs fw-semibold d-inline-flex align-items-center gap-1">
                    <i class="fas fa-circle-check"></i> All caught up &middot; 0 pending
                </small>
            }
            else
            {
                <small class="text-danger mt-1 text-xs fw-semibold">@pendingRate% awaiting dispatch</small>
            }
        </div>
        <div class="metric-card__icon" aria-hidden="true">
            <i class="fas fa-clock"></i>
        </div>
    </div>

    <div class="metric-card metric-card--inprogress">
        <div class="metric-card__content">
            <span class="metric-card__label">In Field Repair</span>
            <span class="metric-card__count">@inProgressCount.ToString("N0")</span>
            <small class="text-warning mt-1 text-xs fw-semibold">@inProgressRate% active technicians</small>
        </div>
        <div class="metric-card__icon" aria-hidden="true">
            <i class="fas fa-screwdriver-wrench"></i>
        </div>
    </div>

    <div class="metric-card metric-card--fixed">
        <div class="metric-card__content">
            <span class="metric-card__label">Resolved &amp; Closed</span>
            <span class="metric-card__count">@fixedCount.ToString("N0")</span>
            <small class="text-success mt-1 text-xs fw-semibold">@resolvedRate% resolution rate</small>
        </div>
        <div class="metric-card__icon" aria-hidden="true">
            <i class="fas fa-circle-check"></i>
        </div>
    </div>
</section>

<!-- 3. Master Filter & Search Toolbar (Unified with Citizen Dashboard) -->
<div class="complaints-toolbar flex-column gap-3">
    <!-- Segmented Status Tabs -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 w-100">
        <div class="filter-tabs" role="tablist" aria-label="Filter Complaints by Status">
            <a href="@Url.Action("Index", new { status = "", departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q })" 
               class="filter-tab @(string.IsNullOrEmpty(currentStatus) ? "active" : "")" role="tab">
                <span>All Grievances</span>
                <span class="filter-tab__count">@totalAll</span>
            </a>
            <a href="@Url.Action("Index", new { status = "Pending", departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q })" 
               class="filter-tab @(currentStatus == "Pending" ? "active" : "")" role="tab">
                <span>Pending</span>
                <span class="filter-tab__count">@pendingCount</span>
            </a>
            <a href="@Url.Action("Index", new { status = "InProgress", departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q })" 
               class="filter-tab @(currentStatus == "InProgress" ? "active" : "")" role="tab">
                <span>In Progress</span>
                <span class="filter-tab__count">@inProgressCount</span>
            </a>
            <a href="@Url.Action("Index", new { status = "Fixed", departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q })" 
               class="filter-tab @(currentStatus == "Fixed" ? "active" : "")" role="tab">
                <span>Resolved</span>
                <span class="filter-tab__count">@fixedCount</span>
            </a>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="/Role" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-1">
                <i class="fas fa-users-gear" aria-hidden="true"></i> <span>Roles</span>
            </a>
            <a href="/Admin/Scoreboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-1">
                <i class="fas fa-trophy" aria-hidden="true"></i> <span>Citizens</span>
            </a>
            <a href="/Admin/TechnicianScoreboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-1">
                <i class="fas fa-award" aria-hidden="true"></i> <span>Technicians</span>
            </a>
        </div>
    </div>

    <!-- Dropdown Filters & Search Box -->
    <form method="get" action="/Admin" class="row g-2 align-items-center w-100 pt-2 border-top">
        <input type="hidden" name="status" value="@ViewBag.Status" />
        <div class="col-12 col-md-3">
            <select class="form-select form-select-sm rounded-pill" name="departmentId" aria-label="Filter by department" onchange="this.form.submit()">
                <option value="">All Departments</option>
                @foreach (var dept in ViewBag.Departments)
                {
                    <option value="@dept.DepartmentId" selected="@(ViewBag.DepartmentId == dept.DepartmentId)">@dept.Name</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-3">
            <select class="form-select form-select-sm rounded-pill" name="assignedToUserId" aria-label="Filter by technician" onchange="this.form.submit()">
                <option value="">All Field Technicians</option>
                @foreach (var user in ViewBag.Users)
                {
                    <option value="@user.UserId" selected="@(ViewBag.AssignedToUserId == user.UserId)">@user.Name</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-4">
            <div class="search-wrapper">
                <i class="fas fa-search search-icon" aria-hidden="true"></i>
                <input type="search" class="search-input" name="q" value="@ViewBag.Q" placeholder="Search keyword, user, or location..." aria-label="Search grievances" />
            </div>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold flex-grow-1">Filter</button>
            <a href="/Admin" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Reset</a>
        </div>
    </form>
</div>

<!-- 4. Live Density Map & SLA Analytics Grid -->
<div class="admin-analytics-grid mb-5">
    <!-- Density Map Card -->
    <div class="density-map-card">
        <div class="admin-table-header">
            <div>
                <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="fas fa-map-pin text-primary" aria-hidden="true"></i>
                    <span>Live Incident Density Map</span>
                </h2>
                <span class="text-muted small">Real-time geographic clusters of active citizen grievances</span>
            </div>
            <div class="map-legend-pills">
                <span class="map-legend-pill status-pill--pending">Pending</span>
                <span class="map-legend-pill status-pill--inprogress">In Progress</span>
                <span class="map-legend-pill status-pill--fixed">Resolved</span>
            </div>
        </div>
        <div id="densityMap" class="density-map-canvas" role="region" aria-label="Incident Density Map"></div>
    </div>

    <!-- Department SLA Progress Card -->
    <div class="dept-sla-card">
        <div>
            <h2 class="h6 fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="fas fa-chart-column text-primary" aria-hidden="true"></i>
                <span>Department Performance</span>
            </h2>
            <span class="text-muted small d-block mb-3">Resolution efficiency by civic agency</span>

            <div class="dept-sla-list">
                @if (!deptStats.Any())
                {
                    <p class="text-muted small py-3 mb-0">No department metrics available.</p>
                }
                else
                {
                    foreach (var dept in deptStats)
                    {
                        <div class="dept-sla-item">
                            <div class="d-flex justify-content-between align-items-center small">
                                <span class="fw-semibold text-dark">@dept.Name</span>
                                <span class="text-muted">
                                    @dept.Fixed/@dept.Total fixed
                                    <strong class="text-dark ms-1">@dept.Rate%</strong>
                                </span>
                            </div>
                            <div class="dept-sla-bar-bg" role="progressbar" aria-valuenow="@dept.Rate" aria-valuemin="0" aria-valuemax="100">
                                <div class="dept-sla-bar-fill @(dept.Rate >= 80 ? "bg-success" : (dept.Rate >= 50 ? "bg-primary" : "bg-warning"))" style="width: @dept.Rate%;"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="pt-3 mt-3 border-top d-flex justify-content-between align-items-center text-muted small">
            <span>Target SLA: &ge;85%</span>
            <a href="/Department" class="text-primary text-decoration-none fw-semibold">View Queues &rarr;</a>
        </div>
    </div>
</div>

<!-- 5. Top Technicians Leaderboard Card -->
<div class="top-tech-card mb-5">
    <div class="admin-table-header">
        <div>
            <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="fas fa-medal text-warning" aria-hidden="true"></i>
                <span>Top Field Technicians</span>
            </h2>
            <span class="text-muted small">Highest-performing field operators ranked by resolved work</span>
        </div>
        <a href="/Admin/TechnicianScoreboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            Full Board &rarr;
        </a>
    </div>
    <div class="table-responsive">
        <table class="admin-table mb-0">
            <thead>
                <tr>
                    <th style="width: 80px;">Rank</th>
                    <th>Technician</th>
                    <th>Department</th>
                    <th>Tasks Fixed</th>
                    <th>Resolution Rate</th>
                    <th class="text-end">Points Earned</th>
                </tr>
            </thead>
            <tbody>
                @if (!topTechs.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <p class="mb-0 small">No technician activity recorded yet.</p>
                        </td>
                    </tr>
                }
                else
                {
                    int rank = 1;
                    foreach (var tech in topTechs)
                    {
                        var rankClass = rank == 1 ? "rank-badge--1" : (rank == 2 ? "rank-badge--2" : (rank == 3 ? "rank-badge--3" : ""));
                        var techInitial = string.IsNullOrWhiteSpace(tech.Name) ? "T" : tech.Name.Substring(0, 1).ToUpperInvariant();
                        <tr>
                            <td>
                                <span class="rank-badge @rankClass">
                                    @if (rank == 1) { <i class="fas fa-crown text-xs me-1"></i> }
                                    #@rank
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="admin-avatar-sm" aria-hidden="true">@techInitial</div>
                                    <div class="min-w-0">
                                        <div class="fw-bold text-dark">@tech.Name</div>
                                        <small class="text-muted d-block text-truncate" style="max-width: 170px;">@tech.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">@tech.DepartmentName</span>
                            </td>
                            <td class="fw-bold text-dark">@tech.FixedTasks / @tech.TotalAssigned</td>
                            <td>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1">
                                    <i class="fas fa-check-circle me-1"></i>@tech.CompletionRate%
                                </span>
                            </td>
                            <td class="text-end">
                                <span class="points-pill">
                                    <i class="fas fa-coins text-warning"></i>
                                    <span>@tech.Points.ToString("N0") pts</span>
                                </span>
                            </td>
                        </tr>
                        rank++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 6. Complaints Master Table (Citizen Design Structure) -->
<div class="complaints-table-container mb-4">
    <div class="admin-table-header p-3 border-bottom">
        <div>
            <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="fas fa-list-check text-primary" aria-hidden="true"></i>
                <span>Complaints Master Registry</span>
            </h2>
            <span class="text-muted small">
                Showing @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + (totalFiltered > 0 ? 1 : 0)) to @(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, totalFiltered)) of @totalFiltered complaints
            </span>
        </div>
        <div class="text-muted small fw-medium">
            Page @ViewBag.CurrentPage of @Math.Max(1, ViewBag.TotalPages)
        </div>
    </div>

    <table class="complaints-table mb-0">
        <thead>
            <tr>
                <th>
                    <a href="@Url.Action("Index", new { status = ViewBag.Status, departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q, sortBy = "CreatedAt", sortOrder = ViewBag.SortBy == "CreatedAt" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-decoration-none text-muted">
                        Date @if (ViewBag.SortBy == "CreatedAt") { <i class="fas fa-sort-@(ViewBag.SortOrder == "asc" ? "up" : "down")" aria-hidden="true"></i> }
                    </a>
                </th>
                <th>
                    <a href="@Url.Action("Index", new { status = ViewBag.Status, departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q, sortBy = "Username", sortOrder = ViewBag.SortBy == "Username" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-decoration-none text-muted">
                        Citizen @if (ViewBag.SortBy == "Username") { <i class="fas fa-sort-@(ViewBag.SortOrder == "asc" ? "up" : "down")" aria-hidden="true"></i> }
                    </a>
                </th>
                <th>Issue Type</th>
                <th>Location</th>
                <th>Status</th>
                <th>Department</th>
                <th>Photo</th>
                <th>Quick Triage</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center py-5 text-muted">
                        <i class="fas fa-clipboard-check fa-3x mb-3 text-muted opacity-50" aria-hidden="true"></i>
                        <p class="mb-0 fw-semibold">No complaints matching the current filter criteria.</p>
                        <small class="text-muted">Try clearing your search query or reset the filters.</small>
                    </td>
                </tr>
            }
            @foreach (var c in Model)
            {
                var statusClass = c.Status == JanSamadhan.Models.ComplaintStatus.Fixed
                    ? "status-pill--fixed"
                    : c.Status == JanSamadhan.Models.ComplaintStatus.InProgress
                        ? "status-pill--inprogress"
                        : "status-pill--pending";

                var citizenInitial = string.IsNullOrWhiteSpace(c.User?.Name) ? "C" : c.User.Name.Substring(0, 1).ToUpperInvariant();

                <tr>
                    <td class="small text-muted whitespace-nowrap">
                        <span class="fw-semibold text-dark">@c.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                        <span class="d-block text-xs text-muted">@c.CreatedAt.ToLocalTime().ToString("hh:mm tt")</span>
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="admin-avatar-sm admin-avatar-sm--citizen" aria-hidden="true">@citizenInitial</div>
                            <div class="min-w-0">
                                <div class="fw-bold text-dark text-truncate" style="max-width: 140px;">@(c.User?.Name ?? "Anonymous")</div>
                                <span class="badge bg-light text-muted border text-xs">@(c.User?.Role ?? "Citizen")</span>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="category-pill">
                            <i class="fas @GetCategoryIcon(c.ProblemType)" aria-hidden="true"></i>
                            <span>@c.ProblemType</span>
                        </span>
                    </td>
                    <td class="small text-truncate" style="max-width: 200px;" title="@c.Address">
                        <i class="fas fa-location-dot text-danger me-1" aria-hidden="true"></i>
                        @(string.IsNullOrWhiteSpace(c.Address) ? "No address specified" : c.Address)
                    </td>
                    <td>
                        <span class="status-pill @statusClass">@c.Status</span>
                    </td>
                    <td class="small text-muted">
                        @(c.Department?.Name ?? "Unassigned")
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(c.PhotoPath))
                        {
                            <a href="@c.PhotoPath" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary p-1 rounded-2" title="View uploaded image">
                                <i class="fas fa-image" aria-hidden="true"></i>
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small">&mdash;</span>
                        }
                    </td>
                    <td>
                        @if (c.Status == JanSamadhan.Models.ComplaintStatus.Fixed)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 text-xs d-inline-flex align-items-center gap-1">
                                <i class="fas fa-check-double"></i> Fixed
                            </span>
                        }
                        else
                        {
                            <form method="post" asp-action="UpdateStatus" asp-controller="Admin" class="d-flex align-items-center gap-1">
                                <input type="hidden" name="id" value="@c.ComplaintId" />
                                <select class="form-select form-select-sm rounded-pill text-xs py-1" name="status" style="min-width: 105px;" aria-label="Change status">
                                    @if (c.Status == JanSamadhan.Models.ComplaintStatus.Pending)
                                    {
                                        <option value="0" selected>Pending</option>
                                        <option value="1">In Progress</option>
                                        <option value="2">Fixed</option>
                                    }
                                    else if (c.Status == JanSamadhan.Models.ComplaintStatus.InProgress)
                                    {
                                        <option value="1" selected>In Progress</option>
                                        <option value="2">Fixed</option>
                                    }
                                </select>
                                <button class="btn btn-sm btn-primary rounded-circle p-1 d-flex align-items-center justify-content-center shadow-xs" style="width:26px; height:26px;" type="submit" title="Save status">
                                    <i class="fas fa-check text-xs" aria-hidden="true"></i>
                                </button>
                            </form>
                        }
                    </td>
                    <td class="text-end">
                        <a href="@Url.Action("Details", "Admin", new { id = c.ComplaintId })" class="table-action-btn">
                            <span>Review Case</span>
                            <i class="fas fa-chevron-right" aria-hidden="true"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="admin-table-header p-3 border-top">
            <span class="text-muted small">Showing page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
            <nav aria-label="Complaints registry pagination">
                <ul class="pagination pagination-sm mb-0 gap-1">
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3" href="@Url.Action("Index", new { status = ViewBag.Status, departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q, sortBy = ViewBag.SortBy, sortOrder = ViewBag.SortOrder, page = ViewBag.CurrentPage - 1 })">
                            Previous
                        </a>
                    </li>
                    @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" href="@Url.Action("Index", new { status = ViewBag.Status, departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q, sortBy = ViewBag.SortBy, sortOrder = ViewBag.SortOrder, page = i })">
                                @i
                            </a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3" href="@Url.Action("Index", new { status = ViewBag.Status, departmentId = ViewBag.DepartmentId, assignedToUserId = ViewBag.AssignedToUserId, q = ViewBag.Q, sortBy = ViewBag.SortBy, sortOrder = ViewBag.SortOrder, page = ViewBag.CurrentPage + 1 })">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Mobile Cards Presentation -->
<div class="complaints-cards-container mb-4">
    @foreach (var c in Model)
    {
        var statusClass = c.Status == JanSamadhan.Models.ComplaintStatus.Fixed
            ? "status-pill--fixed"
            : c.Status == JanSamadhan.Models.ComplaintStatus.InProgress
                ? "status-pill--inprogress"
                : "status-pill--pending";

        <div class="mobile-complaint-card">
            <div class="mobile-card__head">
                <span class="status-pill @statusClass">@c.Status</span>
                <span class="badge bg-light text-muted border text-xs">Case #@c.ComplaintId</span>
            </div>
            <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                <i class="fas @GetCategoryIcon(c.ProblemType) text-primary" aria-hidden="true"></i>
                <span>@c.ProblemType</span>
            </div>
            <p class="text-muted small mb-1">@(string.IsNullOrWhiteSpace(c.Description) ? "No detailed description provided." : c.Description)</p>
            <div class="d-flex align-items-center gap-2 text-muted small">
                <i class="fas fa-location-dot text-danger" aria-hidden="true"></i>
                <span class="text-truncate">@(string.IsNullOrWhiteSpace(c.Address) ? "Coordinates registered" : c.Address)</span>
            </div>
            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                <span class="text-muted text-xs">@c.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                <a href="@Url.Action("Details", "Admin", new { id = c.ComplaintId })" class="table-action-btn">
                    <span>Review Case</span>
                    <i class="fas fa-chevron-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Initialize Live Incident Density Map
        const mapElement = document.getElementById('densityMap');
        if (!mapElement) return;

        const defaultBhopal = [23.2599, 77.4126];
        const map = L.map('densityMap', {
            zoomControl: true,
            scrollWheelZoom: false
        }).setView(defaultBhopal, 12);

        // OpenStreetMap Free & Reliable Tile Server (No API Key Required)
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        // Fetch live incident GeoJSON
        $.getJSON('/Map/MapData', function (geojson) {
            if (geojson && geojson.features && geojson.features.length > 0) {
                const markers = [];
                geojson.features.forEach(function (feat) {
                    const coords = feat.geometry.coordinates;
                    const props = feat.properties;
                    const lat = coords[1];
                    const lng = coords[0];

                    // Verify valid geographic coordinates in Central India range
                    if (lat > 15 && lat < 30 && lng > 70 && lng < 85) {
                        const color = props.status === 'Fixed'
                            ? '#047857'
                            : (props.status === 'InProgress' ? '#b45309' : '#dc2626');

                        const statusClass = props.status === 'Fixed'
                            ? 'status-pill--fixed'
                            : (props.status === 'InProgress' ? 'status-pill--inprogress' : 'status-pill--pending');

                        const marker = L.circleMarker([lat, lng], {
                            radius: 8,
                            fillColor: color,
                            color: '#ffffff',
                            weight: 2,
                            opacity: 1,
                            fillOpacity: 0.85
                        }).addTo(map);

                        const popupContent = `
                            <div style="font-family: inherit; font-size: 13px; line-height: 1.4; padding: 2px;">
                                <strong style="font-size: 14px; color: #0f172a;">${props.problemType || 'Civic Issue'}</strong>
                                <p style="margin: 4px 0 6px 0; color: #64748b;">${props.address || 'Location coordinates registered'}</p>
                                <span class="status-pill ${statusClass}" style="display:inline-flex;">${props.status}</span>
                            </div>
                        `;
                        marker.bindPopup(popupContent);
                        markers.push([lat, lng]);
                    }
                });

                if (markers.length > 0) {
                    map.fitBounds(markers, { padding: [35, 35], maxZoom: 14 });
                } else {
                    map.setView(defaultBhopal, 12);
                }
            } else {
                map.setView(defaultBhopal, 12);
            }

            // Invalidate size to guarantee smooth render without grey tiles
            setTimeout(function () {
                map.invalidateSize();
            }, 250);
        });

        window.addEventListener('resize', function () {
            map.invalidateSize();
        });
    });
</script>
}
