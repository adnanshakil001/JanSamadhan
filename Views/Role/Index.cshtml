@model IEnumerable<JanSamadhan.Models.User>
@{
    ViewData["Title"] = "User Role Management - JanSamadhan";
    ViewData["FullWidth"] = true;

    var totalUsers = ViewBag.TotalUsers as int? ?? Model.Count();
    var techCount = ViewBag.TechnicianCount as int? ?? Model.Count(u => u.Role == "Technician");
    var citizenCount = ViewBag.RegularUserCount as int? ?? Model.Count(u => u.Role == "User");
}

@section Styles {
    <link rel="stylesheet" href="~/css/roles-technicians.css" asp-append-version="true" />
}

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- Header Row -->
    <div class="role-header-row">
        <div>
            <h1 class="role-title">User Role Management</h1>
            <p class="role-subtitle">Manage municipal workforce permissions, department assignments, and citizen access</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a href="/Admin/CreateTechnician" class="btn btn-success fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="fas fa-user-plus" aria-hidden="true"></i>
                <span>Add Technician</span>
            </a>
            <button type="button" class="btn btn-primary fw-semibold d-inline-flex align-items-center gap-2" onclick="showBulkUpdateModal()">
                <i class="fas fa-users-gear" aria-hidden="true"></i>
                <span>Bulk Update</span>
            </button>
            <a href="/Admin" class="btn btn-outline-secondary fw-semibold d-inline-flex align-items-center gap-1">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                <span>Admin Dashboard</span>
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="fas fa-circle-check me-2" aria-hidden="true"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 1. KPI Metric Summary Cards -->
    <section class="role-kpi-grid" aria-label="User Base Statistics">
        <div class="role-kpi-card role-kpi-card--primary">
            <div>
                <span class="role-kpi-card__label">Total User Accounts</span>
                <p class="role-kpi-card__value">@totalUsers.ToString("N0")</p>
            </div>
            <div class="role-kpi-card__icon" aria-hidden="true">
                <i class="fas fa-users"></i>
            </div>
        </div>

        <div class="role-kpi-card role-kpi-card--success">
            <div>
                <span class="role-kpi-card__label">Field Technicians</span>
                <p class="role-kpi-card__value">@techCount.ToString("N0")</p>
            </div>
            <div class="role-kpi-card__icon" aria-hidden="true">
                <i class="fas fa-screwdriver-wrench"></i>
            </div>
        </div>

        <div class="role-kpi-card role-kpi-card--info">
            <div>
                <span class="role-kpi-card__label">Registered Citizens</span>
                <p class="role-kpi-card__value">@citizenCount.ToString("N0")</p>
            </div>
            <div class="role-kpi-card__icon" aria-hidden="true">
                <i class="fas fa-user-check"></i>
            </div>
        </div>
    </section>

    <!-- 2. Search & Filter Card -->
    <div class="role-filter-card">
        <form method="get" action="/Role" class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1" for="roleFilter">Filter by Role</label>
                <select id="roleFilter" class="form-select rounded-3" name="role">
                    <option value="">All Roles</option>
                    <option value="User" selected="@(ViewBag.Role == "User")">Citizen (User)</option>
                    <option value="Technician" selected="@(ViewBag.Role == "Technician")">Technician</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1" for="departmentFilter">Department</label>
                <select id="departmentFilter" class="form-select rounded-3" name="departmentId">
                    <option value="">All Departments</option>
                    @foreach (var dept in ViewBag.Departments)
                    {
                        <option value="@dept.DepartmentId" selected="@(ViewBag.DepartmentId == dept.DepartmentId)">
                            @dept.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1" for="searchQuery">Search Name or Email</label>
                <input type="text" id="searchQuery" class="form-control rounded-3" name="q" value="@ViewBag.Q" placeholder="Type user name or email address...">
            </div>
            <div class="col-12 col-sm-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 rounded-3 fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                    <i class="fas fa-filter" aria-hidden="true"></i> Filter
                </button>
                <a href="/Role" class="btn btn-outline-secondary rounded-3 px-3" title="Clear all filters">Reset</a>
            </div>
        </form>
    </div>

    <!-- 3. User Registry Table Card -->
    <div class="role-table-card">
        <div class="role-table-header">
            <div class="d-flex align-items-center gap-3">
                <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="fas fa-users-viewfinder text-primary" aria-hidden="true"></i>
                    <span>User Accounts Registry</span>
                </h2>
                <span class="badge bg-light text-muted border text-xs">@Model.Count() records shown</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Selected: <strong id="selectedCount" class="text-dark">0</strong></span>
                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" onclick="showBulkUpdateModal()">
                    Bulk Action
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="role-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 48px;" class="text-center">
                            <input type="checkbox" id="selectAll" class="role-checkbox" aria-label="Select all users" onchange="toggleAllCheckboxes()" />
                        </th>
                        <th scope="col">
                            <a href="@Url.Action("Index", new { role = ViewBag.Role, departmentId = ViewBag.DepartmentId, q = ViewBag.Q, sortBy = "Name", sortOrder = ViewBag.SortBy == "Name" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })">
                                User Details @if (ViewBag.SortBy == "Name") { <i class="fas fa-sort-@(ViewBag.SortOrder == "asc" ? "up" : "down")" aria-hidden="true"></i> }
                            </a>
                        </th>
                        <th scope="col">
                            <a href="@Url.Action("Index", new { role = ViewBag.Role, departmentId = ViewBag.DepartmentId, q = ViewBag.Q, sortBy = "Role", sortOrder = ViewBag.SortBy == "Role" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })">
                                Role @if (ViewBag.SortBy == "Role") { <i class="fas fa-sort-@(ViewBag.SortOrder == "asc" ? "up" : "down")" aria-hidden="true"></i> }
                            </a>
                        </th>
                        <th scope="col">
                            <a href="@Url.Action("Index", new { role = ViewBag.Role, departmentId = ViewBag.DepartmentId, q = ViewBag.Q, sortBy = "Department", sortOrder = ViewBag.SortBy == "Department" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })">
                                Department @if (ViewBag.SortBy == "Department") { <i class="fas fa-sort-@(ViewBag.SortOrder == "asc" ? "up" : "down")" aria-hidden="true"></i> }
                            </a>
                        </th>
                        <th scope="col">
                            <a href="@Url.Action("Index", new { role = ViewBag.Role, departmentId = ViewBag.DepartmentId, q = ViewBag.Q, sortBy = "Points", sortOrder = ViewBag.SortBy == "Points" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })">
                                Civic Engagement @if (ViewBag.SortBy == "Points") { <i class="fas fa-sort-@(ViewBag.SortOrder == "asc" ? "up" : "down")" aria-hidden="true"></i> }
                            </a>
                        </th>
                        <th scope="col" class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-user-slash fa-3x mb-3 text-muted opacity-50" aria-hidden="true"></i>
                                <p class="mb-0 fw-semibold">No users found matching current filters.</p>
                                <small class="text-muted">Try adjusting search parameters or clearing filters.</small>
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model)
                    {
                        var isTech = user.Role == "Technician";
                        var isAdmin = user.Role == "Admin";
                        var roleClass = isTech ? "role-pill--technician" : (isAdmin ? "role-pill--admin" : "role-pill--citizen");
                        var avatarClass = isTech ? "user-avatar--technician" : (isAdmin ? "user-avatar--admin" : "");
                        var initial = string.IsNullOrWhiteSpace(user.Name) ? "U" : user.Name.Substring(0, 1).ToUpperInvariant();

                        <tr data-user-id="@user.UserId">
                            <td class="text-center">
                                <input type="checkbox" class="role-checkbox user-checkbox" value="@user.UserId" aria-label="Select user @user.Name" onchange="updateSelectAllState()" />
                            </td>
                            <td>
                                <div class="user-cell">
                                    <div class="user-avatar @avatarClass" aria-hidden="true">@initial</div>
                                    <div class="user-meta">
                                        <div class="user-name">@user.Name</div>
                                        <div class="user-email">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="role-pill @roleClass">@user.Role</span>
                            </td>
                            <td class="small text-muted">
                                @(user.Department?.Name ?? "—")
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1">
                                    <i class="fas fa-medal text-warning me-1" aria-hidden="true"></i>
                                    @user.Points.ToString("N0") pts · @(user.BadgeLevel ?? "Bronze")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <button type="button" class="action-btn-circle" title="Edit Role &amp; Department" aria-label="Edit role for @user.Name" onclick="editRole(@user.UserId, '@user.Role', '@(user.DepartmentId?.ToString() ?? "")')">
                                        <i class="fas fa-pen-to-square" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="action-btn-circle is-danger" title="Delete User Account" aria-label="Delete account for @user.Name" onclick="deleteUser(@user.UserId, '@user.Name')">
                                        <i class="fas fa-trash-can" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Role Modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h3 class="modal-title h5 fw-bold text-dark" id="editRoleModalLabel">
                    <i class="fas fa-user-gear text-primary me-2" aria-hidden="true"></i>Edit User Permissions
                </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="editRoleForm">
                    <input type="hidden" id="editUserId" />
                    
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted mb-1" for="editUserName">User Name</label>
                        <input type="text" class="form-control rounded-3 bg-light" id="editUserName" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted mb-1" for="editRole">System Role</label>
                        <select class="form-select rounded-3" id="editRole" required>
                            <option value="User">Citizen (User)</option>
                            <option value="Technician">Field Technician</option>
                        </select>
                    </div>

                    <div class="mb-3" id="editDepartmentGroup">
                        <label class="form-label small fw-semibold text-muted mb-1" for="editDepartment">Assigned Department</label>
                        <select class="form-select rounded-3" id="editDepartment">
                            <option value="">No Department</option>
                        </select>
                        <small class="text-muted d-block mt-1 text-xs">Required when role is Technician for ticket dispatching.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold" onclick="saveRole()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Update Modal -->
<div class="modal fade" id="bulkUpdateModal" tabindex="-1" aria-labelledby="bulkUpdateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h3 class="modal-title h5 fw-bold text-dark" id="bulkUpdateModalLabel">
                    <i class="fas fa-users-gear text-primary me-2" aria-hidden="true"></i>Bulk Update Roles
                </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">You are updating permissions for <strong id="bulkSelectedCount" class="text-dark">0</strong> selected users.</p>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted mb-1" for="bulkRole">Target Role</label>
                    <select class="form-select rounded-3" id="bulkRole" required>
                        <option value="User">Citizen (User)</option>
                        <option value="Technician">Field Technician</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted mb-1" for="bulkDepartment">Target Department</label>
                    <select class="form-select rounded-3" id="bulkDepartment">
                        <option value="">No Department</option>
                    </select>
                </div>

                <div class="p-3 bg-light rounded-3 border" style="max-height: 150px; overflow-y: auto;">
                    <label class="detail-label d-block mb-1">Selected Users</label>
                    <div id="selectedUsersList" class="small text-muted">No users selected.</div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold" onclick="saveBulkUpdate()">Apply to Selected</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h3 class="modal-title h5 fw-bold text-danger" id="deleteModalLabel">
                    <i class="fas fa-triangle-exclamation me-2" aria-hidden="true"></i>Confirm Account Deletion
                </h3>
                <button type="button" class="btn-close" data-bs-dismiss="alert" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-dark mb-2">Are you sure you want to permanently delete user account <strong id="deleteUserName"></strong>?</p>
                <p class="text-muted small mb-0">Technicians with active complaint assignments cannot be deleted until tasks are reassigned.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold" onclick="confirmDelete()">Confirm Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let departments = [];
    let selectedUsers = [];
    let userToDelete = null;

    document.addEventListener('DOMContentLoaded', function () {
        loadDepartments();
    });

    function loadDepartments() {
        $.get('/Role/GetDepartments')
            .done(function (data) {
                departments = data;
                populateDepartmentSelect('#editDepartment');
                populateDepartmentSelect('#bulkDepartment');
            });
    }

    function populateDepartmentSelect(selector) {
        const select = $(selector);
        select.empty();
        select.append('<option value="">No Department</option>');
        departments.forEach(function (dept) {
            select.append(`<option value="${dept.departmentId}">${dept.name}</option>`);
        });
    }

    function editRole(userId, currentRole, currentDepartmentId) {
        const userRow = $(`tr[data-user-id="${userId}"]`);
        const userName = userRow.find('.user-name').text();

        $('#editUserId').val(userId);
        $('#editUserName').val(userName);
        $('#editRole').val(currentRole);
        $('#editDepartment').val(currentDepartmentId || '');

        $('#editRoleModal').modal('show');
    }

    function saveRole() {
        const userId = $('#editUserId').val();
        const role = $('#editRole').val();
        const departmentId = $('#editDepartment').val() || null;

        $.post('/Role/UpdateRole', {
            userId: userId,
            role: role,
            departmentId: departmentId
        }).done(function (response) {
            if (response.success) {
                if (window.showToast) window.showToast('Role updated successfully.', 'success');
                setTimeout(() => window.location.reload(), 600);
            } else {
                const msg = 'Error: ' + response.message;
                if (window.showToast) window.showToast(msg, 'error');
                else alert(msg);
            }
        });
    }

    function toggleAllCheckboxes() {
        const selectAll = $('#selectAll').is(':checked');
        $('.user-checkbox').prop('checked', selectAll);
        updateSelectedUsers();
    }

    function updateSelectAllState() {
        const totalCheckboxes = $('.user-checkbox').length;
        const checkedCheckboxes = $('.user-checkbox:checked').length;

        $('#selectAll').prop('checked', totalCheckboxes > 0 && totalCheckboxes === checkedCheckboxes);
        updateSelectedUsers();
    }

    function updateSelectedUsers() {
        selectedUsers = [];
        $('.user-checkbox:checked').each(function () {
            const userId = $(this).val();
            const userRow = $(this).closest('tr');
            const userName = userRow.find('.user-name').text();
            const userEmail = userRow.find('.user-email').text();
            selectedUsers.push({ id: userId, name: userName, email: userEmail });
        });

        $('#selectedCount').text(selectedUsers.length);
        $('#bulkSelectedCount').text(selectedUsers.length);
        updateSelectedUsersList();
    }

    function updateSelectedUsersList() {
        const list = $('#selectedUsersList');
        list.empty();

        if (selectedUsers.length === 0) {
            list.html('<p class="text-muted small mb-0">No users selected.</p>');
        } else {
            selectedUsers.forEach(function (user) {
                list.append(`
                    <div class="d-flex justify-content-between align-items-center mb-1 py-1 border-bottom">
                        <span class="text-truncate" style="max-width: 280px;"><strong>${user.name}</strong> (${user.email})</span>
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill" onclick="removeUser(${user.id})" aria-label="Deselect user ${user.name}">&times;</button>
                    </div>
                `);
            });
        }
    }

    function removeUser(userId) {
        $(`.user-checkbox[value="${userId}"]`).prop('checked', false);
        updateSelectAllState();
    }

    function showBulkUpdateModal() {
        if (selectedUsers.length === 0) {
            if (window.showToast) window.showToast('Please select at least one user from the list first.', 'warning');
            else alert('Please select at least one user from the list first.');
            return;
        }
        $('#bulkUpdateModal').modal('show');
    }

    function saveBulkUpdate() {
        if (selectedUsers.length === 0) return;

        const role = $('#bulkRole').val();
        const departmentId = $('#bulkDepartment').val() || null;
        const userIds = selectedUsers.map(u => parseInt(u.id));

        $.post('/Role/BulkUpdateRoles', {
            userIds: userIds,
            role: role,
            departmentId: departmentId
        }).done(function (response) {
            if (response.success) {
                if (window.showToast) window.showToast(response.message || 'Roles updated successfully.', 'success');
                setTimeout(() => window.location.reload(), 800);
            } else {
                const msg = 'Error: ' + response.message;
                if (window.showToast) window.showToast(msg, 'error');
                else alert(msg);
            }
        });
    }

    function deleteUser(userId, userName) {
        userToDelete = userId;
        $('#deleteUserName').text(userName);
        $('#deleteModal').modal('show');
    }

    function confirmDelete() {
        if (!userToDelete) return;

        $.post('/Role/DeleteUser', {
            userId: userToDelete
        }).done(function (response) {
            if (response.success) {
                if (window.showToast) window.showToast(response.message || 'User deleted successfully.', 'success');
                setTimeout(() => window.location.reload(), 800);
            } else {
                const msg = 'Error: ' + response.message;
                if (window.showToast) window.showToast(msg, 'error');
                else alert(msg);
            }
        });
    }
</script>
}
