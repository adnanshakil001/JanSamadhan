@{
    ViewData["Title"] = "Register - JanSamadhan";
    ViewData["HideDefaultNav"] = true;
    ViewData["FullWidth"] = true;
}

<div class="auth-page-root d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="auth-grid-bg"></div>

    <div class="container position-relative">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
                <div class="card auth-card border rounded-4 shadow-lg overflow-hidden bg-white">
                    <!-- Card Header -->
                    <div class="card-header bg-white text-center pt-4 pb-2 border-0">
                        <div class="mb-3 d-inline-flex align-items-center justify-content-center auth-icon-box mx-auto">
                            <i class="fas fa-city fs-2 text-dark"></i>
                        </div>
                        <h2 class="fw-bold text-dark mb-1 auth-brand-title">JanSamadhan</h2>
                        <p class="text-muted small mb-0">Citizen Account Registration</p>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-4 pt-2">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div><i class="fas fa-exclamation-circle me-1"></i> @err.ErrorMessage</div>
                                }
                            </div>
                        }

                        <form method="post" action="/Account/Register">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark small mb-1">Full Name</label>
                                <input class="form-control auth-input py-2 px-3" type="text" name="name" placeholder="e.g. Ramesh Kumar" required autofocus />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark small mb-1">Email Address</label>
                                <input class="form-control auth-input py-2 px-3" type="email" name="email" placeholder="user@domain.gov" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark small mb-1">Password</label>
                                <input class="form-control auth-input py-2 px-3" type="password" name="password" placeholder="••••••••" required />
                            </div>

                            <div class="mb-4 form-check">
                                <input type="checkbox" class="form-check-input" id="termsCheck" required checked>
                                <label class="form-check-label text-muted small" for="termsCheck">
                                    I agree to the Civic Portal Terms & Privacy
                                </label>
                            </div>

                            <button class="btn btn-dark w-100 py-2 fw-semibold rounded-3 d-flex align-items-center justify-content-center gap-2 auth-btn-submit" type="submit">
                                <i class="fas fa-arrow-right-to-bracket fs-6"></i> Create Account
                            </button>
                        </form>

                        <div class="text-center mt-4 pt-3 border-top">
                            <p class="text-muted small mb-2">
                                Already have an account? 
                                <a href="/Account/Login" class="text-dark fw-bold text-decoration-none hover-underline">Log In</a>
                            </p>
                            <div class="d-flex justify-content-center gap-3 small pt-1">
                                <a href="/Account/TechnicianLogin" class="text-secondary text-decoration-none"><i class="fas fa-tools me-1"></i>Technician</a>
                                <span class="text-muted">•</span>
                                <a href="/Account/AdminLogin" class="text-secondary text-decoration-none"><i class="fas fa-shield-alt me-1"></i>Admin</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Back to Home Link -->
                <div class="text-center mt-3">
                    <a href="/" class="text-secondary small text-decoration-none"><i class="fas fa-arrow-left me-1"></i> Back to Homepage</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.auth-page-root {
    background-color: #f8fafc;
    position: relative;
    overflow: hidden;
    font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
}

.auth-grid-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
        linear-gradient(to right, rgba(0, 0, 0, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.05) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
}

.auth-card {
    border: 1px solid #e2e8f0 !important;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.08) !important;
}

.auth-brand-title {
    letter-spacing: -0.02em;
}

.auth-input {
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.95rem;
    transition: all 0.2s;
}

.auth-input:focus {
    border-color: #0f172a;
    box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
}

.auth-btn-submit {
    background-color: #000000;
    border-color: #000000;
    letter-spacing: -0.01em;
    font-size: 1rem;
    transition: background-color 0.2s, transform 0.1s;
}

.auth-btn-submit:hover {
    background-color: #1e293b;
    border-color: #1e293b;
    transform: translateY(-1px);
}

.hover-underline:hover {
    text-decoration: underline !important;
}
</style>
