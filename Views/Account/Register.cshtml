@{
    ViewData["Title"] = "Register";
    ViewData["FullWidth"] = true;
}

<div class="auth-bg-grid">
    <div class="auth-card">
        <!-- Building Icon -->
        <div class="auth-icon-badge">
            <i class="fa-solid fa-user-plus"></i>
        </div>

        <!-- Title & Subtitle -->
        <div class="text-center mb-4">
            <h3 class="fw-bold mb-1 brand-font">JanSamadhan</h3>
            <p class="text-muted small mb-0">Citizen Account Registration</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small mb-3">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <!-- Registration Form -->
        <form method="post" action="/Account/Register">
            <div class="mb-3">
                <label class="form-label fw-semibold small text-secondary">Full Name</label>
                <input class="form-control form-control-modern" type="text" name="name" placeholder="e.g. Adnan Shakil" required autofocus />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small text-secondary">Email Address</label>
                <input class="form-control form-control-modern" type="email" name="email" placeholder="citizen@example.com" required />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold small text-secondary">Password</label>
                <input class="form-control form-control-modern" type="password" name="password" placeholder="••••••••" required />
                <small class="text-muted" style="font-size: 0.75rem;">Minimum 6 characters recommended</small>
            </div>

            <!-- Primary Black Submit Button -->
            <button class="auth-btn-primary mb-3" type="submit">
                <i class="fa-solid fa-user-check"></i>
                <span>Create Account</span>
            </button>
        </form>

        <div class="position-relative my-4">
            <hr class="text-muted opacity-25">
            <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 text-muted small">or</span>
        </div>

        <!-- Admin Access Button -->
        <div class="d-grid">
            <a href="/Account/AdminLogin" class="auth-btn-outline">
                <i class="fa-solid fa-shield-halved text-warning"></i>
                <span>Administrator Access Portal</span>
            </a>
        </div>

        <!-- Footer Link -->
        <div class="text-center mt-4 pt-2 border-top">
            <p class="small text-secondary mb-0">
                Already have an account? 
                <a href="/Account/Login" class="text-dark fw-bold text-decoration-none">Log In</a>
            </p>
        </div>
    </div>
</div>
