@{
    ViewData["Title"] = "Field Technician Portal — JanSamadhan";
    ViewData["HideDefaultNav"] = true;
    ViewData["FullWidth"] = true;
    var errorMessage = TempData["ErrorMessage"] as string;
    var hasModelErrors = !ViewData.ModelState.IsValid;
}

<div class="auth-page-root">
    <div class="auth-grid-bg" aria-hidden="true"></div>

    <div class="auth-container">
        <main class="auth-card" aria-labelledby="auth-title">
            <!-- Header -->
            <header class="auth-card__header">
                <div class="auth-brand-badge auth-brand-badge--amber" aria-hidden="true">
                    <i class="fas fa-tools"></i>
                </div>
                <h1 class="auth-brand-title" id="auth-title">JanSamadhan</h1>
                <p class="auth-brand-subtitle">Field Operations & Work Dispatch</p>
                <div class="auth-role-pill auth-role-pill--technician">
                    <i class="fas fa-wrench" aria-hidden="true"></i> Technician Access
                </div>
            </header>

            <!-- Role Segmented Tab Bar -->
            <nav class="auth-segmented-nav" aria-label="Portal Selection">
                <a href="/Account/Login" class="auth-segmented-link">Citizen</a>
                <a href="/Account/TechnicianLogin" class="auth-segmented-link active" aria-current="page">Technician</a>
                <a href="/Account/AdminLogin" class="auth-segmented-link">Admin</a>
            </nav>

            <!-- Form Body -->
            <div class="auth-card__body">
                @if (!string.IsNullOrEmpty(errorMessage) || hasModelErrors)
                {
                    <div class="auth-alert" role="alert" aria-live="assertive">
                        <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
                        <div>
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div>@errorMessage</div>
                            }
                            @if (hasModelErrors)
                            {
                                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div>@err.ErrorMessage</div>
                                }
                            }
                        </div>
                    </div>
                }

                <form method="post" action="/Account/TechnicianLogin" autocomplete="on" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="auth-form-group">
                        <label class="auth-label" for="tech-email">Technician Email</label>
                        <div class="auth-input-wrapper">
                            <i class="fas fa-envelope auth-input-icon" aria-hidden="true"></i>
                            <input class="auth-input" 
                                   type="email" 
                                   id="tech-email" 
                                   name="email" 
                                   placeholder="tech@domain.gov" 
                                   autocomplete="email" 
                                   required 
                                   autofocus />
                        </div>
                    </div>

                    <div class="auth-form-group">
                        <label class="auth-label" for="tech-password">Password</label>
                        <div class="auth-input-wrapper">
                            <i class="fas fa-lock auth-input-icon" aria-hidden="true"></i>
                            <input class="auth-input" 
                                   type="password" 
                                   id="tech-password" 
                                   name="password" 
                                   placeholder="••••••••" 
                                   autocomplete="current-password" 
                                   required />
                            <button type="button" 
                                    class="auth-password-toggle" 
                                    aria-label="Toggle password visibility" 
                                    data-target="tech-password">
                                <i class="fas fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="auth-submit-btn mt-3">
                        <span>Access Field Dashboard</span>
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </button>
                </form>
            </div>

            <!-- Card Footer -->
            <footer class="auth-card__footer">
                <span>Citizen reporting? </span>
                <a href="/Account/Login" class="auth-link fw-semibold">Citizen Sign In</a>
            </footer>
        </main>

        <!-- Back to Home -->
        <div class="text-center">
            <a href="/" class="auth-back-link">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                <span>Back to Homepage</span>
            </a>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.querySelectorAll('.auth-password-toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var targetId = this.getAttribute('data-target');
                var input = document.getElementById(targetId);
                var icon = this.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                    this.setAttribute('aria-label', 'Hide password');
                } else {
                    input.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                    this.setAttribute('aria-label', 'Show password');
                }
            });
        });
    </script>
}
