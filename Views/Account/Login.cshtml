@{
    ViewData["Title"] = "Login";
    ViewData["FullWidth"] = true;
}

<div class="auth-bg-grid">
    <div class="auth-card">
        <!-- Building Icon (Mockup 1) -->
        <div class="auth-icon-badge">
            <i class="fa-solid fa-city"></i>
        </div>

        <!-- Title & Subtitle -->
        <div class="text-center mb-4">
            <h3 class="fw-bold mb-1 brand-font">JanSamadhan</h3>
            <p class="text-muted small mb-0">System Access Authentication</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small mb-3">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <!-- Login Form -->
        <form method="post" action="/Account/Login">
            <div class="mb-3">
                <label class="form-label fw-semibold small text-secondary">Email Address</label>
                <input class="form-control form-control-modern" type="email" name="email" placeholder="user@domain.gov" required autofocus />
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label fw-semibold small text-secondary mb-0">Password</label>
                    <a href="#" class="small text-decoration-none fw-semibold text-primary" onclick="alert('Please contact your municipal system administrator to reset your credentials.'); return false;">Forgot Password?</a>
                </div>
                <input class="form-control form-control-modern" type="password" name="password" placeholder="••••••••" required />
            </div>

            <div class="mb-4 form-check">
                <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" value="true">
                <label class="form-check-label small text-secondary" for="rememberMe">Remember Me</label>
            </div>

            <!-- Primary Black Submit Button (Mockup 1) -->
            <button class="auth-btn-primary mb-3" type="submit">
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
                <span>Log In</span>
            </button>
        </form>

        <div class="position-relative my-4">
            <hr class="text-muted opacity-25">
            <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 text-muted small">or access portals</span>
        </div>

        <!-- Dedicated Login as Admin & Technician Buttons -->
        <div class="d-grid gap-2">
            <a href="/Account/AdminLogin" class="auth-btn-outline">
                <i class="fa-solid fa-shield-halved text-warning"></i>
                <span>Login as Administrator</span>
            </a>
            <a href="/Account/TechnicianLogin" class="auth-btn-outline">
                <i class="fa-solid fa-helmet-safety text-info"></i>
                <span>Technician Portal Login</span>
            </a>
        </div>

        <!-- Footer Link -->
        <div class="text-center mt-4 pt-2 border-top">
            <p class="small text-secondary mb-0">
                Don't have an account? 
                <a href="/Account/Register" class="text-dark fw-bold text-decoration-none">Sign Up</a>
            </p>
        </div>
    </div>
</div>
