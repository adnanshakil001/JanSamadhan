@model JanSamadhan.Models.Complaint
@{
    ViewData["Title"] = "Complaint Details - Technician";
    var hasWorkPhoto = Model.TechnicianPhotos.Any(p => p.PhotoType == "WorkInProgress");
    var hasFixedPhoto = Model.TechnicianPhotos.Any(p => p.PhotoType == "Fixed");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Complaint #@Model.ComplaintId</h2>
        <span class="badge status-badge @(Model.Status.ToString().ToLower()) fs-6">Status: @Model.Status</span>
    </div>
    <div>
        <a href="/Technician/Dashboard" class="btn btn-outline-primary">Back to Dashboard</a>
        <a href="/Account/Logout" class="btn btn-outline-danger">Logout</a>
    </div>
</div>

<div class="row">
    <div class="col-md-7">
        <!-- Complaint Information Card -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Complaint Information</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <p><strong>Problem Type:</strong> <span class="badge bg-secondary">@Model.ProblemType</span></p>
                        <p><strong>Description:</strong> @(Model.Description ?? "No description provided")</p>
                        <p><strong>Location:</strong> @Model.Address</p>
                        <p><strong>Coordinates:</strong> @Model.Latitude, @Model.Longitude</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Reported By:</strong> @Model.User?.Name</p>
                        <p><strong>Created:</strong> @Model.CreatedAt.ToLocalTime().ToString("g")</p>
                        <p><strong>Last Updated:</strong> @Model.UpdatedAt?.ToLocalTime().ToString("g")</p>
                        <p><strong>Department:</strong> @Model.Department?.Name</p>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <div class="mt-3 border-top pt-3">
                        <h6>Original Citizen Photo:</h6>
                        <img src="@Model.PhotoPath" class="img-fluid rounded border shadow-sm" style="max-height: 250px;" alt="Complaint Photo">
                    </div>
                }
            </div>
        </div>

        <!-- 1. Work in Progress Section -->
        <div class="card mb-4 border-warning">
            <div class="card-header bg-warning bg-opacity-25 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-dark"><i class="fas fa-tools me-2"></i>Step 1: Start Work (Work in Progress)</h5>
                @if (hasWorkPhoto)
                {
                    <span class="badge bg-success">✓ Work Photo Uploaded</span>
                }
            </div>
            <div class="card-body">
                <p class="text-muted small">Upload a photo showing technicians on-site actively working on the issue. This immediately updates the complaint status to <strong>In Progress</strong> for the citizen and admin.</p>
                
                <form id="workInProgressForm" enctype="multipart/form-data">
                    <input type="hidden" name="complaintId" value="@Model.ComplaintId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Work in Progress Photo</label>
                        <input type="file" class="form-control" name="workInProgressPhoto" id="workInProgressPhotoInput" accept="image/*" required />
                    </div>
                    <button type="submit" class="btn btn-warning fw-bold text-dark" id="btnUploadWork">
                        <i class="fas fa-upload me-1"></i> Upload & Mark In Progress
                    </button>
                </form>
            </div>
        </div>

        <!-- 2. Fixed / Resolution Section -->
        <div class="card mb-4 border-success">
            <div class="card-header bg-success bg-opacity-25 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-dark"><i class="fas fa-check-circle me-2"></i>Step 2: Complete Work (Fixed)</h5>
                @if (hasFixedPhoto)
                {
                    <span class="badge bg-success">✓ Fixed Photo Uploaded</span>
                }
            </div>
            <div class="card-body">
                <p class="text-muted small">Upload a photo showing the finished and resolved issue. This marks the complaint as <strong>Fixed</strong>, opens citizen rating, and awards you <strong>+10 Points</strong>!</p>
                
                <form id="fixedForm" enctype="multipart/form-data">
                    <input type="hidden" name="complaintId" value="@Model.ComplaintId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Fixed / Completed Photo</label>
                        <input type="file" class="form-control" name="fixedPhoto" id="fixedPhotoInput" accept="image/*" required />
                    </div>
                    <button type="submit" class="btn btn-success fw-bold" id="btnUploadFixed">
                        <i class="fas fa-check-double me-1"></i> Upload & Mark as Fixed (+10 Pts)
                    </button>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Right Sidebar: Photo Proof Gallery -->
    <div class="col-md-5">
        <div class="card shadow-sm sticky-top" style="top: 20px;">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Uploaded Technician Proofs</h5>
            </div>
            <div class="card-body">
                @if (!Model.TechnicianPhotos.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-camera fa-3x mb-2 opacity-50"></i>
                        <p>No technician photos uploaded yet.<br>Upload a photo from the left to start.</p>
                    </div>
                }
                else
                {
                    @foreach (var photo in Model.TechnicianPhotos.OrderBy(p => p.UploadedAt))
                    {
                        <div class="card mb-3 border">
                            <div class="card-header py-1 d-flex justify-content-between align-items-center bg-light">
                                <span class="badge @(photo.PhotoType == "WorkInProgress" ? "bg-warning text-dark" : "bg-success")">
                                    @(photo.PhotoType == "WorkInProgress" ? "Work In Progress" : "Fixed / Completed")
                                </span>
                                <small class="text-muted">@photo.UploadedAt.ToLocalTime().ToString("MMM dd, h:mm tt")</small>
                            </div>
                            <div class="card-body p-2 text-center">
                                <img src="@photo.PhotoPath" class="img-fluid rounded border" style="max-height: 200px;" alt="@photo.PhotoType Photo">
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        // Form 1: Work In Progress Upload
        $('#workInProgressForm').on('submit', function(e) {
            e.preventDefault();
            const file = $('#workInProgressPhotoInput')[0].files[0];
            if (!file) {
                alert('Please select a Work in Progress photo first.');
                return;
            }

            const formData = new FormData();
            formData.append('complaintId', '@Model.ComplaintId');
            formData.append('workInProgressPhoto', file);

            $('#btnUploadWork').prop('disabled', true).text('Uploading...');

            $.ajax({
                url: '/Technician/UploadPhotos',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert('Error: ' + res.message);
                        $('#btnUploadWork').prop('disabled', false).html('<i class="fas fa-upload me-1"></i> Upload & Mark In Progress');
                    }
                },
                error: function() {
                    alert('Server error uploading photo. Please try again.');
                    $('#btnUploadWork').prop('disabled', false).html('<i class="fas fa-upload me-1"></i> Upload & Mark In Progress');
                }
            });
        });

        // Form 2: Fixed Issue Upload
        $('#fixedForm').on('submit', function(e) {
            e.preventDefault();
            const file = $('#fixedPhotoInput')[0].files[0];
            if (!file) {
                alert('Please select a Fixed resolution photo first.');
                return;
            }

            const formData = new FormData();
            formData.append('complaintId', '@Model.ComplaintId');
            formData.append('fixedPhoto', file);

            $('#btnUploadFixed').prop('disabled', true).text('Uploading & Completing...');

            $.ajax({
                url: '/Technician/UploadPhotos',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert('Error: ' + res.message);
                        $('#btnUploadFixed').prop('disabled', false).html('<i class="fas fa-check-double me-1"></i> Upload & Mark as Fixed (+10 Pts)');
                    }
                },
                error: function() {
                    alert('Server error uploading photo. Please try again.');
                    $('#btnUploadFixed').prop('disabled', false).html('<i class="fas fa-check-double me-1"></i> Upload & Mark as Fixed (+10 Pts)');
                }
            });
        });
    });
</script>

<style>
.status-badge.pending { background-color: #dc3545; color: white; }
.status-badge.inprogress { background-color: #fd7e14; color: white; }
.status-badge.fixed { background-color: #28a745; color: white; }
</style>
}
