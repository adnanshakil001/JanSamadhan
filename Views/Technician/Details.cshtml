@model JanSamadhan.Models.Complaint
@{
    ViewData["Title"] = $"Task #{Model.ComplaintId} Resolution - JanSamadhan";

    var workPhoto = Model.TechnicianPhotos?.FirstOrDefault(p => p.PhotoType == "WorkInProgress");
    var fixedPhoto = Model.TechnicianPhotos?.FirstOrDefault(p => p.PhotoType == "Fixed");
    var hasWorkPhoto = workPhoto != null;
    var hasFixedPhoto = fixedPhoto != null;

    var isFixed = Model.Status == JanSamadhan.Models.ComplaintStatus.Fixed;
    var isInProgress = Model.Status == JanSamadhan.Models.ComplaintStatus.InProgress;
    var statusKey = isFixed ? "fixed" : (isInProgress ? "inprogress" : "pending");
    var statusClass = isFixed ? "status-pill--fixed" : (isInProgress ? "status-pill--inprogress" : "status-pill--pending");

    // Stepper State Logic (Matching Citizen Details)
    var step2Complete = Model.Department != null || Model.DepartmentId != null || isInProgress || isFixed;
    var step3Complete = isFixed || hasWorkPhoto;
    var step3Active = isInProgress && !hasWorkPhoto;
    var step4Complete = isFixed;

    string techName = ViewBag.TechnicianName as string ?? "Field Operator";
    string deptName = ViewBag.DepartmentName as string ?? (Model.Department?.Name ?? "Municipal Services");
    int points = ViewBag.Points as int? ?? 0;
    string badgeLevel = ViewBag.BadgeLevel as string ?? "Bronze";
}

@section Styles {
    <link rel="stylesheet" href="~/css/complaints.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/complaint-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/technician-field.css" asp-append-version="true" />
}

<!-- Page Header & Actions -->
<div class="details-page-header">
    <div>
        <nav class="details-breadcrumbs" aria-label="Breadcrumb">
            <a href="/Technician/Dashboard"><i class="fas fa-arrow-left me-1" aria-hidden="true"></i>Tasks</a>
            <span aria-hidden="true">&sol;</span>
            <span class="text-dark fw-semibold" aria-current="page">Task #JS-@Model.ComplaintId</span>
        </nav>
        <div class="details-title-row">
            <h1 class="details-title">Task #JS-@Model.ComplaintId: @Model.ProblemType</h1>
            <span class="status-pill @statusClass fs-6">
                @(Model.Status == JanSamadhan.Models.ComplaintStatus.InProgress ? "In Progress" : Model.Status.ToString())
            </span>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a href="https://www.google.com/maps/search/?api=1&query=@Model.Latitude,@Model.Longitude" 
           target="_blank" rel="noopener noreferrer" 
           class="btn btn-outline-secondary rounded-pill px-3 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" 
           aria-label="Navigate to coordinates in Google Maps">
            <i class="fas fa-location-arrow text-primary" aria-hidden="true"></i>
            <span>Navigate</span>
        </a>
        <span class="badge bg-warning bg-opacity-25 text-dark border border-warning rounded-pill px-3 py-2 fw-bold">
            <i class="fas fa-award text-warning me-1" aria-hidden="true"></i>@points Pts &middot; @badgeLevel
        </span>
    </div>
</div>

<!-- 1. 4-Stage Horizontal Resolution Stepper (Unified with Citizen Details) -->
<section class="stepper-card" aria-label="Resolution Lifecycle Progress">
    <div class="stepper-track">
        <!-- Step 1: Reported -->
        <div class="stepper-step is-complete">
            <div class="stepper-node" aria-hidden="true">
                <i class="fas fa-check"></i>
            </div>
            <span class="stepper-label">1. Reported</span>
            <span class="stepper-sublabel">@Model.CreatedAt.ToLocalTime().ToString("MMM dd")</span>
        </div>

        <!-- Step 2: Routed to Dept -->
        <div class="stepper-step @(step2Complete ? "is-complete" : "")">
            <div class="stepper-node" aria-hidden="true">
                @if (step2Complete)
                {
                    <i class="fas fa-check"></i>
                }
                else
                {
                    <span>2</span>
                }
            </div>
            <span class="stepper-label">2. Routed</span>
            <span class="stepper-sublabel">@deptName</span>
        </div>

        <!-- Step 3: On-Site Inspection -->
        <div class="stepper-step @(step3Complete ? "is-complete" : (step3Active ? "is-active" : ""))">
            <div class="stepper-node" aria-hidden="true">
                @if (step3Complete)
                {
                    <i class="fas fa-check"></i>
                }
                else if (step3Active)
                {
                    <i class="fas fa-tools"></i>
                }
                else
                {
                    <span>3</span>
                }
            </div>
            <span class="stepper-label">3. In Field</span>
            <span class="stepper-sublabel">@(hasWorkPhoto ? "Photo Verified" : "Active")</span>
        </div>

        <!-- Step 4: Resolution & Verification -->
        <div class="stepper-step @(step4Complete ? "is-complete" : "")">
            <div class="stepper-node" aria-hidden="true">
                @if (step4Complete)
                {
                    <i class="fas fa-check"></i>
                }
                else
                {
                    <span>4</span>
                }
            </div>
            <span class="stepper-label">4. Resolved</span>
            <span class="stepper-sublabel">@(isFixed ? "Closed & Proofed" : "Pending")</span>
        </div>
    </div>
</section>

<!-- Feedback Alert Banner -->
<div id="screenAlert" class="alert d-none alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
    <span id="screenAlertText"></span>
    <button type="button" class="btn-close" onclick="$('#screenAlert').addClass('d-none')" aria-label="Close"></button>
</div>

<!-- 2. Photographic Verification Dossier -->
<section class="mb-5" aria-label="Before and After Proof Gallery">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="h5 fw-bold text-dark mb-0">Photographic Verification Dossier</h2>
            <span class="text-muted small">Compare citizen reported defect against verified on-site field resolution</span>
        </div>
        <span class="text-muted small"><i class="fas fa-magnifying-glass me-1"></i>Tap any photo to zoom</span>
    </div>

    <div class="comparison-grid">
        <!-- Stage 1: Before (Citizen Upload) -->
        <div class="comparison-card">
            <div class="comparison-card__header">
                <span class="badge bg-dark text-white rounded-pill text-xs">1. Before (Reported)</span>
                <span class="text-muted text-xs">@Model.CreatedAt.ToLocalTime().ToString("MMM dd")</span>
            </div>
            <div class="comparison-card__body" onclick="openLightbox('@(Model.PhotoPath ?? "")', 'Citizen Reported Issue')">
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath" alt="Original citizen issue photo" loading="lazy" />
                    <span class="comparison-zoom-hint"><i class="fas fa-magnifying-glass-plus"></i> Zoom</span>
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted p-4 text-center">
                        <i class="fas fa-camera fa-2x mb-2 opacity-50"></i>
                        <span class="small">No citizen photo attached</span>
                    </div>
                }
            </div>
        </div>

        <!-- Stage 2: In-Progress (Technician Active Work) -->
        <div class="comparison-card">
            <div class="comparison-card__header">
                <span class="badge bg-warning text-dark rounded-pill text-xs">2. In Progress (Active)</span>
                <span class="text-muted text-xs">@(hasWorkPhoto ? workPhoto!.UploadedAt.ToLocalTime().ToString("MMM dd") : "Pending")</span>
            </div>
            <div class="comparison-card__body" onclick="openLightbox('@(workPhoto?.PhotoPath ?? "")', 'Work In Progress Field Photo')">
                @if (hasWorkPhoto)
                {
                    <img src="@workPhoto!.PhotoPath" alt="Work in progress proof photo" loading="lazy" />
                    <span class="comparison-zoom-hint"><i class="fas fa-magnifying-glass-plus"></i> Zoom</span>
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted p-4 text-center">
                        <i class="fas fa-tools fa-2x mb-2 opacity-50"></i>
                        <span class="small">Upload step 1 proof below</span>
                    </div>
                }
            </div>
        </div>

        <!-- Stage 3: After (Fixed Resolution) -->
        <div class="comparison-card">
            <div class="comparison-card__header">
                <span class="badge bg-success text-white rounded-pill text-xs">3. After (Fixed &amp; Resolved)</span>
                <span class="text-muted text-xs">@(hasFixedPhoto ? fixedPhoto!.UploadedAt.ToLocalTime().ToString("MMM dd") : "Pending")</span>
            </div>
            <div class="comparison-card__body" onclick="openLightbox('@(fixedPhoto?.PhotoPath ?? "")', 'Fixed Resolution Photo')">
                @if (hasFixedPhoto)
                {
                    <img src="@fixedPhoto!.PhotoPath" alt="Fixed resolution proof photo" loading="lazy" />
                    <span class="comparison-zoom-hint"><i class="fas fa-magnifying-glass-plus"></i> Zoom</span>
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted p-4 text-center">
                        <i class="fas fa-circle-check fa-2x mb-2 opacity-50"></i>
                        <span class="small">Upload step 2 resolution below</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- 3. Dual Column: Incident Dossier & Proof-of-Work Actions -->
<div class="row g-4 mb-5">
    <!-- Left: Incident Information Dossier -->
    <div class="col-lg-5">
        <div class="card border rounded-4 shadow-sm bg-white p-4 mb-4">
            <h2 class="h6 fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-file-lines text-primary" aria-hidden="true"></i>
                <span>Incident Dossier</span>
            </h2>

            <div class="mb-3">
                <span class="text-muted text-xs fw-bold text-uppercase d-block mb-1">Location Details</span>
                <p class="fw-semibold text-dark mb-1">
                    <i class="fas fa-location-dot text-danger me-1"></i>
                    @(string.IsNullOrWhiteSpace(Model.Address) ? "Geo-coordinates logged" : Model.Address)
                </p>
                <div class="d-flex align-items-center justify-content-between pt-1">
                    <small class="font-monospace text-muted">@Model.Latitude.ToString("F5"), @Model.Longitude.ToString("F5")</small>
                    <a href="https://www.google.com/maps/search/?api=1&query=@Model.Latitude,@Model.Longitude" 
                       target="_blank" rel="noopener noreferrer" class="small text-primary text-decoration-none fw-semibold">
                        View Map &rarr;
                    </a>
                </div>
            </div>

            <div class="mb-3">
                <span class="text-muted text-xs fw-bold text-uppercase d-block mb-1">Citizen Statement</span>
                <div class="p-3 bg-light rounded-3 text-dark small" style="white-space: pre-wrap; overflow-wrap: anywhere;">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No detailed description entered." : Model.Description)
                </div>
            </div>

            <div class="border-top pt-3 d-flex justify-content-between align-items-center text-muted small">
                <span>Citizen: <strong class="text-dark">@(Model.User?.Name ?? "Anonymous")</strong></span>
                <span>Logged: @Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
            </div>
        </div>
    </div>

    <!-- Right: Mobile Camera Proof-of-Work Action Steps -->
    <div class="col-lg-7">
        <!-- Step 1: Work In Progress Upload Card -->
        <div class="card border rounded-4 shadow-sm bg-white mb-4 overflow-hidden">
            <div class="card-header bg-warning bg-opacity-10 border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0 text-dark fw-bold">
                    <i class="fas fa-tools text-warning me-2" aria-hidden="true"></i>Step 1: On-Site Inspection Proof
                </h2>
                @if (hasWorkPhoto)
                {
                    <span class="badge bg-success rounded-pill px-3 py-1">
                        <i class="fas fa-check me-1"></i> Verified
                    </span>
                }
            </div>
            <div class="card-body p-4">
                @if (hasWorkPhoto)
                {
                    <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 mb-3 d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                            <i class="fas fa-check"></i>
                        </div>
                        <div>
                            <strong class="text-dark d-block">On-Site Attendance Confirmed</strong>
                            <small class="text-muted">Proof photo logged on @workPhoto!.UploadedAt.ToLocalTime().ToString("MMM dd, hh:mm tt")</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ms-auto" onclick="$('#workInProgressUploadZone').slideToggle(200)">
                            Update Photo
                        </button>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">Snap a photo with your mobile camera on site. This records your attendance and updates the ticket to <strong>In Progress</strong>.</p>
                }

                <div id="workInProgressUploadZone" style="@(hasWorkPhoto ? "display: none;" : "")">
                    <form id="workInProgressForm" enctype="multipart/form-data">
                        <input type="hidden" name="complaintId" value="@Model.ComplaintId" />

                        <!-- Mobile Direct Camera Zone -->
                        <label class="camera-upload-card" for="workInProgressPhotoInput">
                            <div class="camera-icon-badge">
                                <i class="fas fa-camera"></i>
                            </div>
                            <span class="fw-bold text-dark d-block mb-1">Tap to Open Mobile Camera</span>
                            <span class="text-muted small d-block">Snap live field photo or choose image</span>
                            <input type="file" id="workInProgressPhotoInput" name="workInProgressPhoto" class="camera-upload-input" accept="image/*" capture="environment" required />
                            <img id="workPreviewImg" class="camera-preview-thumb" alt="Work in progress preview" />
                        </label>

                        <button type="submit" class="dashboard-action-btn w-100 justify-content-center py-3" id="btnUploadWork" style="min-height: 48px;">
                            <i class="fas fa-cloud-arrow-up"></i>
                            <span>Submit &amp; Mark In Progress</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Step 2: Fixed / Completion Upload Card -->
        <div class="card border rounded-4 shadow-sm bg-white mb-4 overflow-hidden">
            <div class="card-header bg-success bg-opacity-10 border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0 text-dark fw-bold">
                    <i class="fas fa-circle-check text-success me-2" aria-hidden="true"></i>Step 2: Completed Resolution Proof
                </h2>
                @if (isFixed || hasFixedPhoto)
                {
                    <span class="badge bg-success rounded-pill px-3 py-1">
                        <i class="fas fa-check me-1"></i> Resolved (+10 Pts)
                    </span>
                }
            </div>
            <div class="card-body p-4">
                @if (isFixed || hasFixedPhoto)
                {
                    <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 mb-3 d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                            <i class="fas fa-award"></i>
                        </div>
                        <div>
                            <strong class="text-dark d-block">Resolution Verified &amp; Signed Off</strong>
                            <small class="text-muted">Final repair photo logged &middot; +10 points awarded to your rank</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ms-auto" onclick="$('#fixedUploadZone').slideToggle(200)">
                            Update Photo
                        </button>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">Snap the repaired defect photo. This closes the grievance, notifies the citizen, and awards you <strong>+10 Gamification Points</strong>!</p>
                }

                <div id="fixedUploadZone" style="@(isFixed || hasFixedPhoto ? "display: none;" : "")">
                    <form id="fixedForm" enctype="multipart/form-data">
                        <input type="hidden" name="complaintId" value="@Model.ComplaintId" />

                        <!-- Mobile Direct Camera Zone -->
                        <label class="camera-upload-card" for="fixedPhotoInput">
                            <div class="camera-icon-badge" style="background: var(--status-fixed-bg); color: var(--status-fixed-strong);">
                                <i class="fas fa-circle-check"></i>
                            </div>
                            <span class="fw-bold text-dark d-block mb-1">Snap Finished Repair Photo</span>
                            <span class="text-muted small d-block">Direct camera capture for completion sign-off</span>
                            <input type="file" id="fixedPhotoInput" name="fixedPhoto" class="camera-upload-input" accept="image/*" capture="environment" required />
                            <img id="fixedPreviewImg" class="camera-preview-thumb" alt="Fixed repair preview" />
                        </label>

                        <button type="submit" class="btn btn-success w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" id="btnUploadFixed" style="min-height: 48px;">
                            <i class="fas fa-award"></i>
                            <span>Complete Work &amp; Earn +10 Points</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lightbox Modal for Photo Inspection -->
<div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-0 rounded-4 overflow-hidden">
            <div class="modal-header border-0 pb-0 justify-content-between">
                <span class="text-white small fw-semibold" id="lightboxTitle">Inspection Photo</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 text-center">
                <img src="" id="lightboxImg" class="img-fluid rounded-3" style="max-height: 75vh; object-fit: contain;" alt="Full-resolution photo" />
            </div>
        </div>
    </div>
</div>

<!-- On-Screen Success Modal -->
<div class="modal fade" id="onScreenSuccessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden text-center p-4">
            <div class="modal-body p-0">
                <div class="mb-3">
                    <div id="modalIconContainer" class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 72px; height: 72px; background: rgba(5, 150, 105, 0.1);">
                        <i id="modalIcon" class="fas fa-check-circle fa-3x text-success"></i>
                    </div>
                </div>

                <h3 id="modalTitle" class="fw-bold text-dark mb-2">Resolution Logged</h3>
                <p id="modalMessage" class="text-muted mb-4 px-2">Work proof recorded successfully.</p>

                <div id="modalPointsBadge" class="mb-4 d-none">
                    <span class="badge bg-warning bg-opacity-25 text-dark rounded-pill px-3 py-2 fw-bold fs-6 border border-warning">
                        <i class="fas fa-star text-warning me-1"></i> +10 Points Added to Leaderboard!
                    </span>
                </div>

                <button type="button" class="btn btn-dark w-100 py-3 rounded-pill fw-bold shadow-sm" onclick="location.reload()" style="min-height: 44px;">
                    Continue
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 1. Lightbox Inspection
    function openLightbox(url, title) {
        if (!url) return;
        $('#lightboxImg').attr('src', url);
        $('#lightboxTitle').text(title || 'Field Photo');
        const modal = new bootstrap.Modal(document.getElementById('lightboxModal'));
        modal.show();
    }

    // 2. Inline Feedback Modal
    function showOnScreenModal(title, message, isFixed) {
        $('#modalTitle').text(title);
        $('#modalMessage').text(message);

        if (isFixed) {
            $('#modalIconContainer').css('background', 'rgba(5, 150, 105, 0.15)');
            $('#modalIcon').attr('class', 'fas fa-award fa-3x text-success');
            $('#modalPointsBadge').removeClass('d-none');
        } else {
            $('#modalIconContainer').css('background', 'rgba(217, 119, 6, 0.15)');
            $('#modalIcon').attr('class', 'fas fa-tools fa-3x text-warning');
            $('#modalPointsBadge').addClass('d-none');
        }

        const modal = new bootstrap.Modal(document.getElementById('onScreenSuccessModal'), {
            backdrop: 'static'
        });
        modal.show();
    }

    function showInlineError(message) {
        $('#screenAlertText').html('<i class="fas fa-exclamation-triangle me-2"></i>' + message);
        $('#screenAlert').removeClass('d-none alert-success').addClass('alert-danger');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // 3. Instant Live Image Preview on Mobile Capture
    function handleImagePreview(input, imgElement) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                $(imgElement).attr('src', e.target.result).show();
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    $(document).ready(function () {
        $('#workInProgressPhotoInput').on('change', function () {
            handleImagePreview(this, '#workPreviewImg');
        });

        $('#fixedPhotoInput').on('change', function () {
            handleImagePreview(this, '#fixedPreviewImg');
        });

        // Form 1: Work In Progress Upload
        $('#workInProgressForm').on('submit', function (e) {
            e.preventDefault();
            const file = $('#workInProgressPhotoInput')[0].files[0];
            if (!file) {
                showInlineError('Please snap or select an In-Progress photo first.');
                return;
            }

            const formData = new FormData();
            formData.append('complaintId', '@Model.ComplaintId');
            formData.append('workInProgressPhoto', file);

            const btn = $('#btnUploadWork');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Uploading Proof...');

            $.ajax({
                url: '/Technician/UploadPhotos',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        showOnScreenModal('Work Marked In Progress!', res.message || 'On-site photo uploaded successfully.', false);
                    } else {
                        showInlineError(res.message);
                        btn.prop('disabled', false).html('<i class="fas fa-cloud-arrow-up"></i> <span>Submit &amp; Mark In Progress</span>');
                    }
                },
                error: function () {
                    showInlineError('Server error uploading photo. Please try again.');
                    btn.prop('disabled', false).html('<i class="fas fa-cloud-arrow-up"></i> <span>Submit &amp; Mark In Progress</span>');
                }
            });
        });

        // Form 2: Fixed Issue Upload
        $('#fixedForm').on('submit', function (e) {
            e.preventDefault();
            const file = $('#fixedPhotoInput')[0].files[0];
            if (!file) {
                showInlineError('Please snap or select a Fixed resolution photo first.');
                return;
            }

            const formData = new FormData();
            formData.append('complaintId', '@Model.ComplaintId');
            formData.append('fixedPhoto', file);

            const btn = $('#btnUploadFixed');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Uploading Resolution...');

            $.ajax({
                url: '/Technician/UploadPhotos',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        showOnScreenModal('Grievance Resolved &amp; Fixed!', res.message || 'Work marked as Fixed with completion photo! You earned 10 points.', true);
                    } else {
                        showInlineError(res.message);
                        btn.prop('disabled', false).html('<i class="fas fa-award"></i> <span>Complete Work &amp; Earn +10 Points</span>');
                    }
                },
                error: function () {
                    showInlineError('Server error uploading photo. Please try again.');
                    btn.prop('disabled', false).html('<i class="fas fa-award"></i> <span>Complete Work &amp; Earn +10 Points</span>');
                }
            });
        });
    });
</script>
}
