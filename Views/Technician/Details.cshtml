@model JanSamadhan.Models.Complaint
@{
    ViewData["Title"] = "Task Details #" + Model.ComplaintId + " - Technician";
    ViewData["HideDefaultNav"] = true;
    ViewData["FullWidth"] = true;
    var hasWorkPhoto = Model.TechnicianPhotos.Any(p => p.PhotoType == "WorkInProgress");
    var hasFixedPhoto = Model.TechnicianPhotos.Any(p => p.PhotoType == "Fixed");
    var isAssignedToMe = ViewBag.IsAssignedToMe as bool? ?? false;
}

<div class="d-flex min-vh-100 bg-light technician-dashboard-root">
    <!-- Left Sidebar -->
    <aside class="technician-sidebar bg-white border-end d-flex flex-column justify-content-between p-3" style="width: 260px; min-width: 260px;">
        <div>
            <!-- Brand Logo -->
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none text-dark fw-bold fs-4 mb-4 px-2">
                <i class="fas fa-tools text-primary"></i>
                <span>JanSamadhan</span>
            </a>

            <!-- Navigation Links -->
            <nav class="nav flex-column gap-1">
                <a href="/Technician/Dashboard" class="sidebar-link active">
                    <i class="fas fa-tasks me-3"></i> Assigned Tasks
                </a>
                <a href="/Technician/AvailableWork" class="sidebar-link">
                    <i class="fas fa-inbox me-3"></i> Available Work Pool
                </a>
                <a href="/Technician/Scoreboard" class="sidebar-link">
                    <i class="fas fa-medal me-3"></i> Technician Board
                </a>
            </nav>
        </div>

        <!-- Sidebar Footer Action -->
        <div class="pt-3 border-top">
            <div class="p-2 bg-light rounded-3 mb-3 border">
                <small class="text-muted d-block">Department</small>
                <strong class="text-dark small"><i class="fas fa-building text-primary me-1"></i>@ViewBag.DepartmentName</strong>
            </div>
            <div class="d-flex align-items-center justify-content-between px-2 text-muted small">
                <a href="/Account/Profile" class="text-secondary text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-user"></i> Profile
                </a>
                <a href="/Account/Logout" class="text-danger text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content Panel -->
    <div class="flex-grow-1 d-flex flex-column overflow-auto">
        <!-- Top Header Navigation Bar -->
        <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center sticky-top">
            <div class="d-flex align-items-center gap-3">
                <a href="/Technician/Dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Back to Dashboard</a>
                <span class="text-muted">/</span>
                <span class="fw-semibold text-dark">Task #@Model.ComplaintId</span>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 px-3 py-1 bg-warning bg-opacity-10 border border-warning border-opacity-50 rounded-pill">
                    <i class="fas fa-award text-warning"></i>
                    <span class="small fw-bold text-dark">@ViewBag.Points Pts (@ViewBag.BadgeLevel)</span>
                </div>
                <a href="/Account/Logout" class="text-danger text-decoration-none small fw-semibold">Logout</a>
            </div>
        </header>

        <!-- Page Body Content -->
        <main class="p-4 flex-grow-1">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bolder text-dark mb-0">Complaint #@Model.ComplaintId Execution</h2>
                    <p class="text-muted mb-0 small">On-site verification, field work progress upload, and resolution sign-off.</p>
                </div>
                <div>
                    <span class="badge status-badge @(Model.Status.ToString().ToLower()) rounded-pill px-3 py-2 fs-6">
                        Status: @Model.Status
                    </span>
                </div>
            </div>

            <!-- On-Screen Notification Alert Box (For inline errors or status messages) -->
            <div id="screenAlert" class="alert d-none alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <span id="screenAlertText"></span>
                <button type="button" class="btn-close" onclick="$('#screenAlert').addClass('d-none')"></button>
            </div>

            <div class="row g-4">
                <!-- Left 7 Columns: Info & Action Forms -->
                <div class="col-lg-7">
                    <!-- Complaint Information Card -->
                    <div class="card border rounded-4 shadow-sm bg-white mb-4">
                        <div class="card-header bg-white border-0 pt-3 px-4">
                            <h5 class="fw-bold mb-0 text-dark">Task Information</h5>
                        </div>
                        <div class="card-body px-4 pb-4 pt-2">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Problem Type</label>
                                    <p class="fw-bold text-dark mb-2"><span class="badge bg-light text-dark border">@Model.ProblemType</span></p>
                                    
                                    <label class="text-muted small fw-semibold">Description</label>
                                    <p class="text-dark mb-2">@(Model.Description ?? "No description provided")</p>
                                    
                                    <label class="text-muted small fw-semibold">Street Address</label>
                                    <p class="text-dark mb-1">@(Model.Address ?? "Location pinned on map")</p>
                                    <small class="text-muted font-monospace"><i class="fas fa-map-pin me-1 text-danger"></i>@Model.Latitude, @Model.Longitude</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-muted small fw-semibold">Reported By</label>
                                    <p class="fw-bold text-dark mb-2">@Model.User?.Name <span class="text-muted fw-normal">(@Model.User?.Email)</span></p>
                                    
                                    <label class="text-muted small fw-semibold">Reported Date</label>
                                    <p class="text-dark mb-2">@Model.CreatedAt.ToLocalTime().ToString("f")</p>
                                    
                                    <label class="text-muted small fw-semibold">Department</label>
                                    <p class="fw-semibold text-primary mb-0">@(Model.Department?.Name ?? "General")</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.PhotoPath))
                            {
                                <div class="mt-3 border-top pt-3">
                                    <label class="text-muted small fw-semibold d-block mb-2">Original Citizen Reported Photo</label>
                                    <img src="@Model.PhotoPath" class="img-fluid rounded-3 border shadow-sm" style="max-height: 240px;" alt="Original Photo" />
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Step 1: Work in Progress Upload -->
                    <div class="card border rounded-4 shadow-sm bg-white mb-4 overflow-hidden">
                        <div class="card-header bg-warning bg-opacity-10 border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-tools text-warning me-2"></i>Step 1: Start Work (In Progress Proof)</h5>
                            @if (hasWorkPhoto)
                            {
                                <span class="badge bg-success rounded-pill px-3 py-1">✓ On-Site Proof Uploaded</span>
                            }
                        </div>
                        <div class="card-body p-4">
                            <p class="text-muted small mb-3">Upload a photo showing field technicians active on-site. This automatically moves the grievance to <strong>In Progress</strong>.</p>
                            
                            <form id="workInProgressForm" enctype="multipart/form-data">
                                <input type="hidden" name="complaintId" value="@Model.ComplaintId" />
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-dark small">Select Work-in-Progress Photo</label>
                                    <input type="file" class="form-control rounded-3" name="workInProgressPhoto" id="workInProgressPhotoInput" accept="image/*" required />
                                </div>
                                <button type="submit" class="btn btn-warning fw-bold text-dark rounded-pill px-4 shadow-sm" id="btnUploadWork">
                                    <i class="fas fa-upload me-1"></i> Upload & Mark In Progress
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Step 2: Fixed / Completion Upload -->
                    <div class="card border rounded-4 shadow-sm bg-white mb-4 overflow-hidden">
                        <div class="card-header bg-success bg-opacity-10 border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-check-circle text-success me-2"></i>Step 2: Complete Work (Fixed Resolution Proof)</h5>
                            @if (hasFixedPhoto)
                            {
                                <span class="badge bg-success rounded-pill px-3 py-1">✓ Resolution Proof Uploaded</span>
                            }
                        </div>
                        <div class="card-body p-4">
                            <p class="text-muted small mb-3">Upload the finished after-repair photo. This marks the complaint as <strong>Fixed</strong> and earns you <strong>+10 Points</strong>!</p>
                            
                            <form id="fixedForm" enctype="multipart/form-data">
                                <input type="hidden" name="complaintId" value="@Model.ComplaintId" />
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-dark small">Select Fixed / Completed Photo</label>
                                    <input type="file" class="form-control rounded-3" name="fixedPhoto" id="fixedPhotoInput" accept="image/*" required />
                                </div>
                                <button type="submit" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm" id="btnUploadFixed">
                                    <i class="fas fa-check-double me-1"></i> Upload & Mark as Fixed (+10 Pts)
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Right 5 Columns: Technician Photo Proofs Gallery -->
                <div class="col-lg-5">
                    <div class="card border rounded-4 shadow-sm bg-white sticky-top" style="top: 80px;">
                        <div class="card-header bg-white border-0 pt-3 px-4">
                            <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-images me-2 text-primary"></i>Uploaded Field Proofs</h5>
                        </div>
                        <div class="card-body px-4 pb-4 pt-1">
                            @if (!Model.TechnicianPhotos.Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="fas fa-camera fa-3x mb-3 opacity-25"></i>
                                    <p class="mb-0 small">No technician photos uploaded yet.<br>Upload a photo using Step 1 or Step 2 on the left.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var photo in Model.TechnicianPhotos.OrderBy(p => p.UploadedAt))
                                {
                                    <div class="card border rounded-3 mb-3 bg-light shadow-sm overflow-hidden">
                                        <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center bg-white border-bottom">
                                            <span class="badge @(photo.PhotoType == "WorkInProgress" ? "bg-warning text-dark" : "bg-success") rounded-pill">
                                                @(photo.PhotoType == "WorkInProgress" ? "Work In Progress" : "Fixed / Completed")
                                            </span>
                                            <small class="text-muted">@photo.UploadedAt.ToLocalTime().ToString("MMM dd, h:mm tt")</small>
                                        </div>
                                        <div class="card-body p-2 text-center bg-white">
                                            <img src="@photo.PhotoPath" class="img-fluid rounded border" style="max-height: 220px;" alt="@photo.PhotoType Photo">
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- On-Screen Beautiful Popup Modal for Proof Uploads -->
<div class="modal fade" id="onScreenSuccessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden text-center p-4">
            <div class="modal-body p-0">
                <div class="mb-3">
                    <div id="modalIconContainer" class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 72px; height: 72px; background: rgba(25, 135, 84, 0.1);">
                        <i id="modalIcon" class="fas fa-check-circle fa-3x text-success"></i>
                    </div>
                </div>
                
                <h4 id="modalTitle" class="fw-bold text-dark mb-2">Status Updated!</h4>
                <p id="modalMessage" class="text-muted mb-4 px-2">Work marked as Fixed with completion photo! You earned 10 points.</p>
                
                <div id="modalPointsBadge" class="mb-4 d-none">
                    <span class="badge bg-warning bg-opacity-25 text-dark rounded-pill px-3 py-2 fw-bold fs-6 border border-warning border-opacity-50">
                        <i class="fas fa-star text-warning me-1"></i> +10 Points Added to Scoreboard!
                    </span>
                </div>

                <button type="button" class="btn btn-dark w-100 py-2 rounded-pill fw-bold shadow-sm" onclick="location.reload()">
                    Continue & View Details
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.technician-dashboard-root {
    font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
}
.sidebar-link {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    border-radius: 8px;
    color: #64748b;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s;
}
.sidebar-link:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}
.sidebar-link.active {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}
.top-tab-link {
    text-decoration: none;
    color: #64748b;
    font-weight: 500;
    font-size: 0.95rem;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
}
.top-tab-link:hover {
    color: #0f172a;
}
.top-tab-link.active {
    color: #2563eb;
    border-bottom-color: #2563eb;
    font-weight: 600;
}
.status-badge.pending { background-color: #dc3545 !important; color: #fff; }
.status-badge.inprogress { background-color: #ffc107 !important; color: #000; }
.status-badge.fixed { background-color: #198754 !important; color: #fff; }
</style>

@section Scripts {
<script>
    function showOnScreenModal(title, message, isFixed) {
        $('#modalTitle').text(title);
        $('#modalMessage').text(message);
        
        if (isFixed) {
            $('#modalIconContainer').css('background', 'rgba(25, 135, 84, 0.15)');
            $('#modalIcon').attr('class', 'fas fa-award fa-3x text-success');
            $('#modalPointsBadge').removeClass('d-none');
        } else {
            $('#modalIconContainer').css('background', 'rgba(255, 193, 7, 0.15)');
            $('#modalIcon').attr('class', 'fas fa-tools fa-3x text-warning');
            $('#modalPointsBadge').addClass('d-none');
        }

        const modal = new bootstrap.Modal(document.getElementById('onScreenSuccessModal'), {
            backdrop: 'static'
        });
        modal.show();
    }

    function showInlineError(message) {
        $('#screenAlertText').html('<i class="fas fa-exclamation-triangle me-2"></i>' + message);
        $('#screenAlert').removeClass('d-none alert-success').addClass('alert-danger');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    $(document).ready(function() {
        // Form 1: Work In Progress Upload
        $('#workInProgressForm').on('submit', function(e) {
            e.preventDefault();
            const file = $('#workInProgressPhotoInput')[0].files[0];
            if (!file) {
                showInlineError('Please select a Work in Progress photo first.');
                return;
            }

            const formData = new FormData();
            formData.append('complaintId', '@Model.ComplaintId');
            formData.append('workInProgressPhoto', file);

            $('#btnUploadWork').prop('disabled', true).text('Uploading...');

            $.ajax({
                url: '/Technician/UploadPhotos',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    if (res.success) {
                        showOnScreenModal('Work Marked In Progress!', res.message || 'On-site photo uploaded successfully.', false);
                    } else {
                        showInlineError(res.message);
                        $('#btnUploadWork').prop('disabled', false).html('<i class="fas fa-upload me-1"></i> Upload & Mark In Progress');
                    }
                },
                error: function() {
                    showInlineError('Server error uploading photo. Please try again.');
                    $('#btnUploadWork').prop('disabled', false).html('<i class="fas fa-upload me-1"></i> Upload & Mark In Progress');
                }
            });
        });

        // Form 2: Fixed Issue Upload
        $('#fixedForm').on('submit', function(e) {
            e.preventDefault();
            const file = $('#fixedPhotoInput')[0].files[0];
            if (!file) {
                showInlineError('Please select a Fixed resolution photo first.');
                return;
            }

            const formData = new FormData();
            formData.append('complaintId', '@Model.ComplaintId');
            formData.append('fixedPhoto', file);

            $('#btnUploadFixed').prop('disabled', true).text('Uploading & Completing...');

            $.ajax({
                url: '/Technician/UploadPhotos',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    if (res.success) {
                        showOnScreenModal('Grievance Resolved & Fixed!', res.message || 'Work marked as Fixed with completion photo! You earned 10 points.', true);
                    } else {
                        showInlineError(res.message);
                        $('#btnUploadFixed').prop('disabled', false).html('<i class="fas fa-check-double me-1"></i> Upload & Mark as Fixed (+10 Pts)');
                    }
                },
                error: function() {
                    showInlineError('Server error uploading photo. Please try again.');
                    $('#btnUploadFixed').prop('disabled', false).html('<i class="fas fa-check-double me-1"></i> Upload & Mark as Fixed (+10 Pts)');
                }
            });
        });
    });
</script>
}
