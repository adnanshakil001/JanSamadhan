@model IEnumerable<JanSamadhan.Models.Complaint>
@{
    ViewData["Title"] = "Available Work Pool - Technician";
    ViewData["HideDefaultNav"] = true;
    ViewData["FullWidth"] = true;
}

<div class="d-flex min-vh-100 bg-light technician-dashboard-root">
    <!-- Left Sidebar -->
    <aside class="technician-sidebar bg-white border-end d-flex flex-column justify-content-between p-3" style="width: 260px; min-width: 260px;">
        <div>
            <!-- Brand Logo -->
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none text-dark fw-bold fs-4 mb-4 px-2">
                <i class="fas fa-tools text-primary"></i>
                <span>JanSamadhan</span>
            </a>

            <!-- Navigation Links -->
            <nav class="nav flex-column gap-1">
                <a href="/Technician/Dashboard" class="sidebar-link">
                    <i class="fas fa-tasks me-3"></i> Assigned Tasks
                </a>
                <a href="/Technician/AvailableWork" class="sidebar-link active">
                    <i class="fas fa-inbox me-3"></i> Available Work Pool
                </a>
                <a href="/Technician/Scoreboard" class="sidebar-link">
                    <i class="fas fa-medal me-3"></i> Technician Board
                </a>
            </nav>
        </div>

        <!-- Sidebar Footer Action -->
        <div class="pt-3 border-top">
            <div class="p-2 bg-light rounded-3 mb-3 border">
                <small class="text-muted d-block">Department</small>
                <strong class="text-dark small"><i class="fas fa-building text-primary me-1"></i>@ViewBag.DepartmentName</strong>
            </div>
            <div class="d-flex align-items-center justify-content-between px-2 text-muted small">
                <a href="/Account/Profile" class="text-secondary text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-user"></i> Profile
                </a>
                <a href="/Account/Logout" class="text-danger text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content Panel -->
    <div class="flex-grow-1 d-flex flex-column overflow-auto">
        <!-- Top Header Navigation Bar -->
        <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center sticky-top">
            <div class="d-flex align-items-center gap-4">
                <a href="/Technician/Dashboard" class="top-tab-link">Assigned Tasks</a>
                <a href="/Technician/AvailableWork" class="top-tab-link active">Available Work Pool</a>
                <a href="/Technician/Scoreboard" class="top-tab-link">Performance Scoreboard</a>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 px-3 py-1 bg-warning bg-opacity-10 border border-warning border-opacity-50 rounded-pill">
                    <i class="fas fa-award text-warning"></i>
                    <span class="small fw-bold text-dark">@ViewBag.Points Pts (@ViewBag.BadgeLevel)</span>
                </div>
                <a href="/Account/Logout" class="text-danger text-decoration-none small fw-semibold">Logout</a>
            </div>
        </header>

        <!-- Page Body Content -->
        <main class="p-4 flex-grow-1">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bolder text-dark mb-0">Department Work Pool</h2>
                    <p class="text-muted mb-0 small">Unassigned civic grievances in your department ready for immediate field claiming.</p>
                </div>
                <div>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-2 fs-6">
                        <i class="fas fa-building me-1"></i> Department: @ViewBag.TechnicianDepartment
                    </span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Message))
            {
                <div class="alert alert-warning rounded-3 shadow-sm" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.Message
                </div>
            }

            <div class="card border rounded-4 shadow-sm bg-white overflow-hidden">
                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">Unassigned Tasks Ready to Claim</h5>
                    <span class="text-muted small">@Model.Count() tasks available</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light small text-muted">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Problem Type</th>
                                <th>Description</th>
                                <th>Location Address</th>
                                <th>Reported By</th>
                                <th>Created Date</th>
                                <th class="pe-4 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="fas fa-check-circle fa-3x mb-3 text-success opacity-50"></i>
                                        <h5>No Pending Work in Pool</h5>
                                        <p class="small text-muted mb-3">All grievances in your department are currently assigned or resolved.</p>
                                        <a href="/Technician/Dashboard" class="btn btn-primary rounded-pill px-4">Back to My Tasks</a>
                                    </td>
                                </tr>
                            }
                            @foreach (var complaint in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">#@complaint.ComplaintId</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">@complaint.ProblemType</span>
                                    </td>
                                    <td class="small text-truncate" style="max-width: 220px;">
                                        @(complaint.Description ?? "No description")
                                    </td>
                                    <td class="small text-truncate" style="max-width: 220px;" title="@complaint.Address">
                                        <i class="fas fa-map-marker-alt text-danger me-1"></i>@(complaint.Address ?? "Pinned on map")
                                    </td>
                                    <td class="small">@complaint.User?.Name</td>
                                    <td class="small text-muted">@complaint.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group">
                                            <a href="@Url.Action("Details", new { id = complaint.ComplaintId })" class="btn btn-sm btn-outline-secondary rounded-pill px-2 me-1">
                                                Inspect
                                            </a>
                                            <button class="btn btn-sm btn-success rounded-pill px-3 fw-bold" onclick="claimTask(@complaint.ComplaintId)">
                                                <i class="fas fa-hand-holding me-1"></i> Claim Task
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<style>
.technician-dashboard-root {
    font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
}
.sidebar-link {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    border-radius: 8px;
    color: #64748b;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s;
}
.sidebar-link:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}
.sidebar-link.active {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}
.top-tab-link {
    text-decoration: none;
    color: #64748b;
    font-weight: 500;
    font-size: 0.95rem;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
}
.top-tab-link:hover {
    color: #0f172a;
}
.top-tab-link.active {
    color: #2563eb;
    border-bottom-color: #2563eb;
    font-weight: 600;
}
</style>

@section Scripts {
<script>
    function claimTask(complaintId) {
        if (!confirm('Are you sure you want to claim Complaint #' + complaintId + ' and assign it to yourself?')) {
            return;
        }

        $.post('/Technician/Claim', { id: complaintId })
            .done(function(res) {
                if (res.success) {
                    alert(res.message);
                    window.location.href = '/Technician/Details/' + complaintId;
                } else {
                    alert('Error: ' + res.message);
                }
            })
            .fail(function() {
                alert('Server error claiming task.');
            });
    }
</script>
}
