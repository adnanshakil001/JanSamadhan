@model IEnumerable<JanSamadhan.Models.Complaint>
@{
    ViewData["Title"] = "Department Work Pool - JanSamadhan";
    ViewData["FullWidth"] = true;

    string techName = ViewBag.TechnicianName as string ?? "Field Operator";
    string initial = string.IsNullOrWhiteSpace(techName) ? "T" : techName.Substring(0, 1).ToUpperInvariant();
    string deptName = ViewBag.DepartmentName as string ?? "Municipal Services";
    int points = ViewBag.Points as int? ?? 0;
    string badgeLevel = ViewBag.BadgeLevel as string ?? "Bronze";
}

@section Styles {
    <link rel="stylesheet" href="~/css/technician-field.css" asp-append-version="true" />
}

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- 1. Operator Header Banner -->
    <div class="tech-header-card">
        <div class="tech-operator-meta">
            <div class="tech-operator-avatar" aria-hidden="true">@initial</div>
            <div>
                <h1 class="tech-operator-name">@techName</h1>
                <div class="tech-operator-dept">
                    <i class="fas fa-building text-primary" aria-hidden="true"></i>
                    <span>@deptName</span>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-warning bg-opacity-25 text-dark border border-warning rounded-pill px-3 py-2 fw-bold">
                <i class="fas fa-award text-warning me-1" aria-hidden="true"></i>@points Pts &middot; @badgeLevel
            </span>
            <a href="/Technician/Dashboard" class="btn btn-outline-primary rounded-pill px-3 fw-semibold d-inline-flex align-items-center gap-1">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                <span>My Active Roster</span>
            </a>
        </div>
    </div>

    <!-- 2. Mobile Segmented Nav Switcher -->
    <nav class="tech-segmented-nav" aria-label="Field Workspace Modes">
        <a href="/Technician/Dashboard" class="tech-seg-link">
            <i class="fas fa-clipboard-check" aria-hidden="true"></i>
            <span>My Tasks</span>
        </a>
        <a href="/Technician/AvailableWork" class="tech-seg-link is-active" aria-current="page">
            <i class="fas fa-inbox" aria-hidden="true"></i>
            <span>Work Pool (@Model.Count())</span>
        </a>
        <a href="/Technician/Scoreboard" class="tech-seg-link">
            <i class="fas fa-medal" aria-hidden="true"></i>
            <span>Leaderboard</span>
        </a>
    </nav>

    @if (!string.IsNullOrEmpty(ViewBag.Message))
    {
        <div class="alert alert-warning rounded-3 shadow-sm mb-4" role="alert">
            <i class="fas fa-triangle-exclamation me-2" aria-hidden="true"></i>@ViewBag.Message
        </div>
    }

    <!-- 3. Work Pool Cards Feed -->
    @if (!Model.Any())
    {
        <div class="card border rounded-4 shadow-sm bg-white p-5 text-center my-4">
            <i class="fas fa-inbox fa-3x text-muted opacity-50 mb-3" aria-hidden="true"></i>
            <h2 class="h5 fw-bold text-dark">No Open Tasks in Queue</h2>
            <p class="text-muted small mb-4">All civic complaints in your department jurisdiction have been assigned or resolved.</p>
            <div>
                <a href="/Technician/Dashboard" class="btn btn-primary rounded-pill px-4 fw-semibold">
                    Return to My Active Tasks &rarr;
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="tech-task-grid" role="feed" aria-label="Available Jobs Feed">
            @foreach (var c in Model)
            {
                var elapsedHours = (DateTime.UtcNow - c.CreatedAt).TotalHours;
                var isUrgent = elapsedHours > 48;
                var urgencyClass = isUrgent ? "tech-urgency-badge--urgent" : "tech-urgency-badge--normal";
                var urgencyLabel = isUrgent ? "Over 48h Awaiting" : (elapsedHours > 24 ? "24-48h In Queue" : "New Report");

                <article class="tech-task-card" id="task_card_@c.ComplaintId" aria-labelledby="avail_title_@c.ComplaintId">
                    <div>
                        <div class="tech-task-card__header">
                            <div class="tech-task-badge-group">
                                <span class="badge bg-light text-dark border fw-bold text-xs">@c.ProblemType</span>
                                <span class="tech-urgency-badge @urgencyClass">
                                    <i class="fas fa-hourglass-half" aria-hidden="true"></i>
                                    <span>@urgencyLabel</span>
                                </span>
                            </div>
                            <span class="badge bg-info bg-opacity-25 text-primary border border-info rounded-pill text-xs px-2 py-1">
                                Open Pool
                            </span>
                        </div>

                        <div class="tech-task-card__body">
                            <h2 class="tech-task-title" id="avail_title_@c.ComplaintId">
                                Complaint #@c.ComplaintId
                            </h2>
                            <p class="tech-task-desc">
                                @(string.IsNullOrWhiteSpace(c.Description) ? "No detailed notes provided by citizen." : c.Description)
                            </p>

                            <!-- Location Box -->
                            <div class="tech-task-location">
                                <i class="fas fa-location-dot text-danger mt-1 flex-shrink-0" aria-hidden="true"></i>
                                <span>@(string.IsNullOrWhiteSpace(c.Address) ? "Geo-coordinates logged" : c.Address)</span>
                            </div>

                            <div class="tech-task-meta-row">
                                <span><i class="fas fa-user text-muted me-1" aria-hidden="true"></i>@(c.User?.Name ?? "Citizen")</span>
                                <span><i class="fas fa-clock text-muted me-1" aria-hidden="true"></i>@c.CreatedAt.ToLocalTime().ToString("MMM dd, hh:mm tt")</span>
                            </div>
                        </div>
                    </div>

                    <!-- 1-Tap Field Action Buttons -->
                    <div class="tech-task-card__footer">
                        <a href="https://www.google.com/maps/search/?api=1&query=@c.Latitude,@c.Longitude" target="_blank" rel="noopener noreferrer" class="tech-action-btn tech-action-btn--navigate" aria-label="Preview location on Google Maps">
                            <i class="fas fa-location-arrow" aria-hidden="true"></i>
                            <span>Navigate</span>
                        </a>
                        <button type="button" class="tech-action-btn tech-action-btn--primary" id="btn_claim_@c.ComplaintId" onclick="claimTask(@c.ComplaintId)" aria-label="Claim complaint #@c.ComplaintId into my tasks">
                            <i class="fas fa-hand-holding-hand" aria-hidden="true"></i>
                            <span>Claim Task</span>
                        </button>
                    </div>
                </article>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    function claimTask(complaintId) {
        const btn = $(`#btn_claim_${complaintId}`);
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status"></span> Claiming...');

        $.post(`/Technician/Claim?id=${complaintId}`)
            .done(function (res) {
                if (res.success) {
                    if (window.showToast) window.showToast('Task claimed successfully. Added to your dashboard.', 'success');
                    const card = $(`#task_card_${complaintId}`);
                    card.css('transition', 'transform 200ms ease, opacity 200ms ease');
                    card.css({ transform: 'scale(0.95)', opacity: '0' });

                    setTimeout(function () {
                        card.remove();
                        if ($('.tech-task-card').length === 0) {
                            window.location.reload();
                        }
                    }, 220);
                } else {
                    btn.prop('disabled', false).html('<i class="fas fa-hand-holding-hand"></i> <span>Claim Task</span>');
                    const msg = res.message || 'Could not claim task.';
                    if (window.showToast) window.showToast(msg, 'error');
                    else alert(msg);
                }
            })
            .fail(function () {
                btn.prop('disabled', false).html('<i class="fas fa-hand-holding-hand"></i> <span>Claim Task</span>');
                if (window.showToast) window.showToast('Server error occurred while claiming task.', 'error');
                else alert('Server error occurred while claiming task.');
            });
    }
</script>
}
