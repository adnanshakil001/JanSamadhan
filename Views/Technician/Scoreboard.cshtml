@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Technician Performance Scoreboard - JanSamadhan";
    ViewData["HideDefaultNav"] = true;
    ViewData["FullWidth"] = true;
}

<div class="d-flex min-vh-100 bg-light technician-dashboard-root">
    <!-- Left Sidebar -->
    <aside class="technician-sidebar bg-white border-end d-flex flex-column justify-content-between p-3" style="width: 260px; min-width: 260px;">
        <div>
            <!-- Brand Logo -->
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none text-dark fw-bold fs-4 mb-4 px-2">
                <i class="fas fa-tools text-primary"></i>
                <span>JanSamadhan</span>
            </a>

            <!-- Navigation Links -->
            <nav class="nav flex-column gap-1">
                <a href="/Technician/Dashboard" class="sidebar-link">
                    <i class="fas fa-tasks me-3"></i> Assigned Tasks
                </a>
                <a href="/Technician/AvailableWork" class="sidebar-link">
                    <i class="fas fa-inbox me-3"></i> Available Work Pool
                </a>
                <a href="/Technician/Scoreboard" class="sidebar-link active">
                    <i class="fas fa-medal me-3"></i> Technician Board
                </a>
            </nav>
        </div>

        <!-- Sidebar Footer Action -->
        <div class="pt-3 border-top">
            <div class="p-2 bg-light rounded-3 mb-3 border">
                <small class="text-muted d-block">Department</small>
                <strong class="text-dark small"><i class="fas fa-building text-primary me-1"></i>@ViewBag.DepartmentName</strong>
            </div>
            <div class="d-flex align-items-center justify-content-between px-2 text-muted small">
                <a href="/Account/Profile" class="text-secondary text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-user"></i> Profile
                </a>
                <a href="/Account/Logout" class="text-danger text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content Panel -->
    <div class="flex-grow-1 d-flex flex-column overflow-auto">
        <!-- Top Header Navigation Bar -->
        <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center sticky-top">
            <div class="d-flex align-items-center gap-4">
                <a href="/Technician/Dashboard" class="top-tab-link">Assigned Tasks</a>
                <a href="/Technician/AvailableWork" class="top-tab-link">Available Work Pool</a>
                <a href="/Technician/Scoreboard" class="top-tab-link active">Performance Scoreboard</a>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 px-3 py-1 bg-warning bg-opacity-10 border border-warning border-opacity-50 rounded-pill">
                    <i class="fas fa-award text-warning"></i>
                    <span class="small fw-bold text-dark">@ViewBag.Points Pts (@ViewBag.BadgeLevel)</span>
                </div>
                <a href="/Account/Logout" class="text-danger text-decoration-none small fw-semibold">Logout</a>
            </div>
        </header>

        <!-- Page Body Content -->
        <main class="p-4 flex-grow-1">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bolder text-dark mb-0">Field Workforce Leaderboard</h2>
                    <p class="text-muted mb-0 small">Compare resolution turnaround, completed grievances, and efficiency rankings across all city departments.</p>
                </div>
            </div>

            <div class="card border rounded-4 shadow-sm bg-white overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light small text-muted">
                            <tr>
                                <th class="ps-4" style="width: 80px;">Rank</th>
                                <th>Technician Name</th>
                                <th>Official Email</th>
                                <th>Department</th>
                                <th>Completed Tasks</th>
                                <th>Pending Tasks</th>
                                <th class="pe-4">Resolution Progress</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rank = 1; }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="fas fa-tools fa-3x mb-3 opacity-25"></i>
                                        <h5>No technicians registered yet</h5>
                                    </td>
                                </tr>
                            }
                            @foreach (var technician in Model)
                            {
                                var total = technician.CompletedTasks + technician.PendingTasks;
                                var performance = total > 0 
                                    ? Math.Round((double)technician.CompletedTasks / total * 100, 1)
                                    : 0;
                                var badgeColor = rank == 1 ? "bg-warning text-dark" : (rank == 2 ? "bg-secondary text-white" : (rank == 3 ? "bg-dark text-white" : "bg-light text-dark border"));
                                var perfColor = performance >= 75 ? "bg-success" : (performance >= 50 ? "bg-warning" : "bg-danger");

                                <tr>
                                    <td class="ps-4">
                                        <span class="badge @badgeColor rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-weight: 700;">
                                            #@rank
                                        </span>
                                    </td>
                                    <td class="fw-bold text-dark">@technician.Name</td>
                                    <td class="text-muted small">@technician.Email</td>
                                    <td>
                                        <span class="badge bg-light text-dark border rounded-pill px-3 py-1">
                                            @technician.DepartmentName
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fw-bold">
                                            @technician.CompletedTasks Fixed
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning bg-opacity-25 text-dark rounded-pill px-3 py-1 fw-bold">
                                            @technician.PendingTasks Active
                                        </span>
                                    </td>
                                    <td class="pe-4">
                                        <div class="d-flex align-items-center gap-2" style="min-width: 140px;">
                                            <div class="progress flex-grow-1" style="height: 8px;">
                                                <div class="progress-bar @perfColor rounded" style="width: @performance%"></div>
                                            </div>
                                            <span class="small fw-bold text-dark">@performance%</span>
                                        </div>
                                    </td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<style>
.technician-dashboard-root {
    font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
}
.sidebar-link {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    border-radius: 8px;
    color: #64748b;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s;
}
.sidebar-link:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}
.sidebar-link.active {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}
.top-tab-link {
    text-decoration: none;
    color: #64748b;
    font-weight: 500;
    font-size: 0.95rem;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
}
.top-tab-link:hover {
    color: #0f172a;
}
.top-tab-link.active {
    color: #2563eb;
    border-bottom-color: #2563eb;
    font-weight: 600;
}
</style>
