@model IEnumerable<JanSamadhan.Models.Complaint>
@{
    ViewData["Title"] = "Technician Field Operations - JanSamadhan";

    var stats = ViewBag.Stats;
    int totalAssigned = stats?.TotalAssigned ?? Model.Count();
    int inProgress = stats?.InProgress ?? Model.Count(c => c.Status == JanSamadhan.Models.ComplaintStatus.InProgress);
    int pending = stats?.Pending ?? Model.Count(c => c.Status == JanSamadhan.Models.ComplaintStatus.Pending);
    int fixedCount = stats?.Fixed ?? Model.Count(c => c.Status == JanSamadhan.Models.ComplaintStatus.Fixed);

    string techName = ViewBag.TechnicianName as string ?? "Field Operator";
    string initial = string.IsNullOrWhiteSpace(techName) ? "T" : techName.Substring(0, 1).ToUpperInvariant();
    string deptName = ViewBag.DepartmentName as string ?? "Municipal Services";
    int points = ViewBag.Points as int? ?? 0;
    string badgeLevel = ViewBag.BadgeLevel as string ?? "Bronze";
}

@section Styles {
    <link rel="stylesheet" href="~/css/complaints.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/technician-field.css" asp-append-version="true" />
}

<!-- 1. Dashboard Header (Unified with Citizen Dashboard) -->
<div class="dashboard-header">
    <div class="d-flex align-items-center gap-3">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold shadow-sm" style="width: 48px; height: 48px; font-size: 1.25rem; flex-shrink: 0;" aria-hidden="true">
            @initial
        </div>
        <div>
            <h1 class="dashboard-title">Technician Field Operations</h1>
            <p class="dashboard-subtitle">
                Welcome back, <strong class="text-dark">@techName</strong> &middot; @deptName
            </p>
        </div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="badge bg-warning bg-opacity-25 text-dark border border-warning rounded-pill px-3 py-2 fw-bold">
            <i class="fas fa-award text-warning me-1" aria-hidden="true"></i>@points Pts &middot; @badgeLevel
        </span>
        <a href="/Technician/AvailableWork" class="dashboard-action-btn">
            <i class="fas fa-inbox" aria-hidden="true"></i>
            <span>Claim New Work</span>
        </a>
    </div>
</div>

<!-- 2. 4-Metric KPI Row (Citizen Design System) -->
<section class="metrics-grid metrics-grid--4" aria-label="Assigned Task Metrics">
    <div class="metric-card metric-card--primary">
        <div class="metric-card__content">
            <span class="metric-card__label">Total Roster</span>
            <span class="metric-card__count">@totalAssigned</span>
            <small class="text-muted mt-1 text-xs">All assigned tickets</small>
        </div>
        <div class="metric-card__icon" aria-hidden="true">
            <i class="fas fa-clipboard-list"></i>
        </div>
    </div>

    <div class="metric-card metric-card--inprogress">
        <div class="metric-card__content">
            <span class="metric-card__label">In Field Repair</span>
            <span class="metric-card__count">@inProgress</span>
            <small class="text-warning mt-1 text-xs fw-semibold">Active tasks</small>
        </div>
        <div class="metric-card__icon" aria-hidden="true">
            <i class="fas fa-screwdriver-wrench"></i>
        </div>
    </div>

    <div class="metric-card metric-card--pending">
        <div class="metric-card__content">
            <span class="metric-card__label">Awaiting Triage</span>
            <span class="metric-card__count">@pending</span>
            <small class="text-danger mt-1 text-xs fw-semibold">Action required</small>
        </div>
        <div class="metric-card__icon" aria-hidden="true">
            <i class="fas fa-clock"></i>
        </div>
    </div>

    <div class="metric-card metric-card--fixed">
        <div class="metric-card__content">
            <span class="metric-card__label">Resolved Fixed</span>
            <span class="metric-card__count">@fixedCount</span>
            <small class="text-success mt-1 text-xs fw-semibold">Proof uploaded</small>
        </div>
        <div class="metric-card__icon" aria-hidden="true">
            <i class="fas fa-circle-check"></i>
        </div>
    </div>
</section>

<!-- 3. Toolbar (Segmented Tabs, Navigation & Live Search) -->
<div class="complaints-toolbar">
    <!-- Segmented Status Tabs -->
    <div class="filter-tabs" role="tablist" aria-label="Filter Assigned Tasks">
        <button type="button" class="filter-tab active" data-filter="all" role="tab" aria-selected="true">
            <span>All Tasks</span>
            <span class="filter-tab__count">@totalAssigned</span>
        </button>
        <button type="button" class="filter-tab" data-filter="inprogress" role="tab" aria-selected="false">
            <span>In Field</span>
            <span class="filter-tab__count">@inProgress</span>
        </button>
        <button type="button" class="filter-tab" data-filter="pending" role="tab" aria-selected="false">
            <span>Pending</span>
            <span class="filter-tab__count">@pending</span>
        </button>
        <button type="button" class="filter-tab" data-filter="fixed" role="tab" aria-selected="false">
            <span>Resolved</span>
            <span class="filter-tab__count">@fixedCount</span>
        </button>
    </div>

    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-end">
        <a href="/Technician/AvailableWork" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-1">
            <i class="fas fa-inbox" aria-hidden="true"></i> <span>Work Pool</span>
        </a>
        <a href="/Technician/Scoreboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-1">
            <i class="fas fa-medal" aria-hidden="true"></i> <span>Leaderboard</span>
        </a>
        <div class="search-wrapper" style="max-width: 260px;">
            <i class="fas fa-search search-icon" aria-hidden="true"></i>
            <input type="search" id="taskSearchInput" class="search-input" placeholder="Search tasks or address..." aria-label="Search assigned tasks" />
        </div>
    </div>
</div>

<!-- 4. Tasks Table & Cards Presentation -->
@if (!Model.Any())
{
    <div class="card border rounded-4 shadow-sm bg-white p-5 text-center my-4">
        <i class="fas fa-clipboard-check fa-3x text-muted opacity-50 mb-3" aria-hidden="true"></i>
        <h2 class="h5 fw-bold text-dark">No Assigned Tasks Right Now</h2>
        <p class="text-muted small mb-4">You have cleared all active field duties or have not been dispatched new tickets.</p>
        <div>
            <a href="/Technician/AvailableWork" class="dashboard-action-btn">
                <i class="fas fa-inbox me-1"></i> Browse Department Work Pool
            </a>
        </div>
    </div>
}
else
{
    <!-- Desktop Table View -->
    <div class="complaints-table-container mb-4">
        <table class="complaints-table mb-0" aria-label="Assigned Field Tasks">
            <thead>
                <tr>
                    <th scope="col">Case ID</th>
                    <th scope="col">Category</th>
                    <th scope="col">Location Address</th>
                    <th scope="col">Citizen</th>
                    <th scope="col">Status</th>
                    <th scope="col">Reported Date</th>
                    <th scope="col" class="text-end">Field Actions</th>
                </tr>
            </thead>
            <tbody id="techTasksTbody">
                @foreach (var c in Model)
                {
                    var isFixed = c.Status == JanSamadhan.Models.ComplaintStatus.Fixed;
                    var isInProgress = c.Status == JanSamadhan.Models.ComplaintStatus.InProgress;
                    var statusKey = isFixed ? "fixed" : (isInProgress ? "inprogress" : "pending");
                    var statusClass = isFixed ? "status-pill--fixed" : (isInProgress ? "status-pill--inprogress" : "status-pill--pending");

                    var elapsedHours = (DateTime.UtcNow - c.CreatedAt).TotalHours;
                    var isUrgent = elapsedHours > 48 && !isFixed;

                    <tr class="task-row" data-status="@statusKey" data-search="@c.ComplaintId @c.ProblemType @c.Address @c.Description @(c.User?.Name)">
                        <td>
                            <strong class="text-dark">#JS-@c.ComplaintId</strong>
                            @if (isUrgent)
                            {
                                <span class="badge bg-danger text-white rounded-pill text-xs ms-1">Urgent</span>
                            }
                            <div class="text-muted" style="font-size: 0.75rem;">
                                @c.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                            </div>
                        </td>
                        <td>
                            <span class="category-pill">
                                @c.ProblemType
                            </span>
                            @if (!string.IsNullOrWhiteSpace(c.Description))
                            {
                                <div class="text-muted small text-truncate mt-1" style="max-width: 220px;" title="@c.Description">
                                    @c.Description
                                </div>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1 text-truncate" style="max-width: 240px;" title="@c.Address">
                                <i class="fas fa-location-dot text-danger flex-shrink-0" aria-hidden="true"></i>
                                <span>@(string.IsNullOrWhiteSpace(c.Address) ? "Coordinates registered" : c.Address)</span>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark small">@(c.User?.Name ?? "Anonymous")</div>
                            <span class="badge bg-light text-muted border text-xs">@(c.User?.Role ?? "Citizen")</span>
                        </td>
                        <td>
                            <span class="status-pill @statusClass">
                                @(c.Status == JanSamadhan.Models.ComplaintStatus.InProgress ? "In Progress" : c.Status.ToString())
                            </span>
                        </td>
                        <td class="small text-muted whitespace-nowrap">
                            @c.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                            <span class="d-block text-xs">@c.CreatedAt.ToLocalTime().ToString("hh:mm tt")</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex align-items-center gap-2">
                                <a href="https://www.google.com/maps/search/?api=1&query=@c.Latitude,@c.Longitude" 
                                   target="_blank" rel="noopener noreferrer" 
                                   class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" title="Open navigation in Google Maps">
                                    <i class="fas fa-location-arrow text-primary" aria-hidden="true"></i>
                                </a>
                                <a href="/Technician/Details/@c.ComplaintId" class="table-action-btn">
                                    <span>@(isFixed ? "Review Proof" : "Work on Task")</span>
                                    <i class="fas fa-chevron-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile Card Feed -->
    <div class="complaints-cards-container mb-4" id="techTasksMobileFeed">
        @foreach (var c in Model)
        {
            var isFixed = c.Status == JanSamadhan.Models.ComplaintStatus.Fixed;
            var isInProgress = c.Status == JanSamadhan.Models.ComplaintStatus.InProgress;
            var statusKey = isFixed ? "fixed" : (isInProgress ? "inprogress" : "pending");
            var statusClass = isFixed ? "status-pill--fixed" : (isInProgress ? "status-pill--inprogress" : "status-pill--pending");

            var elapsedHours = (DateTime.UtcNow - c.CreatedAt).TotalHours;
            var isUrgent = elapsedHours > 48 && !isFixed;

            <div class="mobile-complaint-card task-card" data-status="@statusKey" data-search="@c.ComplaintId @c.ProblemType @c.Address @c.Description @(c.User?.Name)">
                <div class="mobile-card__head">
                    <span class="category-pill">
                        <strong>#JS-@c.ComplaintId</strong> &middot; @c.ProblemType
                    </span>
                    <span class="status-pill @statusClass">
                        @(c.Status == JanSamadhan.Models.ComplaintStatus.InProgress ? "In Progress" : c.Status.ToString())
                    </span>
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    <span class="fw-bold text-dark fs-6">@c.ProblemType</span>
                    @if (isUrgent)
                    {
                        <span class="badge bg-danger text-white rounded-pill text-xs">Over 48h</span>
                    }
                </div>
                <p class="text-muted small mb-1">@(string.IsNullOrWhiteSpace(c.Description) ? "No detailed description provided." : c.Description)</p>
                <div class="d-flex align-items-center gap-2 text-muted small">
                    <i class="fas fa-location-dot text-danger flex-shrink-0" aria-hidden="true"></i>
                    <span class="text-truncate">@(string.IsNullOrWhiteSpace(c.Address) ? "Geo-coordinates logged" : c.Address)</span>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-2">
                    <a href="https://www.google.com/maps/search/?api=1&query=@c.Latitude,@c.Longitude" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        <i class="fas fa-location-arrow me-1" aria-hidden="true"></i> Navigate
                    </a>
                    <a href="/Technician/Details/@c.ComplaintId" class="table-action-btn">
                        <span>@(isFixed ? "Review Proof" : "Work on Task")</span>
                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Empty Search Results Card -->
    <div class="card border rounded-4 shadow-sm bg-white p-5 text-center my-4" id="noFilterResultsCard" style="display: none;">
        <i class="fas fa-filter fa-3x text-muted opacity-50 mb-3" aria-hidden="true"></i>
        <h2 class="h5 fw-bold text-dark">No matching tasks found</h2>
        <p class="text-muted small mb-3">Try adjusting your search keywords or switching status tabs.</p>
        <div>
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" id="btnResetTechFilters">Reset Filters</button>
        </div>
    </div>
}

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tabs = document.querySelectorAll('.filter-tab[data-filter]');
        const searchInput = document.getElementById('taskSearchInput');
        const rows = document.querySelectorAll('.task-row');
        const cards = document.querySelectorAll('.task-card');
        const emptyState = document.getElementById('noFilterResultsCard');
        const resetBtn = document.getElementById('btnResetTechFilters');

        let currentFilter = 'all';
        let searchQuery = '';

        function applyFilter() {
            let visibleCount = 0;

            function matches(el) {
                const status = el.getAttribute('data-status');
                const search = (el.getAttribute('data-search') || '').toLowerCase();
                const matchesStatus = currentFilter === 'all' || status === currentFilter;
                const matchesQuery = !searchQuery || search.includes(searchQuery);
                return matchesStatus && matchesQuery;
            }

            rows.forEach(r => {
                const m = matches(r);
                r.style.display = m ? '' : 'none';
                if (m) visibleCount++;
            });

            cards.forEach(c => {
                c.style.display = matches(c) ? '' : 'none';
            });

            if (emptyState) {
                emptyState.style.display = (visibleCount === 0 && (rows.length > 0)) ? '' : 'none';
            }
        }

        tabs.forEach(tab => {
            tab.addEventListener('click', function () {
                tabs.forEach(t => {
                    t.classList.remove('active');
                    t.setAttribute('aria-selected', 'false');
                });
                this.classList.add('active');
                this.setAttribute('aria-selected', 'true');
                currentFilter = this.getAttribute('data-filter');
                applyFilter();
            });
        });

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                searchQuery = this.value.trim().toLowerCase();
                applyFilter();
            });
        }

        if (resetBtn) {
            resetBtn.addEventListener('click', function () {
                currentFilter = 'all';
                searchQuery = '';
                if (searchInput) searchInput.value = '';
                tabs.forEach(t => {
                    if (t.getAttribute('data-filter') === 'all') {
                        t.classList.add('active');
                        t.setAttribute('aria-selected', 'true');
                    } else {
                        t.classList.remove('active');
                        t.setAttribute('aria-selected', 'false');
                    }
                });
                applyFilter();
            });
        }
    });
</script>
}
