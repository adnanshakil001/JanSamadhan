@model IEnumerable<JanSamadhan.Models.Complaint>
@{
    ViewData["Title"] = "Technician Field Operations - JanSamadhan";
    ViewData["HideDefaultNav"] = true;
    ViewData["FullWidth"] = true;
}

<div class="d-flex min-vh-100 bg-light technician-dashboard-root">
    <!-- Left Sidebar -->
    <aside class="technician-sidebar bg-white border-end d-flex flex-column justify-content-between p-3" style="width: 260px; min-width: 260px;">
        <div>
            <!-- Brand Logo -->
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none text-dark fw-bold fs-4 mb-4 px-2">
                <i class="fas fa-tools text-primary"></i>
                <span>JanSamadhan</span>
            </a>

            <!-- Navigation Links -->
            <nav class="nav flex-column gap-1">
                <a href="/Technician/Dashboard" class="sidebar-link active">
                    <i class="fas fa-tasks me-3"></i> Assigned Tasks
                </a>
                <a href="/Technician/AvailableWork" class="sidebar-link">
                    <i class="fas fa-inbox me-3"></i> Available Work Pool
                </a>
                <a href="/Technician/Scoreboard" class="sidebar-link">
                    <i class="fas fa-medal me-3"></i> Technician Board
                </a>
            </nav>
        </div>

        <!-- Sidebar Footer Action -->
        <div class="pt-3 border-top">
            <div class="p-2 bg-light rounded-3 mb-3 border">
                <small class="text-muted d-block">Department</small>
                <strong class="text-dark small"><i class="fas fa-building text-primary me-1"></i>@ViewBag.DepartmentName</strong>
            </div>
            <div class="d-flex align-items-center justify-content-between px-2 text-muted small">
                <a href="/Account/Profile" class="text-secondary text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-user"></i> Profile
                </a>
                <a href="/Account/Logout" class="text-danger text-decoration-none d-flex align-items-center gap-1">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content Panel -->
    <div class="flex-grow-1 d-flex flex-column overflow-auto">
        <!-- Top Header Navigation Bar -->
        <header class="bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center sticky-top">
            <div class="d-flex align-items-center gap-4">
                <a href="/Technician/Dashboard" class="top-tab-link active">Assigned Tasks</a>
                <a href="/Technician/AvailableWork" class="top-tab-link text-primary fw-bold">Available Work Pool</a>
                <a href="/Technician/Scoreboard" class="top-tab-link">Performance Scoreboard</a>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 px-3 py-1 bg-warning bg-opacity-10 border border-warning border-opacity-50 rounded-pill">
                    <i class="fas fa-award text-warning"></i>
                    <span class="small fw-bold text-dark">@ViewBag.Points Pts (@ViewBag.BadgeLevel)</span>
                </div>
                <div class="dropdown">
                    <button class="btn btn-light rounded-pill px-3 py-1 d-flex align-items-center gap-2 border" type="button" data-bs-toggle="dropdown">
                        <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.75rem;">
                            @(ViewBag.TechnicianName != null && ((string)ViewBag.TechnicianName).Length > 0 ? ((string)ViewBag.TechnicianName).Substring(0, 1).ToUpper() : "T")
                        </div>
                        <span class="small fw-semibold text-dark">@ViewBag.TechnicianName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" href="/Account/Profile"><i class="fas fa-user me-2"></i>My Profile</a></li>
                        <li><a class="dropdown-item" href="/Technician/Scoreboard"><i class="fas fa-trophy me-2"></i>Scoreboard</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="fas fa-sign-out-alt me-2"></i>Logout</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Page Body Content -->
        <main class="p-4 flex-grow-1">
            <!-- Header Title -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bolder text-dark mb-0">Field Technician Operations</h2>
                    <p class="text-muted mb-0 small">Manage assigned civic redressal tasks, upload on-site proofs, and update resolution states.</p>
                </div>
                <div>
                    <a href="/Technician/AvailableWork" class="btn btn-primary fw-semibold rounded-pill px-4 shadow-sm">
                        <i class="fas fa-inbox me-1"></i> Claim Available Tasks
                    </a>
                </div>
            </div>

            <!-- Top Status Metric Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 text-white rounded-4 shadow-sm bg-primary">
                        <div class="card-body py-3 px-4 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="fs-6 text-white text-opacity-75 fw-semibold d-block">Total Assigned</span>
                                <h3 class="fw-bold mb-0">@ViewBag.Stats.TotalAssigned</h3>
                            </div>
                            <i class="fas fa-clipboard-list fa-2x text-white text-opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 text-white rounded-4 shadow-sm" style="background-color: #dc3545;">
                        <div class="card-body py-3 px-4 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="fs-6 text-white text-opacity-75 fw-semibold d-block">Pending Action</span>
                                <h3 class="fw-bold mb-0">@ViewBag.Stats.Pending</h3>
                            </div>
                            <i class="fas fa-clock fa-2x text-white text-opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 text-dark rounded-4 shadow-sm" style="background-color: #ffc107;">
                        <div class="card-body py-3 px-4 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="fs-6 text-dark text-opacity-75 fw-semibold d-block">In Progress</span>
                                <h3 class="fw-bold mb-0">@ViewBag.Stats.InProgress</h3>
                            </div>
                            <i class="fas fa-tools fa-2x text-dark text-opacity-50"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 text-white rounded-4 shadow-sm" style="background-color: #198754;">
                        <div class="card-body py-3 px-4 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="fs-6 text-white text-opacity-75 fw-semibold d-block">Fixed & Completed</span>
                                <h3 class="fw-bold mb-0">@ViewBag.Stats.Fixed</h3>
                            </div>
                            <i class="fas fa-check-double fa-2x text-white text-opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Assigned Complaints Table Card -->
            <div class="card border rounded-4 shadow-sm bg-white overflow-hidden">
                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">My Assigned Field Tasks</h5>
                    <span class="text-muted small">@ViewBag.Stats.TotalAssigned total tasks</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light small text-muted">
                            <tr>
                                <th class="ps-4">Complaint ID</th>
                                <th>Problem Type</th>
                                <th>Location Address</th>
                                <th>Current Status</th>
                                <th>Assigned Date</th>
                                <th class="pe-4 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-tools fa-3x mb-3 opacity-25"></i>
                                        <h5>No tasks assigned currently</h5>
                                        <p class="small text-muted mb-3">Check the Available Work Pool to claim unassigned tasks for your department.</p>
                                        <a href="/Technician/AvailableWork" class="btn btn-primary rounded-pill px-4">Browse Available Work</a>
                                    </td>
                                </tr>
                            }
                            @foreach (var complaint in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">#@complaint.ComplaintId</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">@complaint.ProblemType</span>
                                    </td>
                                    <td class="small text-truncate" style="max-width: 280px;" title="@complaint.Address">
                                        <i class="fas fa-map-marker-alt text-danger me-1"></i>@(complaint.Address ?? "Location pinned on map")
                                    </td>
                                    <td>
                                        <span class="badge status-badge @(complaint.Status.ToString().ToLower()) rounded-pill px-3 py-1">
                                            @complaint.Status
                                        </span>
                                    </td>
                                    <td class="small text-muted">@complaint.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                    <td class="pe-4 text-end">
                                        <a href="@Url.Action("Details", new { id = complaint.ComplaintId })" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                            <i class="fas fa-camera me-1"></i> Work & Upload Proofs
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<style>
.technician-dashboard-root {
    font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, sans-serif;
}
.sidebar-link {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    border-radius: 8px;
    color: #64748b;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s;
}
.sidebar-link:hover {
    background-color: #f1f5f9;
    color: #0f172a;
}
.sidebar-link.active {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}
.top-tab-link {
    text-decoration: none;
    color: #64748b;
    font-weight: 500;
    font-size: 0.95rem;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: all 0.2s;
}
.top-tab-link:hover {
    color: #0f172a;
}
.top-tab-link.active {
    color: #2563eb;
    border-bottom-color: #2563eb;
    font-weight: 600;
}
.status-badge.pending { background-color: #dc3545 !important; color: #fff; }
.status-badge.inprogress { background-color: #ffc107 !important; color: #000; }
.status-badge.fixed { background-color: #198754 !important; color: #fff; }
</style>