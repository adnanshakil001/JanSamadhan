@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "City-Wide Citizen Leaderboard - JanSamadhan";
    ViewData["FullWidth"] = true;

    var usersList = Model?.ToList() ?? new List<dynamic>();
    var top3 = usersList.Take(3).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/scoreboard.css" asp-append-version="true" />
}

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- Header Row -->
    <div class="scoreboard-header">
        <div>
            <nav class="scoreboard-subtitle mb-2" aria-label="Breadcrumb">
                <a href="/Complaint" class="text-primary text-decoration-none">Dashboard</a>
                <span class="text-muted mx-1" aria-hidden="true">&sol;</span>
                <span class="text-slate-900 fw-semibold">Leaderboard</span>
            </nav>
            <h1 class="scoreboard-title">City-Wide Citizen Leaderboard</h1>
            <p class="scoreboard-subtitle">Recognizing active community champions contributing to cleaner and safer neighborhoods</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Badge" class="btn btn-outline-primary rounded-pill px-3 fw-medium d-inline-flex align-items-center gap-2">
                <i class="fas fa-medal" aria-hidden="true"></i>
                <span>My Badges &amp; Rewards &rarr;</span>
            </a>
            <a href="/Complaint/Create" class="btn btn-success rounded-pill px-3 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="fas fa-plus" aria-hidden="true"></i>
                <span>Report Issue</span>
            </a>
        </div>
    </div>

    <!-- 1. Top 3 Olympic Podium Visual Component -->
    @if (top3.Any())
    {
        <section class="podium-wrapper" aria-label="Top 3 Citizen Champions">
            <div class="podium-heading">
                <h2 class="podium-heading__title">
                    <i class="fas fa-trophy text-warning" aria-hidden="true"></i>
                    <span>Civic Champions Podium</span>
                </h2>
                <span class="podium-heading__subtitle">Top 3 Community Guardians</span>
            </div>

            <div class="podium-grid">
                <!-- 2nd Place (Silver) -->
                @if (top3.Count > 1)
                {
                    var second = top3[1];
                    string sName = second.Name ?? "Citizen";
                    string sInitial = string.IsNullOrWhiteSpace(sName) ? "C" : sName.Substring(0, 1).ToUpperInvariant();

                    <div class="podium-column podium-column--2">
                        <div class="podium-profile">
                            <div class="podium-avatar-wrap">
                                <div class="podium-avatar" aria-hidden="true">@sInitial</div>
                                <span class="podium-crown" title="2nd Place Silver">
                                    <i class="fas fa-medal"></i>
                                </span>
                            </div>
                            <div class="podium-name" title="@sName">@sName</div>
                            <div class="podium-meta">@(second.BadgeLevel ?? "Silver") Tier</div>
                            <div class="podium-score">
                                <i class="fas fa-star text-secondary" aria-hidden="true"></i>
                                <span>@second.Points.ToString("N0") pts</span>
                            </div>
                        </div>
                        <div class="podium-pedestal">
                            <span class="podium-rank-num">2</span>
                        </div>
                    </div>
                }

                <!-- 1st Place (Gold - Center) -->
                @if (top3.Count > 0)
                {
                    var first = top3[0];
                    string fName = first.Name ?? "Citizen";
                    string fInitial = string.IsNullOrWhiteSpace(fName) ? "C" : fName.Substring(0, 1).ToUpperInvariant();

                    <div class="podium-column podium-column--1">
                        <div class="podium-profile">
                            <div class="podium-avatar-wrap">
                                <div class="podium-avatar" aria-hidden="true">@fInitial</div>
                                <span class="podium-crown" title="1st Place Gold Champion">
                                    <i class="fas fa-crown"></i>
                                </span>
                            </div>
                            <div class="podium-name" title="@fName">@fName</div>
                            <div class="podium-meta">@(first.BadgeLevel ?? "Gold") Tier</div>
                            <div class="podium-score">
                                <i class="fas fa-award text-warning" aria-hidden="true"></i>
                                <span>@first.Points.ToString("N0") pts</span>
                            </div>
                        </div>
                        <div class="podium-pedestal">
                            <span class="podium-rank-num">1</span>
                        </div>
                    </div>
                }

                <!-- 3rd Place (Bronze) -->
                @if (top3.Count > 2)
                {
                    var third = top3[2];
                    string tName = third.Name ?? "Citizen";
                    string tInitial = string.IsNullOrWhiteSpace(tName) ? "C" : tName.Substring(0, 1).ToUpperInvariant();

                    <div class="podium-column podium-column--3">
                        <div class="podium-profile">
                            <div class="podium-avatar-wrap">
                                <div class="podium-avatar" aria-hidden="true">@tInitial</div>
                                <span class="podium-crown" title="3rd Place Bronze">
                                    <i class="fas fa-award"></i>
                                </span>
                            </div>
                            <div class="podium-name" title="@tName">@tName</div>
                            <div class="podium-meta">@(third.BadgeLevel ?? "Bronze") Tier</div>
                            <div class="podium-score">
                                <i class="fas fa-shield-halved text-danger" aria-hidden="true"></i>
                                <span>@third.Points.ToString("N0") pts</span>
                            </div>
                        </div>
                        <div class="podium-pedestal">
                            <span class="podium-rank-num">3</span>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- 2. Community Roster Ranking Table Card -->
    <div class="scoreboard-table-card">
        <div class="scoreboard-table-header">
            <div>
                <h2 class="h6 fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="fas fa-list-ol text-primary" aria-hidden="true"></i>
                    <span>Citizen Honor Roll</span>
                </h2>
                <span class="text-muted small">Rankings based on verified community grievance reporting</span>
            </div>
            <span class="badge bg-light text-muted border text-xs">@usersList.Count active citizens</span>
        </div>

        <div class="table-responsive">
            <table class="scoreboard-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px;" class="ps-4">Rank</th>
                        <th scope="col">Citizen</th>
                        <th scope="col">Badge Milestone</th>
                        <th scope="col" class="text-end pe-4">Civic Points</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!usersList.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fas fa-trophy fa-3x mb-3 text-muted opacity-50" aria-hidden="true"></i>
                                <p class="mb-0 fw-semibold">No civic points recorded yet.</p>
                                <small class="text-muted">Submit an issue report from your neighborhood to earn points!</small>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int currentRank = 1;
                        foreach (var user in usersList)
                        {
                            string uName = user.Name ?? "Citizen";
                            string uInitial = string.IsNullOrWhiteSpace(uName) ? "C" : uName.Substring(0, 1).ToUpperInvariant();
                            string badgeTier = user.BadgeLevel ?? "Bronze";

                            var isTop3 = currentRank <= 3;
                            var rankBadgeClass = currentRank == 1 ? "bg-warning text-dark" : (currentRank == 2 ? "bg-secondary text-white" : (currentRank == 3 ? "bg-dark text-white" : ""));

                            <tr class="@(isTop3 ? "bg-light bg-opacity-50" : "")">
                                <td class="ps-4">
                                    @if (isTop3)
                                    {
                                        <span class="badge @rankBadgeClass rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 30px; height: 30px; font-weight: 700;">
                                            #@currentRank
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="table-rank-badge">#@currentRank</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-user-cell">
                                        <div class="table-user-avatar" aria-hidden="true">@uInitial</div>
                                        <div class="table-user-info">
                                            <div class="table-user-name">@uName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1">
                                        <i class="fas fa-award text-warning me-1" aria-hidden="true"></i>@badgeTier
                                    </span>
                                </td>
                                <td class="text-end pe-4 fw-bold text-primary">
                                    @user.Points.ToString("N0") pts
                                </td>
                            </tr>
                            currentRank++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
