@{
    ViewData["Title"] = "JanSamadhan — Civic issue reporting and resolution";
    ViewData["HideDefaultNav"] = true;
    ViewData["FullWidth"] = true;
    var isAuthenticated = Context.User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = Context.User?.IsInRole("Admin") ?? false;
    var isTechnician = Context.User?.IsInRole("Technician") ?? false;
}

<div class="landing-page" id="top">
    <header class="landing-header">
        <div class="landing-shell landing-header__inner">
            <a class="landing-brand" href="/" aria-label="JanSamadhan home">
                <span class="landing-brand__mark" aria-hidden="true">
                    <i class="fas fa-landmark"></i>
                </span>
                <span class="landing-brand__name">JanSamadhan</span>
            </a>

            <nav class="landing-nav" aria-label="Primary">
                <a href="#stakeholders">Who it’s for</a>
                <a href="#how-it-works">How it works</a>
                <a href="#platform">Platform</a>
            </nav>

            <div class="landing-header__actions">
                @if (isAuthenticated)
                {
                    <a class="landing-button landing-button--primary landing-button--compact"
                       href="@(isAdmin ? "/Admin" : isTechnician ? "/Technician/Dashboard" : "/Complaint")"
                       aria-label="@(isAdmin ? "Open the admin dashboard" : isTechnician ? "Open the technician dashboard" : "Open my complaints")">
                        Dashboard
                    </a>
                    <a class="landing-icon-link" href="/Account/Logout" aria-label="Sign out" title="Sign out">
                        <i class="fas fa-arrow-right-from-bracket" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    <a class="landing-signin" href="/Account/Login">Sign in</a>
                    <a class="landing-button landing-button--primary landing-button--compact" href="/Complaint/Create">
                        <i class="fas fa-plus" aria-hidden="true"></i>
                        Report issue
                    </a>
                }
            </div>
        </div>
    </header>

    <section class="landing-hero" aria-labelledby="landing-hero-title">
        <div class="landing-shell landing-hero__grid">
            <div class="landing-hero__copy">
                <p class="landing-badge">
                    <span class="landing-badge__dot" aria-hidden="true"></span>
                    Civic Redressal Platform
                </p>

                <h1 class="landing-hero__title" id="landing-hero-title">Civic issues, from report to repair.</h1>

                <p class="landing-hero__lede">
                    JanSamadhan connects residents to the departments that fix their streets. Report a problem,
                    follow its progress, and see the proof when the work is done.
                </p>

                <div class="landing-hero__actions">
                    <a class="landing-button landing-button--primary" href="/Complaint/Create">
                        Report a Problem
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    <a class="landing-button landing-button--secondary" href="#platform">Platform Overview</a>
                </div>

                <p class="landing-hero__note">Built for residents, municipal offices, and field crews.</p>
            </div>

            <figure class="landing-map">
                <div class="landing-map__top">
                    <div>
                        <p class="landing-map__title">Ward overview</p>
                        <p class="landing-map__meta">Issues plotted by location</p>
                    </div>
                    <span class="landing-map__tag">Illustrative</span>
                </div>

                <div class="landing-map__canvas" aria-hidden="true">
                    <svg class="landing-map__streets" viewBox="0 0 480 360" preserveAspectRatio="none">
                        <defs>
                            <pattern id="landing-ward-grid" width="32" height="32" patternUnits="userSpaceOnUse">
                                <path d="M32 0H0V32" fill="none" stroke="rgb(148 163 184 / 0.22)" stroke-width="1" />
                            </pattern>
                        </defs>
                        <rect width="480" height="360" fill="url(#landing-ward-grid)" />
                        <path vector-effect="non-scaling-stroke" d="M-20 86 L140 86 L214 152 L500 152" />
                        <path vector-effect="non-scaling-stroke" d="M96 -20 L96 120 L160 196 L160 380" />
                        <path vector-effect="non-scaling-stroke" d="M300 -20 L300 130 L360 200 L360 380" />
                        <path vector-effect="non-scaling-stroke" d="M-20 280 L150 280 L230 330 L500 330" />
                        <path vector-effect="non-scaling-stroke" d="M-20 40 L500 40" />
                        <path class="is-arterial" vector-effect="non-scaling-stroke" d="M-20 230 L120 230 L210 270 L500 270" />
                    </svg>

                    <span class="landing-pin landing-pin--pending landing-pin--one">
                        <span class="landing-pin__dot"></span>
                        <span class="landing-pin__label">Pothole</span>
                    </span>
                    <span class="landing-pin landing-pin--inprogress landing-pin--two">
                        <span class="landing-pin__dot"></span>
                        <span class="landing-pin__label">Streetlight</span>
                    </span>
                    <span class="landing-pin landing-pin--fixed landing-pin--three">
                        <span class="landing-pin__dot"></span>
                        <span class="landing-pin__label">Sanitation</span>
                    </span>
                </div>

                <figcaption class="landing-map__legend">
                    <span class="visually-hidden">Illustrative ward map. </span>
                    <span class="landing-legend__item"><span class="landing-legend__dot landing-legend__dot--pending"></span>Reported</span>
                    <span class="landing-legend__item"><span class="landing-legend__dot landing-legend__dot--inprogress"></span>In progress</span>
                    <span class="landing-legend__item"><span class="landing-legend__dot landing-legend__dot--fixed"></span>Resolved</span>
                </figcaption>
            </figure>
        </div>
    </section>

    <section class="landing-section" id="stakeholders" aria-labelledby="landing-stakeholders-title">
        <div class="landing-shell">
            <div class="landing-section__head">
                <h2 id="landing-stakeholders-title">Built for the people who report, route, and repair.</h2>
                <p>
                    One shared case file keeps residents, municipal offices, and field crews working from the same facts.
                </p>
            </div>

            <div class="landing-stakeholders">
                <a class="stakeholder-card stakeholder-card--lead" href="/Account/Register">
                    <div class="stakeholder-card__head">
                        <span class="landing-icon landing-icon--primary" aria-hidden="true">
                            <i class="fas fa-user"></i>
                        </span>
                        <span class="stakeholder-card__role">For residents</span>
                    </div>
                    <h3>Report what you see. Follow what happens next.</h3>
                    <p class="stakeholder-card__body">
                        A photo, a description, and a location are enough to start a case. Status changes stay visible
                        from the first report to the final record.
                    </p>
                    <ul class="stakeholder-card__list">
                        <li><i class="fas fa-check" aria-hidden="true"></i>Photo and map-based reporting</li>
                        <li><i class="fas fa-check" aria-hidden="true"></i>Status tracking on every report</li>
                        <li><i class="fas fa-check" aria-hidden="true"></i>Completion proof before a case closes</li>
                    </ul>
                    <span class="stakeholder-card__action">
                        Create a citizen account
                        <i class="fas fa-arrow-right stakeholder-card__arrow" aria-hidden="true"></i>
                    </span>
                </a>

                <div class="landing-stakeholders__side">
                    <a class="stakeholder-card" href="/Account/AdminLogin">
                        <div class="stakeholder-card__head">
                            <span class="landing-icon landing-icon--amber" aria-hidden="true">
                                <i class="fas fa-building-columns"></i>
                            </span>
                            <span class="stakeholder-card__role">For municipal offices</span>
                        </div>
                        <h3>See the whole workload, then assign the right crew.</h3>
                        <p class="stakeholder-card__body">
                            Map hotspots, route cases by department, and keep an audit trail on every assignment.
                        </p>
                        <span class="stakeholder-card__action">
                            Staff sign in
                            <i class="fas fa-arrow-right stakeholder-card__arrow" aria-hidden="true"></i>
                        </span>
                    </a>

                    <a class="stakeholder-card" href="/Account/TechnicianLogin">
                        <div class="stakeholder-card__head">
                            <span class="landing-icon landing-icon--green" aria-hidden="true">
                                <i class="fas fa-screwdriver-wrench"></i>
                            </span>
                            <span class="stakeholder-card__role">For field technicians</span>
                        </div>
                        <h3>Get the job, attach the proof, close the loop.</h3>
                        <p class="stakeholder-card__body">
                            Assigned work arrives with the location and the citizen’s report attached.
                        </p>
                        <span class="stakeholder-card__action">
                            Technician sign in
                            <i class="fas fa-arrow-right stakeholder-card__arrow" aria-hidden="true"></i>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="landing-section landing-section--muted" id="how-it-works" aria-labelledby="landing-how-title">
        <div class="landing-shell">
            <div class="landing-section__head">
                <h2 id="landing-how-title">A short path from report to repair.</h2>
                <p>Three stages, no black box. Every hand-off stays visible on the case record.</p>
            </div>

            <ol class="landing-steps">
                <li class="landing-step landing-step--report">
                    <span class="landing-step__marker" aria-hidden="true">1</span>
                    <h3>Report</h3>
                    <p>Add a photo, a short description, and the location of the issue.</p>
                </li>
                <li class="landing-step landing-step--dispatch">
                    <span class="landing-step__marker" aria-hidden="true">2</span>
                    <h3>Dispatch</h3>
                    <p>The case is routed to the department responsible for that category.</p>
                </li>
                <li class="landing-step landing-step--resolve">
                    <span class="landing-step__marker" aria-hidden="true">3</span>
                    <h3>Resolve</h3>
                    <p>The field team attaches proof of work, and the record closes with the outcome.</p>
                </li>
            </ol>
        </div>
    </section>

    <section class="landing-section" id="platform" aria-labelledby="landing-platform-title">
        <div class="landing-shell">
            <div class="landing-section__head">
                <h2 id="landing-platform-title">Every report leaves a record.</h2>
                <p>The details that turn a complaint into accountable work.</p>
            </div>

            <div class="landing-capabilities">
                <article class="capability">
                    <span class="landing-icon landing-icon--primary" aria-hidden="true">
                        <i class="fas fa-map-marked-alt"></i>
                    </span>
                    <h3>Geospatial triage</h3>
                    <p>Every report is pinned. Staff can see clusters, spot repeat problems, and send crews where they are needed most.</p>
                </article>

                <article class="capability">
                    <span class="landing-icon landing-icon--amber" aria-hidden="true">
                        <i class="fas fa-route"></i>
                    </span>
                    <h3>Department routing</h3>
                    <p>Category rules send each issue to the office that owns it, so work starts with the right team.</p>
                </article>

                <article class="capability">
                    <span class="landing-icon landing-icon--green" aria-hidden="true">
                        <i class="fas fa-camera"></i>
                    </span>
                    <h3>Proof of work</h3>
                    <p>Field crews attach a completion photo before a case can be closed, giving residents something concrete to check.</p>
                </article>

                <article class="capability">
                    <span class="landing-icon landing-icon--slate" aria-hidden="true">
                        <i class="fas fa-shield-alt"></i>
                    </span>
                    <h3>Accountable records</h3>
                    <p>Assignments, status changes, and outcomes stay on one case file instead of scattering across inboxes.</p>
                </article>
            </div>

            <div class="landing-record">
                <div class="landing-record__intro">
                    <div class="landing-record__label">
                        <span>Example record</span>
                        <span class="status-pill status-pill--inprogress">In progress</span>
                    </div>
                    <h3>The case file stays open.</h3>
                    <p>Status, assignment, and proof live on one record that everyone involved can read.</p>
                </div>

                <dl class="landing-record__rows">
                    <div class="landing-record__row">
                        <dt>Issue</dt>
                        <dd>Streetlight not working</dd>
                    </div>
                    <div class="landing-record__row">
                        <dt>Location</dt>
                        <dd>Ward 12 · Market Road</dd>
                    </div>
                    <div class="landing-record__row">
                        <dt>Assigned to</dt>
                        <dd>Electrical maintenance</dd>
                    </div>
                    <div class="landing-record__row">
                        <dt>Latest update</dt>
                        <dd>Proof of work attached</dd>
                    </div>
                </dl>
            </div>
        </div>
    </section>

    <section class="landing-cta" aria-labelledby="landing-cta-title">
        <div class="landing-shell landing-cta__inner">
            <div class="landing-cta__copy">
                <h2 id="landing-cta-title">See something broken? Put it on the map.</h2>
                <p>Report it in a few steps. Follow it until the proof is in.</p>
            </div>
            <div class="landing-cta__actions">
                <a class="landing-button landing-button--inverse" href="/Complaint/Create">
                    Report a Problem
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
                <a class="landing-button landing-button--ghost-inverse" href="/Account/Register">Create an account</a>
            </div>
        </div>
    </section>

    <footer class="landing-footer">
        <div class="landing-shell">
            <div class="landing-footer__top">
                <div class="landing-footer__brand">
                    <a class="landing-brand" href="/" aria-label="JanSamadhan home">
                        <span class="landing-brand__mark" aria-hidden="true">
                            <i class="fas fa-landmark"></i>
                        </span>
                        <span class="landing-brand__name">JanSamadhan</span>
                    </a>
                    <p>Civic issue reporting and resolution, built around one shared record.</p>
                </div>

                <nav class="landing-footer__nav" aria-label="Footer">
                    <div class="landing-footer__group">
                        <h2 class="landing-footer__heading">Explore</h2>
                        <a href="#stakeholders">Who it’s for</a>
                        <a href="#how-it-works">How it works</a>
                        <a href="#platform">Platform</a>
                    </div>
                    <div class="landing-footer__group">
                        <h2 class="landing-footer__heading">Access</h2>
                        <a href="/Account/Login">Citizen sign in</a>
                        <a href="/Account/Register">Create an account</a>
                        <a href="/Account/TechnicianLogin">Technician sign in</a>
                        <a href="/Account/AdminLogin">Admin sign in</a>
                    </div>
                </nav>
            </div>

            <div class="landing-footer__bottom">
                <p>&copy; @DateTime.Now.Year JanSamadhan. Civic redressal for everyone.</p>
                <a class="landing-footer__top-link" href="#top">
                    Back to top
                    <i class="fas fa-arrow-up" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </footer>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}
