@{
    ViewData["Title"] = "Nearby Civic Issues — JanSamadhan";
}

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bolder text-dark mb-1">Nearby Civic Anomalies</h1>
        <p class="text-muted small mb-0">Real-time proximity scan of grievances reported within 1km of your location.</p>
    </div>
    <div>
        <a href="/Complaint/Create" class="dashboard-action-btn">
            <i class="fas fa-plus" aria-hidden="true"></i>
            <span>Report Problem Here</span>
        </a>
    </div>
</div>

<!-- 2-Column Map & Stream Layout -->
<div class="nearby-grid">
    <!-- Left: Map Canvas & Category Filter Pills -->
    <div class="nearby-map-card">
        <!-- Interactive Category Filter Bar -->
        <div class="nearby-filter-bar" role="tablist" aria-label="Filter Map by Category">
            <button type="button" class="nearby-filter-pill active" data-category="all" role="tab" aria-selected="true">All Issues</button>
            <button type="button" class="nearby-filter-pill" data-category="Pothole" role="tab" aria-selected="false">Potholes</button>
            <button type="button" class="nearby-filter-pill" data-category="Streetlight" role="tab" aria-selected="false">Streetlights</button>
            <button type="button" class="nearby-filter-pill" data-category="Water Disposal" role="tab" aria-selected="false">Water Leaks</button>
            <button type="button" class="nearby-filter-pill" data-category="Traffic Signal" role="tab" aria-selected="false">Traffic Signals</button>
            <button type="button" class="nearby-filter-pill" data-category="Sewer Lids" role="tab" aria-selected="false">Sewer Lids</button>
        </div>

        <div id="map" class="nearby-map-canvas" role="region" aria-label="Nearby Complaints Map"></div>
    </div>

    <!-- Right: Proximity Stream Feed -->
    <div class="nearby-stream-card">
        <div class="nearby-stream-header">
            <div>
                <h2 class="h6 fw-bold mb-0 text-dark">
                    <i class="fas fa-radar text-primary me-2" aria-hidden="true"></i>Nearby Live Stream
                </h2>
                <small class="text-muted" id="nearbyCountLabel">Scanning area...</small>
            </div>
            <span class="badge bg-light text-muted border small">1km Radius</span>
        </div>

        <div class="nearby-stream-list" id="nearbyList" aria-live="polite">
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                <p class="small mb-0">Detecting nearby issues via GPS...</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/badges-map.css" asp-append-version="true" />
}

@section Scripts {
<script>
    let map;
    let userLocation = null;
    let allComplaints = [];
    let currentCategoryFilter = 'all';
    let mapMarkers = [];

    document.addEventListener('DOMContentLoaded', function () {
        initializeMap();
        getCurrentLocation();
        setupFilterPills();
    });

    function initializeMap() {
        // Default Center: Bhopal
        map = L.map('map', {
            zoomControl: true,
            scrollWheelZoom: true
        }).setView([23.2599, 77.4126], 14);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);
    }

    function getCurrentLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function (position) {
                    userLocation = {
                        lat: position.coords.latitude,
                        lng: position.coords.longitude
                    };

                    map.setView([userLocation.lat, userLocation.lng], 15);

                    // User Location Marker
                    const userIcon = L.divIcon({
                        className: 'user-radar-marker',
                        html: `<div style="background-color: #2563eb; width: 20px; height: 20px; border-radius: 50%; border: 3px solid #ffffff; box-shadow: 0 0 12px rgba(37,99,235,0.8);"></div>`,
                        iconSize: [20, 20],
                        iconAnchor: [10, 10]
                    });

                    L.marker([userLocation.lat, userLocation.lng], { icon: userIcon })
                        .addTo(map)
                        .bindPopup('<b>Your Current Location</b>')
                        .openPopup();

                    // Proximity radius ring
                    L.circle([userLocation.lat, userLocation.lng], {
                        radius: 1000,
                        color: '#2563eb',
                        fillColor: '#3b82f6',
                        fillOpacity: 0.08,
                        weight: 1.5,
                        dashArray: '4, 4'
                    }).addTo(map);

                    fetchNearbyComplaints();
                },
                function () {
                    fetchNearbyComplaints();
                },
                { enableHighAccuracy: true, timeout: 8000 }
            );
        } else {
            fetchNearbyComplaints();
        }
    }

    function fetchNearbyComplaints() {
        const queryLat = userLocation ? userLocation.lat : 23.2599;
        const queryLng = userLocation ? userLocation.lng : 77.4126;

        $.get('/Map/Nearby', {
            lat: queryLat,
            lng: queryLng,
            radiusMeters: 1000
        }).done(function (complaints) {
            allComplaints = complaints || [];
            applyFilters();
        }).fail(function () {
            $('#nearbyList').html('<p class="text-muted small text-center py-4">No nearby issues found within this radius.</p>');
            $('#nearbyCountLabel').textContent = '0 issues detected';
        });
    }

    function setupFilterPills() {
        const pills = document.querySelectorAll('.nearby-filter-pill');
        pills.forEach(pill => {
            pill.addEventListener('click', function () {
                pills.forEach(p => {
                    p.classList.remove('active');
                    p.setAttribute('aria-selected', 'false');
                });
                this.classList.add('active');
                this.setAttribute('aria-selected', 'true');
                currentCategoryFilter = this.getAttribute('data-category');
                applyFilters();
            });
        });
    }

    function applyFilters() {
        const filtered = allComplaints.filter(c => {
            if (currentCategoryFilter === 'all') return true;
            const type = c.ProblemType || c.problemType || '';
            return type.toLowerCase().includes(currentCategoryFilter.toLowerCase());
        });

        renderNearbyList(filtered);
        renderMapMarkers(filtered);
    }

    function renderNearbyList(complaints) {
        const list = $('#nearbyList');
        const countLabel = document.getElementById('nearbyCountLabel');

        if (countLabel) {
            countLabel.textContent = `${complaints.length} issue${complaints.length !== 1 ? 's' : ''} in area`;
        }

        if (complaints.length === 0) {
            list.html(`
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-circle-check fa-2x text-success mb-2" aria-hidden="true"></i>
                    <p class="small mb-0">No active complaints found in this category.</p>
                </div>
            `);
            return;
        }

        let html = '';
        complaints.forEach(c => {
            const type = c.ProblemType || c.problemType || 'Civic Issue';
            const status = c.Status || c.status || 'Pending';
            const address = c.Address || c.address || 'Nearby Location';
            const id = c.ComplaintId || c.complaintId || c.id;
            const distance = Math.round(c.Distance || c.distance || 0);

            const statusClass = status === 'Fixed' ? 'status-pill--fixed' : 
                               (status === 'InProgress' ? 'status-pill--inprogress' : 'status-pill--pending');

            html += `
                <a href="/Complaint/Details/${id}" class="nearby-item-card">
                    <div class="nearby-item-card__head">
                        <span class="status-pill ${statusClass}">${status}</span>
                        <span class="nearby-distance-chip">${distance > 0 ? distance + 'm away' : 'Near you'}</span>
                    </div>
                    <strong class="text-dark d-block mb-1">${escapeHtml(type)}</strong>
                    <div class="text-muted small text-truncate">
                        <i class="fas fa-map-pin text-primary me-1" aria-hidden="true"></i>${escapeHtml(address)}
                    </div>
                </a>
            `;
        });

        list.html(html);
    }

    function renderMapMarkers(complaints) {
        // Clear previous markers
        mapMarkers.forEach(m => map.removeLayer(m));
        mapMarkers = [];

        complaints.forEach(c => {
            const lat = c.Latitude || c.latitude;
            const lng = c.Longitude || c.longitude;
            const type = c.ProblemType || c.problemType || 'Civic Issue';
            const status = c.Status || c.status || 'Pending';
            const id = c.ComplaintId || c.complaintId || c.id;
            const address = c.Address || c.address || '';

            if (lat && lng) {
                const color = status === 'Fixed' ? '#10b981' : (status === 'InProgress' ? '#f59e0b' : '#ef4444');
                const markerIcon = L.divIcon({
                    className: 'nearby-map-marker',
                    html: `<div style="background-color: ${color}; width: 18px; height: 18px; border-radius: 50%; border: 2.5px solid #ffffff; box-shadow: 0 3px 6px rgba(0,0,0,0.25);"></div>`,
                    iconSize: [18, 18],
                    iconAnchor: [9, 9]
                });

                const marker = L.marker([lat, lng], { icon: markerIcon });
                marker.bindPopup(`
                    <div style="font-family: var(--font-sans); padding: 4px;">
                        <strong style="color: #0f172a; font-size: 0.9rem; display: block; margin-bottom: 4px;">${escapeHtml(type)}</strong>
                        <p style="font-size: 0.75rem; color: #64748b; margin-bottom: 8px;">${escapeHtml(address)}</p>
                        <a href="/Complaint/Details/${id}" style="display: inline-block; padding: 4px 12px; background: #2563eb; color: #ffffff; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-decoration: none;">
                            View Details & Proofs
                        </a>
                    </div>
                `);
                marker.addTo(map);
                mapMarkers.push(marker);
            }
        });
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text || '';
        return div.innerHTML;
    }
</script>
}
