@inject JanSamadhan.Data.ApplicationDbContext DbContext
@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = "Geospatial Command Center - JanSamadhan";
    ViewData["FullWidth"] = true;

    var activeDepartments = await DbContext.Departments.Where(d => d.IsActive).OrderBy(d => d.Name).ToListAsync();
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
    <link rel="stylesheet" href="~/css/admin-gis-map.css" asp-append-version="true" />
}

<div class="gis-map-viewport" id="gisViewport">
    <!-- 1. Fullscreen Map Canvas -->
    <div id="map" role="region" aria-label="Geospatial City Map"></div>

    <!-- 2. Floating Frosted-Glass GIS Controls Panel (Top-Left) -->
    <aside class="gis-floating-panel" id="gisControlPanel" aria-label="GIS Map Filter Controls">
        <div class="gis-panel-header">
            <h1 class="gis-panel-title">
                <i class="fas fa-satellite-dish text-primary" aria-hidden="true"></i>
                <span>GIS Command Center</span>
            </h1>
            <div class="d-flex align-items-center gap-1">
                <span class="badge bg-primary rounded-pill text-xs px-2" id="incidentCounterBadge">0 Incidents</span>
                <button type="button" class="gis-toggle-btn" id="togglePanelBtn" aria-label="Toggle Controls Panel" title="Collapse / Expand Panel">
                    <i class="fas fa-chevron-up" id="togglePanelIcon" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div class="gis-panel-body">
            <!-- Status Filter Segmented Pills -->
            <div class="mb-3">
                <span class="gis-label">Incident Status Filter</span>
                <div class="gis-status-pills" role="radiogroup" aria-label="Status Filters">
                    <button type="button" class="gis-filter-pill is-active" data-status="" aria-pressed="true">
                        <span>All</span>
                    </button>
                    <button type="button" class="gis-filter-pill gis-filter-pill--pending" data-status="Pending" aria-pressed="false">
                        <i class="fas fa-clock" aria-hidden="true"></i>
                        <span>Pending</span>
                    </button>
                    <button type="button" class="gis-filter-pill gis-filter-pill--inprogress" data-status="InProgress" aria-pressed="false">
                        <i class="fas fa-wrench" aria-hidden="true"></i>
                        <span>In Progress</span>
                    </button>
                    <button type="button" class="gis-filter-pill gis-filter-pill--fixed" data-status="Fixed" aria-pressed="false">
                        <i class="fas fa-circle-check" aria-hidden="true"></i>
                        <span>Resolved</span>
                    </button>
                </div>
            </div>

            <!-- Municipal Department Select -->
            <div class="mb-3">
                <label class="gis-label mb-1" for="gisDepartmentFilter">Department Jurisdiction</label>
                <select id="gisDepartmentFilter" class="form-select form-select-sm rounded-3">
                    <option value="">All Civic Departments</option>
                    @foreach (var dept in activeDepartments)
                    {
                        <option value="@dept.DepartmentId">@dept.Name</option>
                    }
                </select>
            </div>

            <!-- Date Range Filter -->
            <div class="mb-3">
                <span class="gis-label">Incident Window</span>
                <div class="row g-2">
                    <div class="col-6">
                        <input type="date" id="gisFromDate" class="form-control form-control-sm rounded-3" aria-label="From Date" title="From Date" />
                    </div>
                    <div class="col-6">
                        <input type="date" id="gisToDate" class="form-control form-control-sm rounded-3" aria-label="To Date" title="To Date" />
                    </div>
                </div>
            </div>

            <!-- Map Layer Toggles -->
            <div class="gis-layer-box">
                <span class="gis-label mb-1">Visualization Layers</span>
                <label class="gis-checkbox-row">
                    <input type="checkbox" id="layerMarkers" checked />
                    <span>Discrete Point Markers</span>
                </label>
                <label class="gis-checkbox-row">
                    <input type="checkbox" id="layerClusters" checked />
                    <span>Dynamic Density Clusters</span>
                </label>
                <label class="gis-checkbox-row">
                    <input type="checkbox" id="layerHeatmap" />
                    <span>Spatial Heatmap Overlay</span>
                </label>
            </div>

            <!-- Reset Map Action -->
            <div class="mt-3 d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill w-100 fw-semibold" id="btnFitBounds">
                    <i class="fas fa-compress me-1" aria-hidden="true"></i> Fit All Points
                </button>
                <button type="button" class="btn btn-light btn-sm rounded-pill px-3" id="btnResetFilters" title="Reset all filters">
                    Reset
                </button>
            </div>
        </div>
    </aside>

    <!-- 3. Slide-In Off-Canvas Incident Inspection Drawer (Right) -->
    <aside class="gis-offcanvas-drawer" id="gisIncidentDrawer" aria-label="Incident Inspection Dossier">
        <div class="gis-drawer-header">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-dark border fw-bold text-xs" id="drawerCategory">Pothole</span>
                <span class="badge rounded-pill text-xs" id="drawerStatusBadge">Pending</span>
            </div>
            <button type="button" class="gis-drawer-close-btn" id="drawerCloseBtn" aria-label="Close dossier">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </div>

        <div class="gis-drawer-body">
            <!-- Incident Title & ID -->
            <div>
                <h2 class="h5 fw-bold text-dark mb-1" id="drawerTitle">Complaint #102</h2>
                <span class="text-muted small" id="drawerTimestamp">Reported 2 hours ago</span>
            </div>

            <!-- Photo Thumbnail if present -->
            <div id="drawerPhotoWrapper" style="display: none;">
                <img src="" id="drawerPhoto" class="gis-drawer-photo" alt="Incident Photo Evidence" />
            </div>

            <!-- Incident Metadata Details -->
            <div class="bg-slate-50 border rounded-3 p-3">
                <div class="mb-2">
                    <span class="gis-label mb-1">Citizen Reporter</span>
                    <p class="mb-0 fw-semibold text-dark small" id="drawerCitizen">Ramesh Kumar</p>
                </div>
                <div class="mb-2">
                    <span class="gis-label mb-1">Geographic Coordinates</span>
                    <p class="mb-0 font-monospace text-muted small" id="drawerCoords">23.25990, 77.41260</p>
                </div>
                <div>
                    <span class="gis-label mb-1">Incident Location</span>
                    <p class="mb-0 text-dark small" id="drawerAddress">Near Model Town Square</p>
                </div>
            </div>
        </div>

        <div class="gis-drawer-footer d-flex gap-2">
            <a href="#" id="drawerDetailsLink" class="btn btn-primary w-100 rounded-pill fw-semibold shadow-sm">
                Open Full Dossier &rarr;
            </a>
            <button type="button" id="drawerFocusBtn" class="btn btn-outline-secondary rounded-pill px-3" title="Focus map on this coordinate">
                <i class="fas fa-crosshairs" aria-hidden="true"></i>
            </button>
        </div>
    </aside>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
    <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let map = null;
            let markersLayer = null;
            let clustersLayer = null;
            let heatmapLayer = null;
            let allFeatures = [];
            let activeSelectedFeature = null;

            // 1. Initialize Leaflet Map with smooth performance options
            function initMap() {
                map = L.map('map', {
                    zoomControl: false, // Move zoom control to bottom right
                    updateWhenIdle: true,
                    keepBuffer: 4,
                    preferCanvas: true
                }).setView([23.2599, 77.4126], 12); // Default to Bhopal coords

                // Reposition zoom controls away from floating panel
                L.control.zoom({ position: 'bottomright' }).addTo(map);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                }).addTo(map);

                markersLayer = L.layerGroup();
                clustersLayer = L.markerClusterGroup({
                    chunkedLoading: true,
                    maxClusterRadius: 45,
                    spiderfyOnMaxZoom: true,
                    showCoverageOnHover: false,
                    zoomToBoundsOnClick: true
                });

                // Prevent layout glitching on initial render
                requestAnimationFrame(function () {
                    map.invalidateSize();
                });

                loadMapIncidents();
            }

            // 2. Load Incidents from /Map/MapData
            function loadMapIncidents() {
                const activeStatus = $('.gis-filter-pill.is-active').data('status') || '';
                const deptId = $('#gisDepartmentFilter').val() || '';
                const fromDate = $('#gisFromDate').val() || '';
                const toDate = $('#gisToDate').val() || '';

                const params = new URLSearchParams();
                if (activeStatus) params.append('status', activeStatus);
                if (deptId) params.append('departmentId', deptId);
                if (fromDate) params.append('from', fromDate);
                if (toDate) params.append('to', toDate);

                $.get(`/Map/MapData?${params.toString()}`)
                    .done(function (data) {
                        if (data && data.features) {
                            allFeatures = data.features;
                            renderIncidentMarkers(data.features);
                        }
                    })
                    .fail(function () {
                        console.error('Failed to load geospatial incident data.');
                    });
            }

            // 3. Render Custom Markers and Cluster Groups
            function renderIncidentMarkers(features) {
                markersLayer.clearLayers();
                clustersLayer.clearLayers();
                if (heatmapLayer && map.hasLayer(heatmapLayer)) {
                    map.removeLayer(heatmapLayer);
                }

                $('#incidentCounterBadge').text(`${features.length} Incidents`);

                const bounds = [];
                const heatmapCoords = [];

                features.forEach(function (feat) {
                    const coords = feat.geometry.coordinates; // [lng, lat]
                    const props = feat.properties;
                    const lat = coords[1];
                    const lng = coords[0];

                    if (isNaN(lat) || isNaN(lng)) return;

                    bounds.push([lat, lng]);
                    heatmapCoords.push([lat, lng, 0.8]);

                    const statusClass = props.status === 'Fixed'
                        ? 'gis-marker-pin--fixed'
                        : (props.status === 'InProgress' ? 'gis-marker-pin--inprogress' : 'gis-marker-pin--pending');

                    const iconSymbol = props.status === 'Fixed' ? 'fa-check' : (props.status === 'InProgress' ? 'fa-wrench' : 'fa-exclamation');

                    const customIcon = L.divIcon({
                        className: 'custom-pin-container',
                        html: `
                            <div class="gis-marker-pin ${statusClass}" aria-label="${props.type || 'Incident'}">
                                <i class="fas ${iconSymbol}"></i>
                            </div>
                        `,
                        iconSize: [24, 24],
                        iconAnchor: [12, 12]
                    });

                    const marker = L.marker([lat, lng], { icon: customIcon });

                    // Tooltip for instant hover preview
                    marker.bindTooltip(`
                        <strong>${props.type || 'Grievance'}</strong> · <span style="text-transform: capitalize;">${props.status}</span>
                        <div style="font-size: 11px; opacity: 0.8;">Reported by ${props.userName || 'Citizen'}</div>
                    `, {
                        className: 'gis-custom-tooltip',
                        direction: 'top',
                        offset: [0, -12]
                    });

                    // Click event slides in the off-canvas inspector drawer
                    marker.on('click', function () {
                        openIncidentDrawer(feat, [lat, lng]);
                    });

                    markersLayer.addLayer(marker);
                    clustersLayer.addLayer(marker);
                });

                // Apply Layer Visibility
                if ($('#layerMarkers').is(':checked') && !$('#layerClusters').is(':checked')) {
                    markersLayer.addTo(map);
                }
                if ($('#layerClusters').is(':checked')) {
                    clustersLayer.addTo(map);
                }
                if ($('#layerHeatmap').is(':checked') && heatmapCoords.length > 0) {
                    renderHeatmap(heatmapCoords);
                }

                if (bounds.length > 0) {
                    map.fitBounds(bounds, { padding: [60, 60], maxZoom: 15 });
                }
            }

            // 4. Render Spatial Heatmap
            function renderHeatmap(points) {
                if (heatmapLayer && map.hasLayer(heatmapLayer)) {
                    map.removeLayer(heatmapLayer);
                }
                heatmapLayer = L.heatLayer(points, {
                    radius: 28,
                    blur: 16,
                    maxZoom: 16
                });
                heatmapLayer.addTo(map);
            }

            // 5. Slide-In Off-Canvas Inspection Drawer
            function openIncidentDrawer(feat, latlng) {
                activeSelectedFeature = { feat: feat, latlng: latlng };
                const props = feat.properties;
                const drawer = document.getElementById('gisIncidentDrawer');

                $('#drawerCategory').text(props.type || 'Civic Grievance');
                $('#drawerTitle').text(`Complaint #${props.id}`);
                $('#drawerTimestamp').text(`Logged: ${props.createdAt ? new Date(props.createdAt).toLocaleString() : 'Recent'}`);
                $('#drawerCitizen').text(props.userName || 'Anonymous Citizen');
                $('#drawerCoords').text(`${latlng[0].toFixed(5)}, ${latlng[1].toFixed(5)}`);
                $('#drawerAddress').text(props.address || 'Address registered on coordinate map');

                // Status Badge Color
                const badge = $('#drawerStatusBadge');
                badge.removeClass('bg-danger bg-warning bg-success text-dark text-white');
                if (props.status === 'Fixed') {
                    badge.addClass('bg-success text-white').text('Resolved');
                } else if (props.status === 'InProgress') {
                    badge.addClass('bg-warning text-dark').text('In Progress');
                } else {
                    badge.addClass('bg-danger text-white').text('Pending Triage');
                }

                // Photo Evidence
                if (props.photoUrl) {
                    $('#drawerPhoto').attr('src', props.photoUrl);
                    $('#drawerPhotoWrapper').show();
                } else {
                    $('#drawerPhotoWrapper').hide();
                }

                // Dossier Link
                $('#drawerDetailsLink').attr('href', `/Admin/Details/${props.id}`);

                // Slide in drawer using hardware-accelerated transform
                drawer.classList.add('is-active');

                // Smooth pan to point
                map.panTo(latlng, { animate: true, duration: 0.35 });
            }

            function closeIncidentDrawer() {
                const drawer = document.getElementById('gisIncidentDrawer');
                drawer.classList.remove('is-active');
                activeSelectedFeature = null;
            }

            // 6. UI Interactions & Event Wireup
            $('#drawerCloseBtn').on('click', closeIncidentDrawer);

            $('#drawerFocusBtn').on('click', function () {
                if (activeSelectedFeature) {
                    map.setView(activeSelectedFeature.latlng, 17, { animate: true });
                }
            });

            // Toggle Floating Panel Collapse
            $('#togglePanelBtn').on('click', function () {
                const panel = $('#gisControlPanel');
                const icon = $('#togglePanelIcon');
                panel.toggleClass('is-collapsed');
                if (panel.hasClass('is-collapsed')) {
                    icon.removeClass('fa-chevron-up').addClass('fa-chevron-down');
                } else {
                    icon.removeClass('fa-chevron-down').addClass('fa-chevron-up');
                }
            });

            // Status Filter Pills
            $('.gis-filter-pill').on('click', function () {
                $('.gis-filter-pill').removeClass('is-active').attr('aria-pressed', 'false');
                $(this).addClass('is-active').attr('aria-pressed', 'true');
                loadMapIncidents();
            });

            // Department & Date Filters
            $('#gisDepartmentFilter, #gisFromDate, #gisToDate').on('change', function () {
                loadMapIncidents();
            });

            // Layer Checkboxes
            $('#layerMarkers').on('change', function () {
                if ($(this).is(':checked')) {
                    markersLayer.addTo(map);
                } else {
                    map.removeLayer(markersLayer);
                }
            });

            $('#layerClusters').on('change', function () {
                if ($(this).is(':checked')) {
                    clustersLayer.addTo(map);
                } else {
                    map.removeLayer(clustersLayer);
                }
            });

            $('#layerHeatmap').on('change', function () {
                if ($(this).is(':checked')) {
                    const points = allFeatures.map(f => [f.geometry.coordinates[1], f.geometry.coordinates[0], 0.8]);
                    renderHeatmap(points);
                } else {
                    if (heatmapLayer && map.hasLayer(heatmapLayer)) {
                        map.removeLayer(heatmapLayer);
                    }
                }
            });

            // Fit All Points
            $('#btnFitBounds').on('click', function () {
                if (allFeatures.length > 0) {
                    const bounds = allFeatures.map(f => [f.geometry.coordinates[1], f.geometry.coordinates[0]]);
                    map.fitBounds(bounds, { padding: [60, 60] });
                }
            });

            // Reset Filters
            $('#btnResetFilters').on('click', function () {
                $('.gis-filter-pill').removeClass('is-active').attr('aria-pressed', 'false');
                $('.gis-filter-pill[data-status=""]').addClass('is-active').attr('aria-pressed', 'true');
                $('#gisDepartmentFilter').val('');
                $('#gisFromDate').val('');
                $('#gisToDate').val('');
                $('#layerMarkers').prop('checked', true);
                $('#layerClusters').prop('checked', true);
                $('#layerHeatmap').prop('checked', false);
                loadMapIncidents();
            });

            // Initialize
            initMap();
        });
    </script>
}
